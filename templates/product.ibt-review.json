    "faqs": {
      "type": "ibt-faqs",
      "blocks": {
        "faq_1": {
          "type": "faq",
          "settings": {
            "question": "Where does this product ship from, and how fast is delivery?",
            "answer": "<p>Orders are fulfilled by Amazon, so delivery speed depends on your Prime status and location. Most listings ship within one to two business days.</p>"
          }
        },
        "faq_2": {
          "type": "faq",
          "settings": {
            "question": "Can I return it if it isn't right for me?",
            "answer": "<p>Yes. Returns are handled under Amazon's standard returns policy, which is normally 30 days from delivery. Check the listing for any category-specific exceptions.</p>"
          }
        },
        "faq_3": {
          "type": "faq",
          "settings": {
            "question": "Is the price on this page current?",
            "answer": "<p>Amazon pricing changes frequently. We review prices regularly, but the figure on the Amazon listing is always the one that applies at checkout.</p>"
          }
        },
        "faq_4": {
          "type": "faq",
          "settings": {
            "question": "How do you test and score the products you review?",
            "answer": "<p>Our reviewers assess each product against the criteria that matter for its category, combine that with verified buyer feedback at scale, and publish a single score out of five.</p>"
          }
        },
        "faq_5": {
          "type": "faq",
          "settings": {
            "question": "Do you earn money if I buy through your link?",
            "answer": "<p>Yes. We earn a commission on qualifying purchases, at no extra cost to you. It never affects our scores or which products we recommend.</p>"
          }
        }
      },
