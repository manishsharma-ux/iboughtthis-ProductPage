{%- comment -%}
  Renders one buyer review card for the IBT product template.
  Accepts: ibt_name, ibt_rating, ibt_title, ibt_quote, ibt_date,
           ibt_verified (bool), ibt_avatar (image or blank),
           ibt_verified_label, ibt_attrs
{%- endcomment -%}
{%- liquid
  assign stars = ibt_rating | plus: 0
  if stars <= 0
    assign stars = 5
  endif
  if stars > 5
    assign stars = 5
  endif
  assign stars_pct = stars | times: 20
  assign initial = ibt_name | strip | slice: 0, 1
-%}
<article class="ibt-rc" {{ ibt_attrs }}>
  <div class="ibt-rc__top">
    {%- if ibt_avatar != blank -%}
      <img
        class="ibt-rc__avatar"
        src="{{ ibt_avatar | image_url: width: 80, height: 80, crop: 'center' }}"
        alt="{{ ibt_name | escape }}"
        width="40"
        height="40"
        loading="lazy"
      >
    {%- else -%}
      <span class="ibt-rc__avatar" aria-hidden="true">{{ initial | default: '?' }}</span>
    {%- endif -%}
    <div class="ibt-rc__who">
      <p class="ibt-rc__name">
        {{ ibt_name | default: 'Verified buyer' }}
        {%- if ibt_verified -%}
          <span class="ibt-rc__verified">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
              <path d="M20 6L9 17l-5-5"/>
            </svg>
            {{ ibt_verified_label | default: 'Verified purchase' }}
          </span>
        {%- endif -%}
      </p>
      {%- if ibt_date != blank -%}
        <p class="ibt-rc__date">{{ ibt_date }}</p>
      {%- endif -%}
    </div>
  </div>

  <div class="ibt-rc__stars">
    <span class="ibt-stars" role="img" aria-label="Rated {{ stars }} out of 5">
      <span class="ibt-stars__bg">&#9733;&#9733;&#9733;&#9733;&#9733;</span>
      <span class="ibt-stars__fill" style="width:{{ stars_pct }}%">&#9733;&#9733;&#9733;&#9733;&#9733;</span>
    </span>
  </div>

  {%- if ibt_title != blank -%}
    <p class="ibt-rc__title">{{ ibt_title }}</p>
  {%- endif -%}

  <div class="ibt-rc__quote rte">{{ ibt_quote }}</div>
</article>
