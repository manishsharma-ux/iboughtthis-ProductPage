{%- comment -%} image {%- endcomment -%}
{%- capture image_product -%}
  {%- assign image = product.selected_or_first_available_variant.featured_image | default: product.featured_image -%}
  <a class="product-card__image js image-content__image-wrapper {{ settings.size_image_grid }}" href="{{ product.url | within: collection }}" style="max-width: 680px;padding-top:{{ 1 | divided_by: image.aspect_ratio | times: 100 }}%;" data-image-id="{{ image.id }}">
    {%- assign img_url = image | image_url: width: 1 | replace: 'width=1', 'width={width}' -%}
    <img class="lazyload scale-in first-image"
          data-src="{{ img_url }}"
          src="{{ image | image_url: width: 1, height: 1 }}"
          data-sizes="auto"
          data-widths="[180, 360, 540, 720]"
          alt="{{ image.alt | escape }}"
          loading="lazy"
          width="{{ image.width }}"
          height="{{ image.height }}">
        {% render 'second-image' , product: product %}
  </a>
{%- endcapture -%}

{%- comment -%} vendor {%- endcomment -%}
{% capture vendor %}
 {%- if settings.enable_type and product.vendor != blank -%}
      <a class="mb-1 product-card__type d-inline-block" href="/collections/vendors?filter.p.vendor={{ product.vendor }}&q={{ product.vendor }}">{{ product.vendor }}</a>
      {%- endif -%}
{% endcapture %}

{%- comment -%} price {%- endcomment -%}
{% capture price %}
  <div class="product-card__price {% if product.compare_at_price > product.price %} product-card__pricesale {% endif %}">
  {%- if product.compare_at_price > product.price -%}
  {%- if product.price_varies -%}
  {%- assign sale_price = product.price | money -%}
  {{ 'products.product.on_sale_from_html' | t: price: sale_price }}
  {%- else -%}
  <span class="visually-hidden">{{ 'products.product.regular_price' | t }}</span>
  {{ product.price | money }}
  <s class="product-card__regular-price">{{ product.compare_at_price | money }}</s>
  <span class="visually-hidden">{{ 'products.product.sale_price' | t }}</span>
 
  {%- endif -%}
  {%- else -%}
  {%- if product.price_varies -%}
  {%- assign price = product.price | money -%}
  {{ 'products.product.from_text_html' | t: price: price }}
  {%- else -%}
  <span class="visually-hidden">{{ 'products.product.regular_price' | t }}</span>
  {{ product.price | money }}
  {%- endif -%}
  {%- endif -%}
  </div>
{% endcapture %}

{% capture review %}
  {%- if settings.enable_review -%}
  <span class="shopify-product-reviews-badge" data-id="{{ product.id }}"></span>
  {%- endif -%}
{% endcapture %}

{%- comment -%} short description / depiction {%- endcomment -%}
{% capture product_short_desc %}
  {%- if product.metafields.info.shortdesc != blank -%}
    <p class="product-card__desc">
      {{ product.metafields.info.shortdesc | strip_html | truncatewords: 10 }}
    </p>
  {%- else -%}
    <p class="product-card__desc">
      {{ product.description | strip_html | truncatewords: 9 }}
    </p>
  {%- endif -%}
{% endcapture %}

{%- comment -%} review + price in single row {%- endcomment -%}
{% capture review_price %}
  <div class="product-card__meta-row d-flex justify-content-between align-items-center">
    <div class="product-card__reviews d-flex align-items-center">
      {{ review }}

      {% if product.metafields.custom.rating.value != blank %}
        {% assign rating = product.metafields.custom.rating.value | plus: 0 %}
        {% assign rating_percentage = rating | times: 20 %}
     <span class="product-card__rating-number">
          {{ rating }}
        </span>
        <div class="star-rating" aria-label="Rated {{ rating }} out of 5">
          <div class="star-rating__base">
            {% for i in (1..5) %}
              <span>★</span>
            {% endfor %}
          </div>
          <div class="star-rating__fill" style="width: {{ rating_percentage }}%;">
            {% for i in (1..5) %}
              <span>★</span>
            {% endfor %}
          </div>
        </div>

   
      {% endif %}
    </div>
    {{ price }}
  </div>
{% endcapture %}

{%- liquid
  assign item = settings.productgrid
  if enable_edit_item
    assign item = select_item
