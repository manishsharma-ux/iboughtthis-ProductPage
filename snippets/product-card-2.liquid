              data-handle="{{ product.handle }}"
              data-pavailable="{% if product.available %}true{% else %}false{% endif %}"
            >
              {%- render 'icon-view' -%}
              <span>{{ 'products.product.quickview_text' | t }}</span>
              {%- if product.metafields.info.shortdesc != blank -%}
