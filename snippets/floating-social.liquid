<div class="launcher">

  <div class="all-social">

    {% if settings.social_facebook_link != blank %}
    <div class="social">
      <a href="{{ settings.social_facebook_link }}" target="_blank" rel="noopener">
        <i class="icon-facebook"></i>
      </a>
    </div>
    {% endif %}

    {% if settings.social_twitter_link != blank %}
    <div class="social">
      <a href="{{ settings.social_twitter_link }}" target="_blank" rel="noopener">
        <i class="icon-twitter"></i>
      </a>
    </div>
    {% endif %}

    {% if settings.social_pinterest_link != blank %}
    <div class="social">
      <a href="{{ settings.social_pinterest_link }}" target="_blank" rel="noopener">
        <i class="icon-pinterest"></i>
      </a>
    </div>
    {% endif %}

    {% if settings.social_instagram_link != blank %}
    <div class="social">
      <a href="{{ settings.social_instagram_link }}" target="_blank" rel="noopener">
        <i class="icon-instagram"></i>
      </a>
    </div>
    {% endif %}

    {% if settings.social_youtube_link != blank %}
    <div class="social">
      <a href="{{ settings.social_youtube_link }}" target="_blank" rel="noopener">
        <i class="icon-youtube"></i>
      </a>
    </div>
    {% endif %}

    {% if settings.social_tiktok_link != blank %}
    <div class="social">
      <a href="{{ settings.social_tiktok_link }}" target="_blank" rel="noopener">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 2859 3333">
          <path d="M2081 0c55 473 319 755 778 785v532c-266 26-499-61-770-225v995c0 1264-1378 1659-1932 753-356-583-138-1606 1004-1647v561c-87 14-180 36-265 65-254 86-398 247-358 531 77 544 1075 705 992-358V1h551z"/>
        </svg>
      </a>
    </div>
    {% endif %}

  </div>

  <div class="main-icon">
    +
  </div>

</div>

<style>
.launcher { position: fixed; right: 25px; bottom: 75px; width: 60px; z-index: 9999; } .main-icon { width: 60px; height: 60px; border-radius: 50%; background: #fff; display: flex; justify-content: center; align-items: center; cursor: pointer; font-size: 28px; box-shadow: 0 6px 16px rgba(0,0,0,.2); } .all-social { position: absolute; bottom: 75px; left: 50%; transform: translateX(-50%) translateY(10px); display: flex; flex-direction: column; gap: 10px; opacity: 0; visibility: hidden; transition: .3s ease; } /* Show on hover */ .launcher:hover .all-social, .launcher:focus-within .all-social { opacity: 1; visibility: visible; transform: translateX(-50%) translateY(0); } .social { width: 48px; height: 48px; border-radius: 50%; background: #fff; box-shadow: 0 4px 12px rgba(0,0,0,.15); transition: .25s; } .social:hover { transform: scale(1.1); } .social a{ width:100%; height:100%; display:flex; justify-content:center; align-items:center; text-decoration:none; } .social i, .social svg{  fill:#000; color:#000; } .icon__fallback-text{ display:none; }
</style>