{% comment %}
  Renders an article (blog post) card. Used for search results and blog listings.

  Accepts:
  - article:      {Object}  Article / blog post object. Required.
  - show_date:    {Boolean} Show the published date.   Default: true
  - show_author:  {Boolean} Show the author name.      Default: false

  Usage:
  {%- render 'article-card', article: item, show_date: section.settings.article_show_date, show_author: section.settings.article_show_author -%}
{% endcomment %}

{%- liquid
  assign show_date = show_date | default: true, allow_false: true
  assign show_author = show_author | default: false, allow_false: true
  assign article_alt = article.image.alt | default: article.title | escape
-%}

<article class="article-card">
  <a href="{{ article.url }}" class="article-card__media-link" aria-label="{{ article.title | escape }}" tabindex="-1">
    <div class="article-card__media">
      {%- if article.image -%}
        {{
          article.image
          | image_url: width: 600
          | image_tag:
            loading: 'lazy',
            widths: '200, 300, 400, 600, 800',
            sizes: '(min-width: 990px) 25vw, (min-width: 750px) 33vw, 50vw',
            alt: article_alt,
            class: 'article-card__image'
        }}
      {%- else -%}
        {{ 'image' | placeholder_svg_tag: 'placeholder-svg article-card__image' }}
      {%- endif -%}
    </div>
  </a>

  <div class="article-card__info">
    {%- if show_date or show_author -%}
      <p class="article-card__meta">
        {%- if show_date -%}
          {{ article.published_at | time_tag: '%b %d, %Y' }}
        {%- endif -%}
        {%- if show_author and article.author != blank -%}
          {%- if show_date %} &middot; {% endif -%}
          <span class="article-card__author">{{ article.author }}</span>
        {%- endif -%}
      </p>
    {%- endif -%}

    <h3 class="article-card__title card__heading">
      <a href="{{ article.url }}" class="full-unstyled-link">{{ article.title }}</a>
    </h3>

    {%- if article.excerpt_or_content != blank -%}
      <p class="article-card__excerpt">
        {{ article.excerpt_or_content | strip_html | truncatewords: 25 }}
      </p>
    {%- endif -%}
  </div>
</article>

<style>
  .article-card{
    display: flex;
    flex-direction: column;
    height: 100%;
    text-align: left;
  }
  .article-card__media{
    position: relative;
    overflow: hidden;
    padding-top: 66%;
    border-radius: var(--card-corner-radius, 0);
    margin-bottom: 1.2rem;
  }
  .article-card__media .article-card__image{
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform .4s ease;
  }
  .article-card:hover .article-card__image{
    transform: scale(1.04);
  }
  .article-card__meta{
    font-size: 1.2rem;
    opacity: .7;
    margin: 0 0 .6rem;
  }
  .article-card__title{
    margin: 0 0 .8rem;
    font-size: 1.7rem;
    line-height: 1.3;
  }
  .article-card__title a:hover{
    text-decoration: underline;
  }
  .article-card__excerpt{
    margin: 0;
    font-size: 1.4rem;
    opacity: .85;
  }
</style>