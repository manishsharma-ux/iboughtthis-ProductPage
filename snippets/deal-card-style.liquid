<style>
.collection-custom-deal {
  padding: 50px 0;
}
.deal-card-main{
     background: #fff;
  border-radius: 14px;
  padding: 28px 32px;
  box-shadow: 0 10px 30px rgba(0,0,0,.12);
  margin-bottom: 30px;
}
.deal-card {
  position: relative;
  display: flex;
  align-items: flex-start;
  gap: 32px;
 
}

/* BADGE */
.deal-badge {
  position: absolute;
  top: 16px;
  left: 16px;
  background: #0b3b4a;
  color: #fff;
  font-size: 12px;
  font-weight: 600;
  padding: 6px 10px;
  border-radius: 4px;
}

/* LEFT */
.deal-left {
  display: flex;
  align-items: center;
  gap: 16px;
}

.deal-rank {
  width: 40px;
  height: 40px;
  border: 2px solid #0b3b4a;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 700;
  color: #0b3b4a;
}

.deal-image img {
  width: 140px;
  border-radius: 8px;
  object-fit: cover;
}

/* CENTER */
.deal-content {
  flex: 1;
}

.deal-title {
  font-size: 22px;
  font-weight: 700;
  margin-bottom: 8px;
}

.deal-title a {
  text-decoration: none;
  color: inherit;
}

.deal-brand {
  font-weight: 600;
  margin-bottom: 10px;
}

.deal-price {
  font-size: 20px;
  font-weight: 700;
  margin-bottom: 10px;
}

/* RIGHT */
.deal-right {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16px;
}

.deal-rating {
  width: 90px;
  height: 90px;
  border-radius: 50%;
  border: 6px solid #3a3f45;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28px;
  font-weight: 700;
}

.deal-btn {
  background: #0aa1d9;
  color: #fff;
  padding: 12px 28px;
  border-radius: 999px;
  font-weight: 700;
  text-decoration: none;
  font-size: 14px;
}

.deal-btn.small {
  padding: 10px 18px;
  font-size: 13px;
}

.deal-amazon {
  font-size: 20px;
  font-weight: 700;
}

/* ACCORDION */
.deal-accordion__toggle {
  background: none;
  border: none;
  font-weight: 700;
  cursor: pointer;
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 0;
}

.deal-accordion__toggle .close-text {
  display: none;
}

.deal-accordion__content {
  max-height: 0;
  overflow: hidden;
  transition: max-height .45s ease;
}

.deal-accordion.open .deal-accordion__content {
  max-height: 2000px;
}

.deal-accordion.open .open-text {
  display: none;
}

.deal-accordion.open .close-text {
  display: inline;
}

.deal-accordion__inner {
  display: flex;
  gap: 32px;
  padding-top: 20px;
}

.deal-description {
  flex: 1;
  font-size: 14px;
  line-height: 1.6;
}

.deal-amazon-box {
  width: 220px;
  border: 1px solid #ddd;
  border-radius: 12px;
  padding: 16px;
  text-align: center;
}

/* MOBILE */
@media (max-width: 768px) {
  .deal-card {
    flex-direction: column;
  }

  .deal-right {
    width: 100%;
    flex-direction: row;
    justify-content: space-between;
  }

  .deal-accordion__inner {
    flex-direction: column;
  }

  .deal-amazon-box {
    width: 100%;
  }
}
</style>

<!-- ================= SCRIPT ================= -->
<script>
document.addEventListener('DOMContentLoaded', function () {
  document.querySelectorAll('.deal-accordion__toggle').forEach(function (btn) {
    btn.addEventListener('click', function () {
      btn.closest('.deal-accordion').classList.toggle('open');
    });
  });
});
</script>