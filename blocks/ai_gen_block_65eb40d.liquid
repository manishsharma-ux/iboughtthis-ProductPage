{% doc %}
  @prompt
    full width image as section where we can add a image for desktop and mobile both
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-full-width-image-{{ ai_gen_id }} {
    width: 100%;
    display: block;
  }

  .ai-full-width-image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
  }

  .ai-full-width-image-desktop-{{ ai_gen_id }} {
    width: 100%;
    height: auto;
    display: block;
  }

  .ai-full-width-image-mobile-{{ ai_gen_id }} {
    width: 100%;
    height: auto;
    display: none;
  }

  .ai-full-width-image-placeholder-{{ ai_gen_id }} {
    background-color: #f4f4f4;
    width: 100%;
    min-height: {{ block.settings.min_height_desktop }}px;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .ai-full-width-image-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 800px;
    max-height: 400px;
  }

  .ai-full-width-empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    padding: 12px 20px;
    font-size: 14px;
    color: #666;
    text-align: center;
    pointer-events: none;
  }

  @media screen and (max-width: 749px) {
    .ai-full-width-image-desktop-{{ ai_gen_id }} {
      display: none;
    }

    .ai-full-width-image-mobile-{{ ai_gen_id }} {
      display: block;
    }

    .ai-full-width-image-placeholder-{{ ai_gen_id }} {
      min-height: {{ block.settings.min_height_mobile }}px;
    }
  }
{% endstyle %}

<div
  class="ai-full-width-image-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-full-width-image-wrapper-{{ ai_gen_id }}">
    {% if block.settings.image_desktop != blank or block.settings.image_mobile != blank %}
      {% if block.settings.image_desktop != blank %}
        <img
          src="{{ block.settings.image_desktop | image_url: width: 2400 }}"
          alt="{{ block.settings.image_desktop.alt | escape }}"
          loading="lazy"
          width="{{ block.settings.image_desktop.width }}"
          height="{{ block.settings.image_desktop.height }}"
          class="ai-full-width-image-desktop-{{ ai_gen_id }}"
        >
      {% endif %}

      {% if block.settings.image_mobile != blank %}
        <img
          src="{{ block.settings.image_mobile | image_url: width: 1200 }}"
          alt="{{ block.settings.image_mobile.alt | escape }}"
          loading="lazy"
          width="{{ block.settings.image_mobile.width }}"
          height="{{ block.settings.image_mobile.height }}"
          class="ai-full-width-image-mobile-{{ ai_gen_id }}"
        >
      {% elsif block.settings.image_desktop != blank %}
        <img
          src="{{ block.settings.image_desktop | image_url: width: 1200 }}"
          alt="{{ block.settings.image_desktop.alt | escape }}"
          loading="lazy"
          width="{{ block.settings.image_desktop.width }}"
          height="{{ block.settings.image_desktop.height }}"
          class="ai-full-width-image-mobile-{{ ai_gen_id }}"
        >
      {% endif %}
    {% else %}
      <div class="ai-full-width-image-placeholder-{{ ai_gen_id }}">
        {{ 'hero-apparel-1' | placeholder_svg_tag }}
        <div class="ai-full-width-empty-state-{{ ai_gen_id }}">
          Add desktop and mobile images
        </div>
      </div>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Full width image",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Desktop image"
    },
    {
      "type": "image_picker",
      "id": "image_desktop",
      "label": "Image"
    },
    {
      "type": "range",
      "id": "min_height_desktop",
      "label": "Minimum height",
      "min": 200,
      "max": 800,
      "step": 50,
      "unit": "px",
      "default": 400
    },
    {
      "type": "header",
      "content": "Mobile image"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Image"
    },
    {
      "type": "paragraph",
      "content": "If no mobile image is selected, the desktop image will be used on mobile devices."
    },
    {
      "type": "range",
      "id": "min_height_mobile",
      "label": "Minimum height",
      "min": 150,
      "max": 600,
      "step": 50,
      "unit": "px",
      "default": 300
    }
  ],
  "presets": [
    {
      "name": "Full width image"
    }
  ]
}
{% endschema %}
