{% doc %}
  @prompt
    create a custom code section for html css code
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-custom-code-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
  }

  .ai-custom-code-container-{{ ai_gen_id }} {
    width: 100%;
    padding: {{ block.settings.padding_vertical }}px {{ block.settings.padding_horizontal }}px;
    background-color: {{ block.settings.background_color }};
    border-radius: {{ block.settings.border_radius }}px;
  }

  .ai-custom-code-content-{{ ai_gen_id }} {
    width: 100%;
  }

  {{ block.settings.custom_css }}
{% endstyle %}

<custom-code-{{ ai_gen_id }} class="ai-custom-code-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-custom-code-container-{{ ai_gen_id }}">
    <div class="ai-custom-code-content-{{ ai_gen_id }}">
      {{ block.settings.custom_html }}
    </div>
  </div>
</custom-code-{{ ai_gen_id }}>

<script>
  (function() {
    class CustomCode{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.initCustomCode();
      }

      initCustomCode() {
        const scriptContent = this.querySelector('script[data-custom-script]');
        if (scriptContent) {
          try {
            const scriptElement = document.createElement('script');
            scriptElement.textContent = scriptContent.textContent;
            this.appendChild(scriptElement);
          } catch (error) {
            console.error('Error executing custom script:', error);
          }
        }
      }
    }

    customElements.define('custom-code-{{ ai_gen_id }}', CustomCode{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Custom code",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "HTML code"
    },
    {
      "type": "html",
      "id": "custom_html",
      "label": "HTML"
    },
    {
      "type": "header",
      "content": "CSS code"
    },
    {
      "type": "textarea",
      "id": "custom_css",
      "label": "CSS"
    },
    {
      "type": "header",
      "content": "Container style"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "padding_vertical",
      "label": "Padding vertical",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_horizontal",
      "label": "Padding horizontal",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Border radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Custom code"
    }
  ]
}
{% endschema %}
