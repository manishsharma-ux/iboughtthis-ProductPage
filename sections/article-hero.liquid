{% comment %}
  FILE: sections/article-hero.liquid
  PLACE IN THEME: sections/article-hero.liquid
  CHANGES v2:
    • Publish date pulled from article.published_at automatically (blog context)
    • image_picker settings for author photo and reviewer photo
    • Letter-avatar fallback when no image uploaded
{% endcomment %}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700;800&family=Source+Serif+4:ital,wght@0,300;0,400;0,600;1,400&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

<style>
  :root {
    --forbes-blue: #003087;
    --forbes-link: #0057A8;
    --forbes-border: #e2e2e2;
    --text-primary: #1a1a1a;
    --text-muted: #6b6b6b;
  }
  .article-hero {
    max-width: 960px;
    margin: 0 auto;
    padding: 36px 20px 0;
    font-family: 'Inter', sans-serif;
  }
  .article-hero__title {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: clamp(2rem, 5vw, 3.2rem);
    font-weight: 800;
    line-height: 1.12;
    color: var(--text-primary);
    margin: 0 0 16px;
    letter-spacing: -0.02em;
  }
  .article-hero__meta {
    font-size: 0.8rem;
    color: var(--text-muted);
    margin-bottom: 20px;
  }
  .article-hero__authors {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 28px;
    padding: 16px 0;
    border-top: 1px solid var(--forbes-border);
    border-bottom: 1px solid var(--forbes-border);
    margin-bottom: 32px;
  }
  .author-card {
    display: flex;
    align-items: center;
    gap: 10px;
    position: relative;
    cursor: pointer;
  }
  .author-card__avatar {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    object-fit: cover;
    border: 2px solid var(--forbes-border);
    flex-shrink: 0;
  }
  .author-card__avatar-placeholder {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: #c8d8f0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.05rem;
    font-weight: 700;
    color: #003087;
    border: 2px solid var(--forbes-border);
    flex-shrink: 0;
  }
  .author-card__info { display: flex; flex-direction: column; }
  .author-card__label { font-size: 0.72rem; color: var(--text-muted); }
  .author-card__name { font-size: 0.85rem; font-weight: 600; color: var(--forbes-link); text-decoration: underline; line-height: 1.3; }
  .author-card__title-text { font-size: 0.72rem; color: var(--text-muted); }

  .author-popup {
    display: none;
    position: absolute;
    top: calc(100% + 10px);
    left: 0;
    width: 340px;
    background: #fff;
    border: 1px solid var(--forbes-border);
    border-radius: 6px;
    box-shadow: 0 8px 32px rgba(0,0,0,0.13);
    padding: 20px;
    z-index: 200;
  }
  .author-card:hover .author-popup,
  .author-card:focus-within .author-popup { display: block; }
  .author-popup__header { display: flex; align-items: center; gap: 12px; margin-bottom: 12px; }
  .author-popup__avatar { width: 56px; height: 56px; border-radius: 50%; object-fit: cover; flex-shrink: 0; }
  .author-popup__avatar-placeholder {
    width: 56px; height: 56px; border-radius: 50%;
    background: #c8d8f0; display: flex; align-items: center;
    justify-content: center; font-size: 1.3rem; font-weight: 700; color: #003087; flex-shrink: 0;
  }
  .author-popup__name { font-size: 0.95rem; font-weight: 700; color: var(--forbes-link); display: block; }
  .author-popup__role { font-size: 0.78rem; color: var(--text-muted); }
  .author-popup__bio { font-size: 0.82rem; color: var(--text-primary); line-height: 1.6; margin-bottom: 14px; }
  .author-popup__footer { display: flex; align-items: center; justify-content: space-between; }
  .author-popup__linkedin { display: flex; align-items: center; justify-content: center; width: 28px; height: 28px; border: 1px solid var(--forbes-border); border-radius: 4px; }
  .author-popup__linkedin svg { width: 16px; height: 16px; fill: #0077b5; }
  .author-popup__bio-link { font-size: 0.82rem; color: var(--forbes-link); font-weight: 600; text-decoration: none; }
  .author-popup__bio-link:hover { text-decoration: underline; }

  .article-hero__description {
    font-family: 'Source Serif 4', Georgia, serif;
    font-size: clamp(1rem, 1.4vw, 1.18rem);
    line-height: 1.7;
    color: var(--text-primary);
    margin: 0 0 32px;
  }
  .article-hero__description p { margin: 0 0 16px; }
  .article-hero__description p:last-child { margin-bottom: 0; }
  .article-hero__description a { color: var(--forbes-link); text-decoration: underline; }
  .article-hero__description ul,
  .article-hero__description ol { padding-left: 22px; margin: 0 0 16px; }
  .article-hero__description li { margin-bottom: 6px; }

  @media (max-width: 600px) {
    .article-hero__authors { flex-direction: column; align-items: flex-start; gap: 16px; }
    .author-popup { width: 280px; }
  }
</style>

<section class="page-width" id="article-hero">
  <h1 class="article-hero__title">{{ section.settings.article_title }}</h1>

  <p class="article-hero__meta">
    Published:&nbsp;
    {%- if article.published_at -%}
      {{- article.published_at | date: '%b %-d, %Y, %-I:%M%P' -}}
    {%- elsif page.published_at -%}
      {{- page.published_at | date: '%b %-d, %Y' -}}
    {%- else -%}
      {{- section.settings.published_date -}}
    {%- endif -%}
  </p>

  <div class="article-hero__authors">

    {%- comment %} ── Author Card ── {%- endcomment %}
    <div class="author-card" tabindex="0">
      {%- if section.settings.author_image != blank -%}
        <img class="author-card__avatar"
             src="{{ section.settings.author_image | image_url: width: 88 }}"
             alt="{{ section.settings.author_name | escape }}" width="44" height="44">
      {%- else -%}
        <div class="author-card__avatar-placeholder">{{ section.settings.author_name | slice: 0, 1 | upcase }}</div>
      {%- endif -%}
      <div class="author-card__info">
        <span class="author-card__label">Written By</span>
        <span class="author-card__name">{{ section.settings.author_name }}</span>
        <span class="author-card__title-text">{{ section.settings.author_title }}</span>
      </div>
      <div class="author-popup">
        <div class="author-popup__header">
          {%- if section.settings.author_image != blank -%}
            <img class="author-popup__avatar" src="{{ section.settings.author_image | image_url: width: 112 }}" alt="{{ section.settings.author_name | escape }}" width="56" height="56">
          {%- else -%}
            <div class="author-popup__avatar-placeholder">{{ section.settings.author_name | slice: 0, 1 | upcase }}</div>
          {%- endif -%}
          <div>
            <span class="author-popup__name">{{ section.settings.author_name }}</span>
            <span class="author-popup__role">{{ section.settings.author_title }}</span>
          </div>
        </div>
        <p class="author-popup__bio">{{ section.settings.author_bio }}</p>
        <div class="author-popup__footer">
          {%- if section.settings.author_linkedin != blank -%}
            <a href="{{ section.settings.author_linkedin }}" class="author-popup__linkedin" target="_blank" rel="noopener" aria-label="LinkedIn">
              <svg viewBox="0 0 24 24"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
            </a>
          {%- endif -%}
          {%- if section.settings.author_bio_url != blank -%}
            <a href="{{ section.settings.author_bio_url }}" class="author-popup__bio-link">Read Full Bio &rarr;</a>
          {%- endif -%}
        </div>
      </div>
    </div>

    {%- comment %} ── Reviewer Card ── {%- endcomment %}
    {%- if section.settings.reviewer_name != blank -%}
    <div class="author-card" tabindex="0">
      {%- if section.settings.reviewer_image != blank -%}
        <img class="author-card__avatar" src="{{ section.settings.reviewer_image | image_url: width: 88 }}" alt="{{ section.settings.reviewer_name | escape }}" width="44" height="44">
      {%- else -%}
        <div class="author-card__avatar-placeholder">{{ section.settings.reviewer_name | slice: 0, 1 | upcase }}</div>
      {%- endif -%}
      <div class="author-card__info">
        <span class="author-card__label">Medically reviewed by</span>
        <span class="author-card__name">{{ section.settings.reviewer_name }}</span>
        <span class="author-card__title-text">{{ section.settings.reviewer_title }}</span>
      </div>
      <div class="author-popup">
        <div class="author-popup__header">
          {%- if section.settings.reviewer_image != blank -%}
            <img class="author-popup__avatar" src="{{ section.settings.reviewer_image | image_url: width: 112 }}" alt="{{ section.settings.reviewer_name | escape }}" width="56" height="56">
          {%- else -%}
            <div class="author-popup__avatar-placeholder">{{ section.settings.reviewer_name | slice: 0, 1 | upcase }}</div>
          {%- endif -%}
          <div>
            <span class="author-popup__name">{{ section.settings.reviewer_name }}</span>
            <span class="author-popup__role">{{ section.settings.reviewer_title }}</span>
          </div>
        </div>
        <p class="author-popup__bio">{{ section.settings.reviewer_bio }}</p>
        <div class="author-popup__footer">
          {%- if section.settings.reviewer_bio_url != blank -%}
            <a href="{{ section.settings.reviewer_bio_url }}" class="author-popup__bio-link">Read Full Bio &rarr;</a>
          {%- endif -%}
        </div>
      </div>
    </div>
    {%- endif -%}

  </div>

  {%- liquid
    assign hero_desc = ''
    case section.settings.description_source
      when 'excerpt'
        if article.excerpt != blank
          assign hero_desc = article.excerpt
        else
          assign hero_desc = section.settings.article_description
        endif
      when 'content'
        if article.content != blank
          assign hero_desc = article.content
        else
          assign hero_desc = section.settings.article_description
        endif
      else
        assign hero_desc = section.settings.article_description
    endcase
  -%}
  {%- if hero_desc != blank -%}
    <div class="article-hero__description">{{ hero_desc }}</div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Article Hero",
  "settings": [
    {
      "type": "text",
      "id": "article_title",
      "label": "Article Title",
      "default": "Best Hearing Aids Of 2026, According To Experts"
    },
    {
      "type": "text",
      "id": "published_date",
      "label": "Fallback Published Date",
      "info": "Only shown on non-article pages. On Blog Article pages the date is pulled automatically from the article's published_at timestamp.",
      "default": "Apr 2, 2026, 9:13am"
    },
    { "type": "header", "content": "Description" },
    {
      "type": "select",
      "id": "description_source",
      "label": "Description source",
      "info": "Where the hero description comes from. 'Excerpt' uses the post's excerpt (enable it via 'Add excerpt' in the blog editor); if empty, it falls back to the manual text below.",
      "options": [
        { "value": "excerpt", "label": "Blog post excerpt (recommended)" },
        { "value": "content", "label": "Blog post content (full body)" },
        { "value": "manual",  "label": "Manual text below" }
      ],
      "default": "excerpt"
    },
    {
      "type": "richtext",
      "id": "article_description",
      "label": "Description (manual / fallback)",
      "info": "Used when the source above is 'Manual', or as a fallback when the chosen blog field is empty. Leave blank to hide."
    },
    { "type": "header", "content": "Author" },
    {
      "type": "image_picker",
      "id": "author_image",
      "label": "Author Photo",
      "info": "Recommended: 200×200px square JPG/PNG. Leave blank to show initials avatar."
    },
    { "type": "text", "id": "author_name", "label": "Author Name", "default": "Jessica Lester" },
    { "type": "text", "id": "author_title", "label": "Author Job Title", "default": "Former Staff Editor" },
    { "type": "textarea", "id": "author_bio", "label": "Author Short Bio" },
    { "type": "url", "id": "author_linkedin", "label": "Author LinkedIn URL" },
    { "type": "url", "id": "author_bio_url", "label": "Author Full Bio Page URL" },
    { "type": "header", "content": "Medical Reviewer" },
    {
      "type": "image_picker",
      "id": "reviewer_image",
      "label": "Reviewer Photo",
      "info": "Recommended: 200×200px square. Leave blank to show initials avatar."
    },
    { "type": "text", "id": "reviewer_name", "label": "Reviewer Name", "default": "Lindsey Banks, Au.D." },
    { "type": "text", "id": "reviewer_title", "label": "Reviewer Job Title", "default": "Doctor of Audiology" },
    { "type": "textarea", "id": "reviewer_bio", "label": "Reviewer Short Bio" },
    { "type": "url", "id": "reviewer_bio_url", "label": "Reviewer Full Bio Page URL" }
  ],
  "presets": [{ "name": "Article Hero" }]
}
{% endschema %}