{% comment %}
  sections/article-author.liquid
  Displays author + reviewer with hover popup cards,
  plus an optional featured product widget on the right.

  Author metafields:
    article.metafields.custom.author_name
    article.metafields.custom.author_role
    article.metafields.custom.author_image
    article.metafields.custom.author_bio
    article.metafields.custom.author_linkedin
    article.metafields.custom.reviewer_name
    article.metafields.custom.reviewer_role
    article.metafields.custom.reviewer_image
    article.metafields.custom.reviewer_bio
    article.metafields.custom.reviewer_linkedin

  Featured product widget (section settings):
    section.settings.show_featured_product  — toggle on/off
    section.settings.featured_product       — product picker
    section.settings.featured_product_link  — override CTA URL (optional)
    section.settings.featured_cta_label     — button label (default "Learn More")
{% endcomment %}

{%- assign author_name   = article.metafields.custom.author_name   | default: article.author -%}
{%- assign author_role   = article.metafields.custom.author_role   | default: "Staff Editor" -%}
{%- assign author_image  = article.metafields.custom.author_image -%}
{%- assign author_bio    = article.metafields.custom.author_bio -%}
{%- assign author_li     = article.metafields.custom.author_linkedin -%}

{%- assign reviewer_name = article.metafields.custom.reviewer_name -%}
{%- assign reviewer_role = article.metafields.custom.reviewer_role | default: "Medical Reviewer" -%}
{%- assign reviewer_image= article.metafields.custom.reviewer_image -%}
{%- assign reviewer_bio  = article.metafields.custom.reviewer_bio -%}
{%- assign reviewer_li   = article.metafields.custom.reviewer_linkedin -%}

<section class="rl-article-author">
  <div class="rl-page-width">
    <div class="rl-author-row">

          {%- comment -%} AUTHOR {%- endcomment -%}
      <div class="rl-author-item" data-popup="popup-author">
        <div class="rl-author-avatar">
          {%- if author_image != blank -%}
            <img src="{{ author_image | image_url: width: 80 }}" alt="{{ author_name }}" width="40" height="40" loading="lazy">
          {%- else -%}
            <div class="rl-avatar-placeholder">{{ author_name | slice: 0 }}</div>
          {%- endif -%}
        </div>
        <div class="rl-author-text">
          <span class="rl-author-label">Written By</span>
          <span class="rl-author-name">{{ author_name }}</span>
          <span class="rl-author-role">{{ author_role }}</span>
        </div>

        {%- comment -%} Popup card {%- endcomment -%}
        <div class="rl-author-popup" id="popup-author" role="tooltip">
          <div class="rl-popup-inner">
            <div class="rl-popup-top">
              {%- if author_image != blank -%}
                <img src="{{ author_image | image_url: width: 120 }}" alt="{{ author_name }}" class="rl-popup-avatar" loading="lazy">
              {%- else -%}
                <div class="rl-avatar-placeholder rl-popup-avatar">{{ author_name | slice: 0 }}</div>
              {%- endif -%}
              <div>
                <p class="rl-popup-name">{{ author_name }}</p>
                <p class="rl-popup-role">{{ author_role }}</p>
              </div>
            </div>
            {%- if author_bio != blank -%}
              <p class="rl-popup-bio">{{ author_bio | truncate: 200 }}</p>
            {%- endif -%}
            {% comment %} <div class="rl-popup-footer">
              <a href="#" class="rl-popup-bio-link">See Full Bio</a>
              {%- if author_li != blank -%}
                <a href="{{ author_li }}" target="_blank" rel="noopener" class="rl-popup-li" aria-label="LinkedIn">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M20.45 20.45h-3.55v-5.57c0-1.33-.03-3.04-1.85-3.04-1.85 0-2.14 1.44-2.14 2.93v5.68H9.37V9h3.41v1.56h.05c.47-.9 1.63-1.85 3.35-1.85 3.58 0 4.25 2.36 4.25 5.43v6.31zM5.34 7.43a2.06 2.06 0 11.001-4.12 2.06 2.06 0 010 4.12zM6.88 20.45H3.8V9h3.08v11.45zM22.23 0H1.77C.79 0 0 .77 0 1.72v20.56C0 23.23.79 24 1.77 24h20.46c.98 0 1.77-.77 1.77-1.72V1.72C24 .77 23.21 0 22.23 0z"/></svg>
                </a>
              {%- endif -%}
            </div> {% endcomment %}
          </div>
        </div>
      </div>

      {%- comment -%} REVIEWER (only if metafield present) {%- endcomment -%}
      {%- if reviewer_name != blank -%}
        <div class="rl-author-item rl-reviewer-item" data-popup="popup-reviewer">
          <div class="rl-author-avatar">
            {%- if reviewer_image != blank -%}
              <img src="{{ reviewer_image | image_url: width: 80 }}" alt="{{ reviewer_name }}" width="40" height="40" loading="lazy">
            {%- else -%}
              <div class="rl-avatar-placeholder">{{ reviewer_name | slice: 0 }}</div>
            {%- endif -%}
          </div>
          <div class="rl-author-text">
            <span class="rl-author-label rl-reviewer-label">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none"><path d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" stroke="#3b82f6" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
              Medically Reviewed
            </span>
            <span class="rl-author-name">{{ reviewer_name }}</span>
            <span class="rl-author-role">{{ reviewer_role }}</span>
          </div>

          <div class="rl-author-popup" id="popup-reviewer" role="tooltip">
            <div class="rl-popup-inner">
              <div class="rl-popup-top">
                {%- if reviewer_image != blank -%}
                  <img src="{{ reviewer_image | image_url: width: 120 }}" alt="{{ reviewer_name }}" class="rl-popup-avatar" loading="lazy">
                {%- else -%}
                  <div class="rl-avatar-placeholder rl-popup-avatar">{{ reviewer_name | slice: 0 }}</div>
                {%- endif -%}
                <div>
                  <p class="rl-popup-name">{{ reviewer_name }}</p>
                  <p class="rl-popup-role">{{ reviewer_role }}</p>
                </div>
              </div>
              {%- if reviewer_bio != blank -%}
                <p class="rl-popup-bio">{{ reviewer_bio | truncate: 200 }}</p>
              {%- endif -%}
              {% comment %} <div class="rl-popup-footer">
                <a href="#" class="rl-popup-bio-link">See Full Bio</a>
                {%- if reviewer_li != blank -%}
                  <a href="{{ reviewer_li }}" target="_blank" rel="noopener" class="rl-popup-li" aria-label="LinkedIn">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M20.45 20.45h-3.55v-5.57c0-1.33-.03-3.04-1.85-3.04-1.85 0-2.14 1.44-2.14 2.93v5.68H9.37V9h3.41v1.56h.05c.47-.9 1.63-1.85 3.35-1.85 3.58 0 4.25 2.36 4.25 5.43v6.31zM5.34 7.43a2.06 2.06 0 11.001-4.12 2.06 2.06 0 010 4.12zM6.88 20.45H3.8V9h3.08v11.45zM22.23 0H1.77C.79 0 0 .77 0 1.72v20.56C0 23.23.79 24 1.77 24h20.46c.98 0 1.77-.77 1.77-1.72V1.72C24 .77 23.21 0 22.23 0z"/></svg>
                  </a>
                {%- endif -%}
              </div> {% endcomment %}
            </div>
          </div>
        </div>
      {%- endif -%}

        </div>{%- comment -%} /.rl-author-row {%- endcomment -%}
  </div>
</section>

<style>
  .rl-article-author {
    background: #fff;
    border-bottom: 1px solid #e5e7eb;
    padding: 18px 0;
  }
  .rl-author-row {
    display: flex;
    flex-wrap: wrap;
    gap: 24px;
    align-items: flex-start;
  }

  /* Each author item */
  .rl-author-item {
    position: relative;
    display: flex;
    align-items: center;
    gap: 10px;
    cursor: pointer;
    padding: 4px 0;
  }
  .rl-author-item + .rl-author-item {
    padding-left: 24px;
    border-left: 1px solid #e5e7eb;
  }

  /* Avatar */
  .rl-author-avatar img,
  .rl-avatar-placeholder {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    object-fit: cover;
    flex-shrink: 0;
  }
  .rl-avatar-placeholder {
    background: #0b2a4a;
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-size: 16px;
    text-transform: uppercase;
  }

  /* Text block */
  .rl-author-text {
    display: flex;
    flex-direction: column;
    gap: 1px;
    font-size: 13px;
  }
  .rl-author-label {
    color: #6b7280;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .rl-reviewer-label {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    color: #3b82f6;
    text-transform: none;
    font-weight: 600;
    font-size: 12px;
  }
  .rl-author-name {
    font-weight: 700;
    color: #111;
    font-size: 14px;
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .rl-author-role {
    color: #6b7280;
    font-size: 12px;
  }

  /* Popup */
  .rl-author-popup {
    position: absolute;
    top: calc(100% + 10px);
    left: 0;
    z-index: 200;
    width: 300px;
    background: #fff;
    border: 1px solid #e5e7eb;
    border-radius: 10px;
    box-shadow: 0 10px 40px rgba(0,0,0,0.14);
    opacity: 0;
    visibility: hidden;
    transform: translateY(6px);
    transition: opacity 0.22s ease, transform 0.22s ease, visibility 0.22s;
    pointer-events: none;
  }
  .rl-author-item:hover .rl-author-popup,
  .rl-author-item:focus-within .rl-author-popup {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
    pointer-events: auto;
  }
  .rl-popup-inner { padding: 16px; }
  .rl-popup-top {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    margin-bottom: 10px;
  }
  .rl-popup-avatar {
    width: 52px !important;
    height: 52px !important;
    border-radius: 50%;
    object-fit: cover;
    flex-shrink: 0;
    font-size: 20px;
  }
  .rl-popup-name {
    font-weight: 700;
    color: #111;
    font-size: 15px;
    margin: 0 0 2px;
  }
  .rl-popup-role {
    font-size: 12px;
    color: #6b7280;
    margin: 0;
  }
  .rl-popup-bio {
    font-size: 13px;
    color: #444;
    line-height: 1.6;
    margin: 0 0 12px;
    border-top: 1px solid #f0f0f0;
    padding-top: 10px;
  }
  .rl-popup-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .rl-popup-bio-link {
    font-size: 13px;
    color: #0b2a4a;
    font-weight: 600;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 4px;
  }
  .rl-popup-bio-link::after { content: " →"; }
  .rl-popup-li {
    color: #0077b5;
    transition: opacity 0.2s;
  }
  .rl-popup-li:hover { opacity: 0.7; }

  @media (max-width: 600px) {
    .rl-author-item + .rl-author-item {
      padding-left: 0;
      border-left: none;
      border-top: 1px solid #e5e7eb;
      padding-top: 14px;
    }
    .rl-author-popup { width: 260px; }
  }
</style>

{% schema %}
{
  "name": "Article Author",
  "settings": []
}
{% endschema %}
