<!-- article-content.liquid -->
{%- style -%}
  .next_prev .icon{
    stroke:currentColor;
    fill:none;
    width:14px;
  }
  .next_prev .article__photo-container{
    width:92px;
  }
  .featured-img .article__photo-wrapper{
    overflow:hidden;
  }
  .featured-img .article__photo-wrapper img{
    height:100%;
    object-fit:cover;
  }
  .featured-img .h750px{
      height:550px;
      padding-top: 0 !important;
  }
  .featured-img .h650px{
      height:450px;
      padding-top: 0 !important;
  }
  .featured-img .h550px{
      height:300px;
      padding-top: 0 !important;
  }
  .featured-img .h450px{
      height:250px;
      padding-top: 0 !important;
  }
  .featured-img .h350px{
      height:200px;
      padding-top: 0 !important;
  }

  @media screen and (min-width: 750px) {
    .featured-img .h750px{
        height:750px;
    }
    .featured-img .h650px{
        height:650px;
    }
    .featured-img .h550px{
        height:550px;
    }
    .featured-img .h450px{
        height:450px;
    }
    .featured-img .h350px{
        height:350px;
    }
  }
{%- endstyle -%}
{%- liquid
  assign new_comment = false 
  if comment and comment.created_at 
    assign new_comment = true 
    assign new_comment_id = comment.id 
  endif 
  if new_comment 
    assign duplicate_comment = false
    for comment in article.comments 
      if comment.id == new_comment_id  
        assign duplicate_comment = true
        break 
      endif 
    endfor 

    if duplicate_comment 
      assign number_of_comments = article.comments_count 
    else 
      assign number_of_comments = article.comments_count | plus: 1 
    endif 
  else 
    assign number_of_comments = article.comments_count 
  endif 

  assign enable_date = section.settings.enable_date
  assign enable_image = section.settings.enable_image
  assign image_size = section.settings.height_adapt
  assign enable_tag = section.settings.enable_tag
  assign enable_comment = section.settings.enable_comment
  assign enable_author = section.settings.enable_author
  assign layout_featured = section.settings.layout_featured
  assign enable_full = section.settings.enable_full
  assign align = section.settings.align

  comment
    The refreshed styling is opt-in: article-template backs a dozen other
    templates, so leaving it off by default keeps those pages exactly as they are.
  endcomment
  assign modern = section.settings.modern_ui

  comment
    Attached product. Two ways to vary it per post, and the priority setting
    says which wins when both are present:

    "template" (default) - duplicate this template per product, pick the
      product in the customizer, then assign posts to that template. The
      picker below is the product for every post on this template.

    "post" - one template, and each post overrides via a
      custom.attached_product metafield or a product:handle tag.

    Whichever runs second still fills in when the first is empty, so a
    template with no product picked can still be driven per post, and a
    post with no tag still falls back to the template's product.
  endcomment
  assign tag_prefix = section.settings.product_tag_prefix | default: 'product:' | downcase
  assign attached_product = blank

  if section.settings.product_priority != 'post'
    assign attached_product = section.settings.attached_product
  endif

  if attached_product == blank
    assign attached_product = article.metafields.custom.attached_product.value
  endif

  if attached_product == blank
    for t in article.tags
      assign t_dc = t | downcase | strip
      if t_dc contains tag_prefix
        assign wanted = t_dc | remove_first: tag_prefix | strip

        comment
          Accept a bare handle, a pasted product URL, or a typed title -
          handleize normalises all three to the handle Shopify stores.
        endcomment
        if wanted contains '?'
          assign wanted = wanted | split: '?' | first
        endif
        if wanted contains '/'
          assign wanted = wanted | split: '/' | last
        endif
        assign wanted = wanted | handleize

        assign candidate = all_products[wanted]
        if candidate.handle != blank
          assign attached_product = candidate
          break
        endif
      endif
    endfor
  endif

  if attached_product == blank
    assign attached_product = section.settings.attached_product
  endif

  comment
    Tags left after the product:handle helper is filtered out. Used to drop the
    tag row entirely rather than leave a label icon with nothing beside it.
  endcomment
  assign visible_tags = 0
  for t in article.tags
    assign t_dc = t | downcase | strip
    unless modern and t_dc contains tag_prefix
      assign visible_tags = visible_tags | plus: 1
    endunless
  endfor

  assign rail_on = false
  if modern and section.settings.rail_enable
    if attached_product != blank or request.design_mode
      assign rail_on = true
    endif
  endif

  comment
    Column widths for the body, sharing the row with the legacy sidebar
    and/or the attached product rail.
  endcomment
  if section.settings.sidebar_enable and rail_on
    assign main_col = 'col-lg-6 col-12'
  elsif section.settings.sidebar_enable
    assign main_col = 'col-md-9'
  elsif rail_on
    assign main_col = 'col-lg-8 col-12'
  else
    assign main_col = 'col-md-8'
  endif

  if section.settings.sidebar_enable
    if section.settings.sidebar_position == 'left'
      assign main_col = main_col | append: ' pl-lg-5'
    else
      assign main_col = main_col | append: ' pr-lg-5'
    endif
  endif
-%}
{%- if modern -%}
{%- comment -%} Scoped refresh: only emitted when "Modern UI" is on. {%- endcomment -%}
{%- style -%}
  #shopify-section-{{ section.id }}{
    --ibt-ar-accent:{{ section.settings.accent_color }};
    --ibt-ar-accent-hover:{{ section.settings.accent_color | color_darken: 8 }};
    --ibt-ar-ink:#1a1a1a;
    --ibt-ar-body:#54595f;
    --ibt-ar-line:#e6e6e6;
    --ibt-ar-soft:#f7f7f5;
    --ibt-ar-radius:16px;
  }

  /* ---------- reading progress ---------- */
  .ibt-progress-{{ section.id }}{
    position:fixed;
    top:0;
    left:0;
    right:0;
    height:3px;
    z-index:998;
    background:transparent;
    pointer-events:none;
  }
  .ibt-progress-{{ section.id }} span{
    display:block;
    height:100%;
    width:0;
    background:var(--ibt-ar-accent);
    transition:width .1s linear;
  }

  /* ---------- hero ---------- */
  #shopify-section-{{ section.id }} .featured-over .article__photo-wrapper:before{
    background:linear-gradient(180deg, rgba(0,0,0,.25) 0%, rgba(0,0,0,.45) 55%, rgba(0,0,0,.7) 100%);
  }
  #shopify-section-{{ section.id }} .featured-over h1{
    font-size:clamp(28px, 4vw, 46px);
    line-height:1.2;
    font-weight:700;
    letter-spacing:-.01em;
    margin-bottom:18px;
  }
  #shopify-section-{{ section.id }} .featured-over .blog__meta{
    font-size:13px;
    opacity:.92;
  }
  #shopify-section-{{ section.id }} .featured-over .content-block{
    margin-bottom:3rem;
  }

  /* ---------- article body ---------- */
  #shopify-section-{{ section.id }} .rte[itemprop="articleBody"]{
    font-size:17px;
    line-height:1.8;
    color:#2d3138;
  }
  #shopify-section-{{ section.id }} .rte[itemprop="articleBody"] > * + *{
    margin-top:1.35em;
  }
  #shopify-section-{{ section.id }} .rte[itemprop="articleBody"] h2,
  #shopify-section-{{ section.id }} .rte[itemprop="articleBody"] h3,
  #shopify-section-{{ section.id }} .rte[itemprop="articleBody"] h4{
    color:var(--ibt-ar-ink);
    font-weight:700;
    line-height:1.3;
    letter-spacing:-.01em;
    margin-top:2em;
    margin-bottom:.6em;
    scroll-margin-top:110px;
  }
  #shopify-section-{{ section.id }} .rte[itemprop="articleBody"] h2{ font-size:28px; }
  #shopify-section-{{ section.id }} .rte[itemprop="articleBody"] h3{ font-size:22px; }
  #shopify-section-{{ section.id }} .rte[itemprop="articleBody"] h4{ font-size:18px; }

  #shopify-section-{{ section.id }} .rte[itemprop="articleBody"] a:not(.button):not(.btn){
    color:var(--ibt-ar-accent);
    text-decoration:underline;
    text-underline-offset:3px;
    text-decoration-thickness:1px;
    transition:color .2s ease;
  }
  #shopify-section-{{ section.id }} .rte[itemprop="articleBody"] a:not(.button):not(.btn):hover{
    color:var(--ibt-ar-accent-hover);
  }

  #shopify-section-{{ section.id }} .rte[itemprop="articleBody"] img{
    border-radius:var(--ibt-ar-radius);
    display:block;
    margin:2em auto;
  }
  #shopify-section-{{ section.id }} .rte[itemprop="articleBody"] ul,
  #shopify-section-{{ section.id }} .rte[itemprop="articleBody"] ol{
    padding-left:1.3em;
  }
  #shopify-section-{{ section.id }} .rte[itemprop="articleBody"] li + li{
    margin-top:.5em;
  }
  #shopify-section-{{ section.id }} .rte[itemprop="articleBody"] li::marker{
    color:var(--ibt-ar-accent);
  }
  #shopify-section-{{ section.id }} .rte[itemprop="articleBody"] blockquote{
    margin:2em 0;
    padding:18px 24px;
    border-left:3px solid var(--ibt-ar-accent);
    background:var(--ibt-ar-soft);
    border-radius:0 12px 12px 0;
    font-size:18px;
    font-style:italic;
    color:var(--ibt-ar-ink);
  }
  #shopify-section-{{ section.id }} .rte[itemprop="articleBody"] blockquote p:last-child{
    margin-bottom:0;
  }
  #shopify-section-{{ section.id }} .rte[itemprop="articleBody"] hr{
    margin:2.5em 0;
    border:0;
    border-top:1px solid var(--ibt-ar-line);
  }
  /* Wide tables scroll instead of pushing the page sideways. */
  #shopify-section-{{ section.id }} .rte[itemprop="articleBody"] table{
    width:100%;
    display:block;
    overflow-x:auto;
    border-collapse:collapse;
    font-size:15px;
  }
  #shopify-section-{{ section.id }} .rte[itemprop="articleBody"] th,
  #shopify-section-{{ section.id }} .rte[itemprop="articleBody"] td{
    border:1px solid var(--ibt-ar-line);
    padding:10px 14px;
    text-align:left;
  }
  #shopify-section-{{ section.id }} .rte[itemprop="articleBody"] th{
    background:var(--ibt-ar-soft);
    font-weight:700;
    color:var(--ibt-ar-ink);
  }

  /* ---------- tags + share ---------- */
  #shopify-section-{{ section.id }} .list-blog-tags{
    margin-bottom:0;
  }
  #shopify-section-{{ section.id }} .list-blog-tags li{
    padding:0 !important;
    margin:0 6px 0 0 !important;
  }
  #shopify-section-{{ section.id }} .list-blog-tags li a{
    display:inline-block;
    font-size:11px;
    font-weight:600;
    letter-spacing:.05em;
    text-transform:uppercase;
    color:var(--ibt-ar-accent);
    background:var(--ibt-ar-soft);
    border-radius:999px;
    padding:5px 12px;
    text-decoration:none;
    transition:background .2s ease, color .2s ease;
  }
  #shopify-section-{{ section.id }} .list-blog-tags li a:hover{
    background:var(--ibt-ar-accent);
    color:#fff;
  }

  /* ---------- prev / next ---------- */
  #shopify-section-{{ section.id }} .next_prev > li{
    padding:0 14px;
  }
  #shopify-section-{{ section.id }} .next_prev .media{
    width:100%;
    padding:16px;
    border:1px solid var(--ibt-ar-line);
    border-radius:var(--ibt-ar-radius);
    background:#fff;
    transition:border-color .25s ease, box-shadow .25s ease, transform .25s ease;
  }
  #shopify-section-{{ section.id }} .next_prev .media:hover{
    transform:translateY(-2px);
    border-color:transparent;
    box-shadow:0 12px 30px rgba(16,24,40,.1);
  }
  #shopify-section-{{ section.id }} .next_prev .article__photo-wrapper{
    border-radius:10px;
    overflow:hidden;
  }
  #shopify-section-{{ section.id }} .next_prev .h5{
    font-size:15px;
    line-height:1.4;
    font-weight:600;
    color:var(--ibt-ar-ink);
    display:-webkit-box;
    -webkit-line-clamp:2;
    -webkit-box-orient:vertical;
    overflow:hidden;
    text-decoration:none;
  }
  #shopify-section-{{ section.id }} .next_prev .h5:hover{
    color:var(--ibt-ar-accent);
  }
  #shopify-section-{{ section.id }} .next_prev .border-left{
    border-left:0 !important;
  }

  /* ---------- comments ---------- */
  #shopify-section-{{ section.id }} .comments .comment{
    border:1px solid var(--ibt-ar-line) !important;
    border-radius:var(--ibt-ar-radius);
    padding:18px 20px !important;
    margin-bottom:14px !important;
    background:#fff;
  }
  #shopify-section-{{ section.id }} .comment-form .form-control{
    border:1px solid var(--ibt-ar-line);
    border-radius:12px;
    padding:12px 16px;
    font-size:15px;
    background:#fff;
    transition:border-color .2s ease, box-shadow .2s ease;
  }
  #shopify-section-{{ section.id }} .comment-form .form-control:focus{
    outline:none;
    border-color:var(--ibt-ar-accent);
    box-shadow:0 0 0 4px {{ section.settings.accent_color | color_modify: 'alpha', 0.12 }};
  }
  #shopify-section-{{ section.id }} .comment-form .btn{
    border-radius:999px;
    padding:12px 30px;
    font-weight:700;
  }

  /* ---------- attached product rail ---------- */
  #shopify-section-{{ section.id }} .ibt-article-rail{
    display:flex;
    flex-direction:column;
    margin-bottom:28px;
  }
  #shopify-section-{{ section.id }} .ibt-article-rail > *{
    flex:1 1 auto;
  }
  /* The rail column must not stretch: JS gives the wrapper an explicit height
     that defines exactly how far the pinned card may travel. */
  @media (min-width:992px){
    #shopify-section-{{ section.id }} .ibt-article-rail{
      align-self:flex-start;
    }
    #shopify-section-{{ section.id }} .ibt-article-rail > *{
      flex:0 0 auto;
    }
  }

  @media (max-width:749px){
    #shopify-section-{{ section.id }} .rte[itemprop="articleBody"]{
      font-size:16px;
      line-height:1.75;
    }
    #shopify-section-{{ section.id }} .rte[itemprop="articleBody"] h2{ font-size:23px; }
    #shopify-section-{{ section.id }} .rte[itemprop="articleBody"] h3{ font-size:19px; }
    #shopify-section-{{ section.id }} .next_prev > li{
      padding:0 6px;
    }
  }

  @media (prefers-reduced-motion:reduce){
    .ibt-progress-{{ section.id }} span,
    #shopify-section-{{ section.id }} .next_prev .media{
      transition:none !important;
    }
    #shopify-section-{{ section.id }} .next_prev .media:hover{
      transform:none;
    }
  }
{%- endstyle -%}

{%- if section.settings.enable_progress -%}
  <div class="ibt-progress-{{ section.id }}" aria-hidden="true">
    <span data-bar></span>
  </div>
{%- endif -%}
{%- endif -%}

{%- render 'style-section' -%}
<div class="article-main wrapper customstyle{{ section.id }}" data-aos="{{ section.settings.animation }}">
  {%- comment -%} <div class="indicator"></div> {%- endcomment -%}

{%- liquid
   case layout_featured
     when 'basic'
      render 'featured-basic-article' , article: article, enable_date: enable_date, enable_comment: enable_comment, enable_author: enable_author, enable_image: enable_image, image_size: image_size, enable_full: enable_full, align: align, enable_tag: enable_tag
      when 'first-image'
      render 'featured-first-image-article' , article: article, enable_date: enable_date, enable_comment: enable_comment, enable_author: enable_author, enable_image: enable_image, image_size: image_size, enable_full: enable_full, align: align, enable_tag: enable_tag
      when 'in-image'
      render 'featured-in-image-article' , article: article, enable_date: enable_date, enable_comment: enable_comment, enable_author: enable_author, enable_image: enable_image, image_size: image_size, enable_full: enable_full, align: align, enable_tag: enable_tag
      else
     render 'featured-basic-article', article: article, enable_date: enable_date, enable_comment: enable_comment, enable_author: enable_author, enable_image: enable_image, image_size: image_size, enable_full: enable_full, align: align, enable_tag: enable_tag
   endcase
-%}

<div class="container">
  <article itemscope itemtype="http://schema.org/Article" class="row {% if section.settings.sidebar_position == 'left' %}flex-row-reverse{% endif %} {% unless section.settings.sidebar_enable or rail_on %} justify-content-center{% endunless %}">
    <div  class="{{ main_col }}">
      
      
      <div class="content-block">
        <div class="rte rte--indented-images mb-5" itemprop="articleBody">
          {{ article.content }}
        </div>
        <div class="border-top py-4">
          <div class="d-flex justify-content-start justify-content-lg-between align-items-center flex-wrap">
            {%- if visible_tags > 0 -%}
            <div class="d-flex align-items-center">
              {%- render 'icon-tag' -%}
                <ul class="list-unstyled list-blog-tags ml-2">
                {% for tag in article.tags %}
                {%- comment -%} Skip the product:handle helper tag - it drives the rail, it is not a real topic. {%- endcomment -%}
                {%- assign tag_dc = tag | downcase | strip -%}
                {%- unless modern and tag_dc contains tag_prefix -%}
                <li class=" d-inline-block px-2 py-1 mr-2">
                  <a href="{{ blog.url }}/tagged/{{ tag | handle }}" class="button">{{ tag }}</a>{% if forloop.last %}{% else %}, {% endif %}
                </li>
                {%- endunless -%}
                {% endfor %}
                </ul>
            </div>
            {%- endif -%}
           
            {%- if section.settings.social_sharing_blog -%}
              {%- render 'social-sharing', share_title: article.title, share_permalink: article.url, share_image: article.image -%}
            {%- endif -%}
          </div>
        </div>
        {%- if section.settings.blog_show_previous_and_next_buttons -%}
        <div class=" py-lg-5 py-4 border-top border-bottom mb-5">
          <ul class="list-unstyled row next_prev">
            <li class="col d-flex justify-content-start pr-2 pr-md-5  ">
              {%- if blog.previous_article -%}
                {%- assign prev = blog.previous_article -%}
                <div class="d-flex flex-column">
                  <div class="media">
                    <div class="article__photo-container mr-3 d-lg-block d-none">
                    <a class="w-100 article__photo-wrapper position-relative square d-block" href="{{ prev.url }}" style="padding-top:{{ 1 | divided_by: prev.image.aspect_ratio | times: 100 }}%;">
                      <img class="lazyload" 
                        data-widths="[120,360]"
                        loading="lazy"
                        width="{{ prev.image.width }}" 
                        height="{{ prev.image.height }}"
                        src="{{ prev.image | image_url: width: 1, height: 1 }}"
                        data-src="{{ prev.image | image_url: width: 300 }}"
                      alt="{{ prev.title | escape }}" >
                    </a>
                    </div>
                    <div class="media-body">
                      <a class="d-flex align-items-center text-uppercase small txt-body-60"  href="{{ prev }}"> 
                        <svg focusable="false" width="17" height="14" class="icon icon--arrow-left mr-2" viewBox="0 0 17 14">
                          <path d="M17 7H2M8 1L2 7l6 6" stroke="currentColor" stroke-width="1.3" fill="none"></path>
                        </svg>
                        {{ 'blogs.article.pre_post' | t }} 
                      </a>
                      <a class="h5 mt-2 d-lg-block d-none" href="{{ prev }}">{{ blog.previous_article.title }}</a>
                    </div>
                  </div>
              </div>
              {%- endif -%}
              
            </li>
            <li class="col d-flex pl-2 pl-md-5 border-left justify-content-end  ">
              {%- if blog.next_article -%}
                {%- assign next = blog.next_article -%}
              <div class="d-flex flex-column justify-content-end text-right">
                <div class="media flex-row-reverse">
                  <div class="article__photo-container ml-3 d-lg-block d-none">
                    <a class="w-100 article__photo-wrapper position-relative square d-block" href="{{ article.url }}" style="padding-top:{{ 1 | divided_by: next.image.aspect_ratio | times: 100 }}%;">
                      <img class="lazyload" 
                        data-widths="[120,360]"
                        loading="lazy"
                        width="{{ next.image.width }}"
                        height="{{ next.image.height }}"
                        src="{{ next.image | image_url: width: 1, height: 1 }}"
                        data-src="{{ next.image | image_url: width: 300 }}"
                      alt="{{ next.title | escape }}" >
                    </a>
                  </div>
                  <div class="media-body">
                    <a class="d-flex align-items-center text-uppercase small txt-body-60 justify-content-end" href="{{ blog.next_article }}">
                      {{ 'blogs.article.next_post' | t }} 
                      <svg focusable="false" width="17" height="14" class="icon icon--arrow-right  ml-2" viewBox="0 0 17 14">
                      <path d="M0 7h15M9 1l6 6-6 6" stroke="currentColor" stroke-width="1.3" fill="none"></path>
                    </svg></a>
                    <a class="h5 mt-2 d-lg-block d-none" href="{{ blog.next_article }}">{{ blog.next_article.title }}</a>
                  </div>
                </div>
              
            </div>
            {%- endif -%}
            </li>
          </ul>
        </div>
        {%- endif -%}
        
        
      </div>
      
      

      {%- if blog.comments_enabled? -%}
      {%- if number_of_comments > 0 -%}
      <div class="content-block">
        {% unless section.settings.sidebar_enable %} <div class="d-flex justify-content-center"><div class="col-12"> {% endunless %}
        <h2 class="h4 text-capitalize">{{ 'blogs.comments.with_count' | t: count: number_of_comments }}</h2>

        {%- paginate article.comments by 3 -%}

        <div id="comments">
          {%- if new_comment -%}
          <p class="form-success">
            {%- if blog.moderated? -%}
            {{ 'blogs.comments.success_moderated' | t }}
            {%- else -%}
            {{ 'blogs.comments.success' | t }}
            {%- endif -%}
          </p>
          {%- endif -%}

          {%- if number_of_comments > 0 -%}
          <ul class="comments list--no-bullets js-pagination-content">

            {%- if new_comment -%}
            {%- unless paginate.current_page > 1 -%}
            <li id="{{ comment.id }}" class="comment py-4 mb-0">
              {%- render 'comment', comment: comment -%}
            </li>
            {%- endunless -%}
            {%- endif -%}

            {%- for comment in article.comments -%}
            {%- unless comment.id == new_comment_id -%}
            <li id="{{ comment.id }}" class="comment border-bottom py-4 mb-0">
              {%- render 'comment', comment: comment -%}
            </li>
            {%- endunless -%}
            {%- endfor -%}
          </ul>
          
          <div class="js-pagination">
            {%- if paginate.next -%}
            <a href="{{ paginate.next.url }}"></a>
            {%- endif -%}
          </div>
          
          {%- endif -%}
        </div>
        {%- endpaginate -%}
        {% unless section.settings.sidebar_enable %}</div> </div> {% endunless %}
      </div>
      {%- endif -%}
      <div class="content-block pt-3">
        {% unless section.settings.sidebar_enable %} <div class="d-flex justify-content-center"><div class="col-12"> {% endunless %}
        <div class="comment-form form-vertical">
          {%- form 'new_comment', article -%}

          <h4 class="h4 text-capitalize">{{ 'blogs.comments.title' | t }}</h4>
          <p class="mb-5">{{ 'blogs.comments.description' | t }}</p>
          {{ form.errors | default_errors }}

          <div class="row">
            <div class="col-md-6">
              <div class="form-group">
                <input type="text" name="comment[author]" id="CommentAuthor" class="form-control {% if form.errors contains 'author' %} input--error{% endif %}" placeholder="{{ 'blogs.comments.name' | t }}" value="{{ form.author }}">
                <label for="CommentAuthor" class="label--hidden">{{ 'blogs.comments.name' | t }}</label>
              </div>
            </div>

            <div class="col-md-6 ">
              <div class="form-group">
                
                <input type="email" name="comment[email]" id="CommentEmail" class="form-control {% if form.errors contains 'email' %} input--error{% endif %}" placeholder="{{ 'blogs.comments.email' | t }}" value="{{ form.email }}" autocorrect="off" autocapitalize="off">
                <label for="CommentEmail" class="label--hidden">{{ 'blogs.comments.email' | t }}</label>
              </div>
            </div>
          </div>
          <div class="form-group ">
            <textarea name="comment[body]" id="CommentBody" class="form-control form-control-area {% if form.errors contains 'body' %} input--error{% endif %}" placeholder="{{ 'blogs.comments.message' | t }}" style="height:150px">{{ form.body }}</textarea>
            <label for="CommentBody" class="label--hidden">{{ 'blogs.comments.message' | t }}</label>
          </div>

          <input type="submit" class="btn btn-theme d-inline-block w-auto mt-2" value="{{ 'blogs.comments.post' | t }}">

          {%- if blog.moderated? -%}
          <p class="text-center">{{ 'blogs.comments.moderated' | t }}</p>
          {%- endif -%}
          {%- endform -%}
        </div>
        {% unless section.settings.sidebar_enable %}</div> </div> {% endunless %}
      </div>
      
      
      {%- endif -%}

    </div>
    {%- if rail_on -%}
    <div class="{% if section.settings.sidebar_enable %}col-lg-3{% else %}col-lg-4{% endif %} col-12 ibt-article-rail{% if section.settings.rail_position == 'left' %} order-lg-first{% endif %}">
      {%- render 'ibt-sticky-product',
            product_ref: attached_product,
            uid: section.id,
            heading: section.settings.rail_heading,
            cta_label: section.settings.rail_cta_label,
            cta_note: section.settings.rail_cta_note,
            accent: section.settings.accent_color,
            compact: section.settings.rail_compact,
            sticky_top: section.settings.rail_sticky_top,
            show_mobile: section.settings.rail_show_mobile,
            mobile_after: section.settings.rail_mobile_after -%}
    </div>
    {%- endif -%}
    {%- if section.settings.sidebar_enable -%}
    {%- render 'blogSidebar' -%}
    {%- endif -%}
  </article>
</div>
</div>

{%- if modern and section.settings.enable_progress -%}
  <script>
    (function () {
      var bar = document.querySelector('.ibt-progress-{{ section.id }} [data-bar]');
      var body = document.querySelector('#shopify-section-{{ section.id }} .rte[itemprop="articleBody"]');
      if (!bar || !body) return;

      var ticking = false;

      // Progress across the article body only, so the bar reads 100% at the
      // end of the post rather than at the end of the comments and footer.
      var sync = function () {
        ticking = false;
        var rect = body.getBoundingClientRect();
        var total = rect.height - window.innerHeight;
        if (total <= 0) {
          bar.style.width = rect.bottom <= window.innerHeight ? '100%' : '0%';
          return;
        }
        var pct = (-rect.top / total) * 100;
        bar.style.width = Math.min(100, Math.max(0, pct)) + '%';
      };

      var onScroll = function () {
        if (ticking) return;
        ticking = true;
        window.requestAnimationFrame(sync);
      };

      window.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('resize', onScroll, { passive: true });
      sync();
    })();
  </script>
{%- endif -%}

{%- if rail_on -%}
  <script>
    (function () {
      var rail = document.querySelector('#shopify-section-{{ section.id }} .ibt-article-rail');
      var body = document.querySelector('#shopify-section-{{ section.id }} .rte[itemprop="articleBody"]');
      if (!rail || !body) return;
      var wrap = rail.firstElementChild;
      var card = wrap && wrap.querySelector('[data-rail]');
      if (!wrap || !card) return;

      var offset = parseInt('{{ section.settings.rail_sticky_top | default: 100 }}', 10) || 100;
      var travel = 0;

      // The wrapper reserves the column space and defines how far the card can
      // travel. Bounded by the article body when the card should let go at the
      // end of the post, otherwise by the whole row.
      var stopAtContent = {% if section.settings.rail_stop_at_content %}true{% else %}false{% endif %};
      var measure = function () {
        card.classList.remove('is-fixed', 'is-parked');
        card.style.width = '';
        wrap.style.height = '';
        var edge = stopAtContent
          ? body.getBoundingClientRect().bottom
          : (rail.parentNode ? rail.parentNode.getBoundingClientRect().bottom : body.getBoundingClientRect().bottom);
        travel = edge - wrap.getBoundingClientRect().top;
        if (travel < 0) travel = 0;
        wrap.style.height = travel + 'px';
      };

      var position = function () {
        if (window.innerWidth < 992) {
          card.classList.remove('is-fixed', 'is-parked');
          card.style.width = '';
          return;
        }
        var wrapTop = wrap.getBoundingClientRect().top;
        var cardHeight = card.offsetHeight;

        if (wrapTop > offset) {
          // Article has not reached the pin line yet.
          card.classList.remove('is-fixed', 'is-parked');
          card.style.width = '';
        } else if (wrapTop + travel - cardHeight > offset) {
          // Pinned: content scrolls, card holds its place.
          card.classList.add('is-fixed');
          card.classList.remove('is-parked');
          card.style.width = wrap.clientWidth + 'px';
        } else {
          // End of the post - let the card go with the page.
          card.classList.remove('is-fixed');
          card.classList.add('is-parked');
          card.style.width = '';
        }
      };

      var ticking = false;
      var onScroll = function () {
        if (ticking) return;
        ticking = true;
        window.requestAnimationFrame(function () {
          ticking = false;
          position();
        });
      };

      var refresh = function () {
        measure();
        position();
      };

      refresh();
      window.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('resize', refresh, { passive: true });
      window.addEventListener('load', refresh);
      if ('ResizeObserver' in window) {
        new ResizeObserver(refresh).observe(body);
      }
    })();
  </script>
{%- endif -%}

