<!-- blog-template-1.liquid -->
{%- liquid
    assign blog_layout  = section.settings.blog_layout
    assign grid_column  = section.settings.grid_column
    assign image_size   = section.settings.image_size

    comment
      The attached product rail takes a quarter of the row, so drop one column
      from the post grid to stop the cards being squeezed.
    endcomment
    assign attached_product = section.settings.attached_product
    assign rail_on = false
    if attached_product != blank or request.design_mode
      if section.settings.rail_enable
        assign rail_on = true
      endif
    endif

    if rail_on and blog_layout == 'grid'
      case grid_column
      when '4'
        assign grid_column = '3'
      when '3'
        assign grid_column = '2'
      endcase
    endif

    assign enable_btn_blog = section.settings.enable_btn_blog
    assign enable_btn_line = section.settings.enable_btn_line
    assign enable_date  = section.settings.enable_date
    assign enable_tag   = section.settings.enable_tag
    assign enable_comment = section.settings.enable_comment
    assign enable_short = section.settings.enable_short
    assign animation    = section.settings.animation

    if blog_layout == 'grid' 
      case grid_column
      when '2'
        assign col = "col-lg-6 col-12" 
      when '3'
        assign col = "col-lg-4 col-12" 
      when '4'
        assign col = "col-lg-3 col-12" 
      else
        assign col = "col-lg-6 col-12" 
      endcase
    else
      assign col = "col-12 col-md-12" 
    endif 

    case section.settings.search_scope
    when 'products'
      assign blog_search_types = 'product'
    when 'all'
      assign blog_search_types = 'product,article,page'
    else
      assign blog_search_types = 'article'
    endcase

    comment
      Width of the posts column, sharing the row with the legacy sidebar
      and/or the attached product rail.
    endcomment
    if section.settings.sidebar_enable and rail_on
      assign main_col = 'col-lg-6 col-12'
    elsif section.settings.sidebar_enable
      assign main_col = 'col-md-9'
    elsif rail_on
      assign main_col = 'col-lg-9 col-12'
    else
      assign main_col = 'col-12'
    endif

    if section.settings.sidebar_enable
      if section.settings.sidebar_position == 'left'
        assign main_col = main_col | append: ' pl-lg-5'
      else
        assign main_col = main_col | append: ' pr-lg-5'
      endif
    endif
-%}
<style>
  .sidebar-blog-wrap.is_stuck{padding-top:20px}
  .blog__item .blog__content{
    text-align: left;
  }
  .article__photo-wrapper.portrait{
    padding-top: 120% !important;
    overflow: hidden;
  }
  .article__photo-wrapper.square{
    padding-top: 100% !important;
    overflow: hidden;
  }
  .article__photo-wrapper.landscape{
    padding-top: 75% !important;
    overflow: hidden;
  }
  .article__photo-wrapper.wide{
    padding-top: 56% !important;
    overflow: hidden;
  }
  .article__photo-wrapper.portrait img,.article__photo-wrapper.square img, .article__photo-wrapper.landscape img,.article__photo-wrapper.wide img{
    height: 100%;
    object-fit: cover;
  }
  @media(max-width:749px){
    .blog__item--3 .article__photo-wrapper{
      padding-top: 100% !important;
    }
  }

  /* Top search bar */
  .blog-search-bar{
    max-width: 35rem;
    margin: 0 auto 3rem;
  }
  .blog-search-bar .field{
    position: relative;
  }
  .blog-search-bar .search__input{
    width: 100%;
    padding-right: 3rem;
  }
  .blog-search-bar .search__button{
    position: absolute;
    top: 0;
    bottom: 0;
    right: 0;
    width: 3rem;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .blog-search-bar .search__button svg{
    width: 20px;
    height: 20px;
  }

  {%- if blog_layout == 'list' %}
  @media (min-width: 768px){
    .blog__item.blog__item--1 {
      display: flex;
      flex-wrap: wrap;
    }
    .blog__item.blog__item--1 .content-block__image,.blog__item .blog__content{
      flex: 0 0 50%;
      max-width: 50%;
    }
    .blog__item.blog__item--1 .blog__content{
      padding:0px 16px 16px 40px;
    }
  }
 
  .blog__title-link{
    margin-bottom: 30px;
  }
  .blog__item.blog__item--3 .content-block__image,.blog__item.blog__item--3 .blog__content{
    flex: 0 0 100%;
    max-width: 100%;
  }
  .article__photo-container{
    margin-bottom: 0;
  }
  .blog__item.blog__item--5 .content-block__image,.blog__item.blog__item--5 .blog__content{
    flex: 0 0 100%;
    max-width: 100%;
  }
  .article__photo-container{
    margin-bottom: 0;
  }
{%- endif -%}
</style>

{%- comment -%} Scoped refresh: everything below only affects this section. {%- endcomment -%}
{%- style -%}
  #shopify-section-{{ section.id }}{
    --ibt-bl-accent:{{ section.settings.accent_color }};
    --ibt-bl-accent-hover:{{ section.settings.accent_color | color_darken: 8 }};
    --ibt-bl-ink:#1a1a1a;
    --ibt-bl-body:#54595f;
    --ibt-bl-line:#e6e6e6;
    --ibt-bl-soft:#f7f7f5;
    --ibt-bl-radius:16px;
  }

  /* ---------- search ---------- */
  #shopify-section-{{ section.id }} .blog-search-bar{
    max-width:38rem;
    margin:0 auto 3.5rem;
  }
  #shopify-section-{{ section.id }} .blog-search-bar .search__input{
    height:52px;
    border:1px solid var(--ibt-bl-line);
    border-radius:999px;
    padding:0 3.25rem 0 1.35rem;
    font-size:15px;
    background:#fff;
    box-shadow:0 1px 2px rgba(16,24,40,.04);
    transition:border-color .2s ease, box-shadow .2s ease;
  }
  #shopify-section-{{ section.id }} .blog-search-bar .search__input:focus{
    outline:none;
    border-color:var(--ibt-bl-accent);
    box-shadow:0 0 0 4px {{ section.settings.accent_color | color_modify: 'alpha', 0.12 }};
  }
  #shopify-section-{{ section.id }} .blog-search-bar .field__label{
    position:absolute !important;
    width:1px;
    height:1px;
    overflow:hidden;
    clip:rect(0 0 0 0);
    white-space:nowrap;
  }
  #shopify-section-{{ section.id }} .blog-search-bar .search__button{
    width:3.25rem;
    color:var(--ibt-bl-body);
    background:transparent;
    transition:color .2s ease;
  }
  #shopify-section-{{ section.id }} .blog-search-bar .search__button:hover{
    color:var(--ibt-bl-accent);
  }

  /* ---------- grid rhythm ---------- */
  #shopify-section-{{ section.id }} .ibt-blog-grid{
    margin-left:-14px;
    margin-right:-14px;
  }
  #shopify-section-{{ section.id }} .ibt-blog-grid > [class*="col-"]{
    padding-left:14px;
    padding-right:14px;
    margin-bottom:28px;
    display:flex;
  }
  #shopify-section-{{ section.id }} .ibt-blog-grid > [class*="col-"] > *{
    width:100%;
  }

  /* ---------- card ---------- */
  #shopify-section-{{ section.id }} .ibt-bc{
    display:flex;
    flex-direction:column;
    width:100%;
    background:#fff;
    border:1px solid var(--ibt-bl-line);
    border-radius:var(--ibt-bl-radius);
    overflow:hidden;
    box-shadow:0 1px 2px rgba(16,24,40,.04);
    transition:transform .3s ease, box-shadow .3s ease, border-color .3s ease;
  }
  #shopify-section-{{ section.id }} .ibt-bc:hover{
    transform:translateY(-4px);
    border-color:transparent;
    box-shadow:0 16px 40px rgba(16,24,40,.13);
  }

  #shopify-section-{{ section.id }} .ibt-bc__media{
    position:relative;
    display:block;
    overflow:hidden;
    background:var(--ibt-bl-soft);
  }
  #shopify-section-{{ section.id }} .ibt-bc__media img{
    position:absolute;
    inset:0;
    width:100%;
    height:100%;
    object-fit:cover;
    transition:transform .55s cubic-bezier(.2,.6,.2,1);
  }
  #shopify-section-{{ section.id }} .ibt-bc:hover .ibt-bc__media img{
    transform:scale(1.06);
  }
  #shopify-section-{{ section.id }} .ibt-bc__media--empty{
    background:linear-gradient(135deg, var(--ibt-bl-soft) 0%, #ececea 100%);
  }
  #shopify-section-{{ section.id }} .ibt-bc__initial{
    position:absolute;
    inset:0;
    display:flex;
    align-items:center;
    justify-content:center;
    font-size:56px;
    font-weight:700;
    color:#c9c9c4;
  }
  #shopify-section-{{ section.id }} .ibt-bc__time{
    position:absolute;
    left:12px;
    bottom:12px;
    z-index:2;
    background:rgba(26,26,26,.82);
    color:#fff;
    font-size:11px;
    font-weight:600;
    letter-spacing:.03em;
    padding:4px 9px;
    border-radius:999px;
  }

  #shopify-section-{{ section.id }} .ibt-bc__body{
    display:flex;
    flex-direction:column;
    flex:1 1 auto;
    padding:18px 20px 20px;
  }

  #shopify-section-{{ section.id }} .ibt-bc__tags{
    display:flex;
    flex-wrap:wrap;
    gap:6px;
    margin-bottom:10px;
  }
  #shopify-section-{{ section.id }} .ibt-bc__tag{
    font-size:11px;
    font-weight:600;
    letter-spacing:.05em;
    text-transform:uppercase;
    color:var(--ibt-bl-accent);
    background:var(--ibt-bl-soft);
    border-radius:999px;
    padding:4px 10px;
    text-decoration:none;
    transition:background .2s ease, color .2s ease;
  }
  #shopify-section-{{ section.id }} .ibt-bc__tag:hover{
    background:var(--ibt-bl-accent);
    color:#fff;
  }

  #shopify-section-{{ section.id }} .ibt-bc__title{
    font-size:19px;
    line-height:1.35;
    font-weight:600;
    margin:0 0 10px;
  }
  #shopify-section-{{ section.id }} .ibt-bc__title a{
    color:var(--ibt-bl-ink);
    text-decoration:none;
    display:-webkit-box;
    -webkit-line-clamp:2;
    -webkit-box-orient:vertical;
    overflow:hidden;
    transition:color .2s ease;
  }
  #shopify-section-{{ section.id }} .ibt-bc__title a:hover{
    color:var(--ibt-bl-accent);
  }

  #shopify-section-{{ section.id }} .ibt-bc__excerpt{
    font-size:14px;
    line-height:1.65;
    color:var(--ibt-bl-body);
    margin:0 0 18px;
    display:-webkit-box;
    -webkit-line-clamp:3;
    -webkit-box-orient:vertical;
    overflow:hidden;
  }

  #shopify-section-{{ section.id }} .ibt-bc__foot{
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:12px;
    margin-top:auto;
    padding-top:14px;
    border-top:1px solid var(--ibt-bl-line);
  }
  #shopify-section-{{ section.id }} .ibt-bc__meta{
    display:flex;
    align-items:center;
    gap:8px;
    font-size:12px;
    color:var(--ibt-bl-body);
  }
  #shopify-section-{{ section.id }} .ibt-bc__dot{
    width:3px;
    height:3px;
    border-radius:50%;
    background:currentColor;
    opacity:.5;
  }
  #shopify-section-{{ section.id }} .ibt-bc__more{
    display:inline-flex;
    align-items:center;
    gap:6px;
    font-size:13px;
    font-weight:700;
    color:var(--ibt-bl-accent);
    text-decoration:none;
    white-space:nowrap;
  }
  #shopify-section-{{ section.id }} .ibt-bc__more svg{
    width:13px;
    height:13px;
    transition:transform .25s ease;
  }
  #shopify-section-{{ section.id }} .ibt-bc__more:hover{
    color:var(--ibt-bl-accent-hover);
  }
  #shopify-section-{{ section.id }} .ibt-bc:hover .ibt-bc__more svg{
    transform:translateX(3px);
  }

  /* ---------- rail column ---------- */
  /* The column stretches to the row height; the wrapper has to stretch with it
     or position:sticky has no travel and the card never follows the reader. */
  #shopify-section-{{ section.id }} .ibt-blog-rail{
    display:flex;
    flex-direction:column;
    margin-bottom:28px;
  }
  #shopify-section-{{ section.id }} .ibt-blog-rail > *{
    flex:1 1 auto;
  }

  /* ---------- pagination ---------- */
  #shopify-section-{{ section.id }} .pagination-blog{
    margin-top:12px;
  }

  @media (max-width:749px){
    #shopify-section-{{ section.id }} .blog-search-bar{
      margin-bottom:2.25rem;
    }
    #shopify-section-{{ section.id }} .ibt-bc__title{
      font-size:17px;
    }
  }

  @media (prefers-reduced-motion:reduce){
    #shopify-section-{{ section.id }} .ibt-bc,
    #shopify-section-{{ section.id }} .ibt-bc__media img,
    #shopify-section-{{ section.id }} .ibt-bc__more svg{
      transition:none !important;
    }
    #shopify-section-{{ section.id }} .ibt-bc:hover{
      transform:none;
    }
    #shopify-section-{{ section.id }} .ibt-bc:hover .ibt-bc__media img{
      transform:none;
    }
  }
{%- endstyle -%}

{%- render 'style-section' -%}
<div class="customstyle{{ section.id }}">
  <div class="container">
    {%- if section.settings.enable_search -%}
      <div class="blog-search-bar">
        <form action="{{ routes.search_url }}" method="get" role="search" class="search">
          <div class="field form-group">
            <input type="hidden" name="type" value="{{ blog_search_types }}">
            <input
              class="search__input field__input form-control"
              id="BlogSearch-{{ section.id }}"
              type="search"
              name="q"
              value="{{ search.terms | escape }}"
              placeholder="{{ section.settings.search_placeholder | default: 'Search the blog' }}"
            >
            <label class="field__label" for="BlogSearch-{{ section.id }}">{{ section.settings.search_placeholder | default: 'Search the blog' }}</label>
            <input name="options[prefix]" type="hidden" value="last">
            <button type="submit" class="search__button field__button border-0" aria-label="{{ 'general.search.search' | t }}">
              {%- render 'icon-search' -%}
            </button>
          </div>
        </form>
      </div>
    {%- endif -%}
    <div class="row {% if section.settings.sidebar_position == 'left' %}flex-row-reverse{% endif %}">
      {%- assign limit = section.settings.limit -%}
      {%- paginate blog.articles by limit -%}
      <div class="{{ main_col }}">
        <div class="row{% if section.settings.item_style == 'ibt-card' %} ibt-blog-grid{% endif %}">
          {%- for article in blog.articles -%}
          <div class="{{ col }} {% if forloop.index == 3 %}col--last{% endif %}">
            {%- liquid
              case section.settings.item_style
              when 'ibt-card'
                render 'ibt-blog-card', article: article, image_size: image_size, enable_btn_blog: enable_btn_blog, enable_date: enable_date, enable_tag: enable_tag, enable_comment: enable_comment, enable_short: enable_short, enable_read_time: section.settings.enable_read_time, animation: animation
              when 'blog-1'
                render 'blog-grid-1', article : article, image_size : image_size, enable_btn_blog : enable_btn_blog, enable_btn_line: enable_btn_line, enable_date : enable_date, enable_tag : enable_tag, enable_comment: enable_comment, enable_short : enable_short, animation: animation
              when 'blog-3'
                render 'blog-grid-3', article : article, image_size : image_size, enable_btn_blog : enable_btn_blog, enable_btn_line: enable_btn_line, enable_date : enable_date, enable_tag : enable_tag, enable_comment: enable_comment, enable_short : enable_short
              when 'blog-5'
                render 'blog-grid-5', article : article, image_size : image_size, enable_btn_blog : enable_btn_blog, enable_btn_line: enable_btn_line, enable_date : enable_date, enable_tag : enable_tag, enable_comment: enable_comment, enable_short : enable_short
              when 'blog-6'
                render 'blog-grid-6', article : article, image_size : image_size, enable_btn_blog : enable_btn_blog, enable_btn_line: enable_btn_line, enable_date : enable_date, enable_tag : enable_tag, enable_comment: enable_comment, enable_short : enable_short
              when 'blog-7'
                render 'blog-grid-7', article : article, image_size : image_size, enable_btn_blog : enable_btn_blog, enable_btn_line: enable_btn_line, enable_date : enable_date, enable_tag : enable_tag, enable_comment: enable_comment, enable_short : enable_short
              else
                render 'blog-grid-blank'
              endcase
            -%}
            
          </div>
          {%- endfor -%}
        </div>
        {%- if paginate.pages > 1 -%}
          {% render 'pagination', paginate: paginate, anchor: '', padding-top: 'pagination-blog' %}
        {%- endif -%}
      </div>
      {%- endpaginate -%}
      {%- if rail_on -%}
      <div class="col-lg-3 col-12 ibt-blog-rail{% if section.settings.rail_position == 'left' %} order-lg-first{% endif %}">
        {%- render 'ibt-sticky-product',
              product_ref: attached_product,
              uid: section.id,
              heading: section.settings.rail_heading,
              cta_label: section.settings.rail_cta_label,
              cta_note: section.settings.rail_cta_note,
              accent: section.settings.accent_color,
              sticky_top: section.settings.rail_sticky_top,
              show_mobile: section.settings.rail_show_mobile,
              mobile_after: section.settings.rail_mobile_after -%}
      </div>
      {%- endif -%}
      {%- if section.settings.sidebar_enable -%}
      {%- render 'blogSidebar' -%}
      {%- endif -%}
    </div>
  </div>
</div>
