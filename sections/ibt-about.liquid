<!-- ibt-about.liquid | IBT product page - Section 2: About the product -->
{%- liquid
  assign body = section.settings.body

  if body == blank and product.metafields.custom.short_details.value != blank
    assign body = product.metafields.custom.short_details.value | newline_to_br
  endif
  if body == blank and product.metafields.custom.short_description.value != blank
    assign body = product.metafields.custom.short_description.value
  endif
  if body == blank
    assign body = product.description
  endif

  assign img = section.settings.image
  if img == blank and section.settings.use_product_image
    assign img = product.images[1] | default: product.featured_image
  endif

  assign has_img = false
  if img != blank
    assign has_img = true
  endif
-%}

{%- style -%}
  #shopify-section-{{ section.id }}{
    --ibt-ink:#1a1a1a;
    --ibt-body:#54595f;
    --ibt-line:#e6e6e6;
    --ibt-soft:#f7f7f5;
    --ibt-radius:14px;
    background-color:{{ section.settings.bgsection }};
    padding:{{ section.settings.paddingsection }};
    margin:{{ section.settings.marginsection }};
  }
  @media (max-width:750px){
    #shopify-section-{{ section.id }}{
      padding:{{ section.settings.paddingmobile }};
      margin:{{ section.settings.marginmobile }};
    }
  }
{%- endstyle -%}

<style>
  #shopify-section-{{ section.id }} .ibt-about{
    {% if section.settings.boxed %}
      border:1px solid var(--ibt-line);
      border-radius:var(--ibt-radius);
      padding:32px;
    {% endif %}
  }
  #shopify-section-{{ section.id }} .ibt-about__grid{
    display:grid;
    gap:32px;
    align-items:center;
    grid-template-columns:1fr;
  }
  #shopify-section-{{ section.id }} .ibt-eyebrow{
    font-size:12px;
    font-weight:700;
    letter-spacing:.08em;
    text-transform:uppercase;
    color:#8a8f94;
    margin:0 0 10px;
  }
  #shopify-section-{{ section.id }} .ibt-h2{
    font-size:28px;
    line-height:1.3;
    font-weight:700;
    color:var(--ibt-ink);
    margin:0 0 16px;
  }
  #shopify-section-{{ section.id }} .ibt-about__body{
    font-size:17px;
    line-height:1.75;
    color:var(--ibt-body);
  }
  #shopify-section-{{ section.id }} .ibt-about__body > *:last-child{ margin-bottom:0; }
  #shopify-section-{{ section.id }} .ibt-about__body p{ margin:0 0 14px; }
  #shopify-section-{{ section.id }} .ibt-about__body ul,
  #shopify-section-{{ section.id }} .ibt-about__body ol{
    margin:0 0 14px;
    padding-left:20px;
  }
  #shopify-section-{{ section.id }} .ibt-about__body li{ margin-bottom:6px; }
  #shopify-section-{{ section.id }} .ibt-about__media img{
    display:block;
    width:100%;
    height:auto;
    border-radius:var(--ibt-radius);
    background:var(--ibt-soft);
  }
  #shopify-section-{{ section.id }} .ibt-about__caption{
    font-size:13px;
    color:#8a8f94;
    margin:10px 0 0;
    text-align:center;
  }
  @media (min-width:768px){
    {% if has_img %}
      #shopify-section-{{ section.id }} .ibt-about__grid{
        grid-template-columns:{% if section.settings.image_position == 'left' %}minmax(0,{{ section.settings.image_width }}fr) minmax(0,{{ 100 | minus: section.settings.image_width }}fr){% else %}minmax(0,{{ 100 | minus: section.settings.image_width }}fr) minmax(0,{{ section.settings.image_width }}fr){% endif %};
        gap:48px;
      }
      #shopify-section-{{ section.id }} .ibt-about__media{
        order:{% if section.settings.image_position == 'left' %}0{% else %}1{% endif %};
      }
      #shopify-section-{{ section.id }} .ibt-about__text{
        order:{% if section.settings.image_position == 'left' %}1{% else %}0{% endif %};
      }
    {% endif %}
  }
  @media (max-width:767px){
    #shopify-section-{{ section.id }} .ibt-about{ {% if section.settings.boxed %}padding:24px;{% endif %} }
    #shopify-section-{{ section.id }} .ibt-h2{ font-size:24px; }
    #shopify-section-{{ section.id }} .ibt-about__body{ font-size:16px; }
    #shopify-section-{{ section.id }} .ibt-about__media{ order:0; }
  }
</style>

<div class="{{ section.settings.setwidth }}" id="ibt-about">
  <div class="ibt-about" {% if section.settings.animation != blank %}data-aos="{{ section.settings.animation }}"{% endif %}>
    <div class="ibt-about__grid">

      {%- if has_img -%}
        <div class="ibt-about__media">
          <img
            src="{{ img | image_url: width: 900 }}"
            srcset="{{ img | image_url: width: 500 }} 500w, {{ img | image_url: width: 900 }} 900w, {{ img | image_url: width: 1400 }} 1400w"
            sizes="(min-width:768px) 45vw, 100vw"
            alt="{{ img.alt | default: product.title | escape }}"
            loading="lazy"
            width="{{ img.width | default: 900 }}"
            height="{{ img.height | default: 900 }}"
          >
          {%- if section.settings.image_caption != blank -%}
            <p class="ibt-about__caption">{{ section.settings.image_caption }}</p>
          {%- endif -%}
        </div>
      {%- endif -%}

      <div class="ibt-about__text">
        {%- if section.settings.eyebrow != blank -%}
          <p class="ibt-eyebrow">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        <h2 class="ibt-h2">{{ section.settings.heading | default: 'About the product' }}</h2>
        <div class="ibt-about__body rte">
          {{ body }}
        </div>
      </div>

    </div>
  </div>
</div>

{% schema %}
{
  "name": "IBT 2. About the product",
  "settings": [
    {
      "type": "select",
      "id": "setwidth",
      "label": "Container",
      "default": "container",
      "options": [
        { "value": "container", "label": "Container" },
        { "value": "container-fluid", "label": "Container fluid" },
        { "value": "full", "label": "Full width" }
      ]
    },
    { "type": "header", "content": "Content" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow label" },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "About the product"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Body copy",
      "info": "2-3 plain-language sentences: what it does, who it's for. Leave blank to fall back to the Short Details metafield, then the product description."
    },
    { "type": "header", "content": "Image" },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image",
      "info": "Optional. Use an in-use lifestyle shot to keep the photo / claim rhythm going."
    },
    {
      "type": "checkbox",
      "id": "use_product_image",
      "label": "Fall back to 2nd product photo",
      "default": false
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image position (desktop)",
      "default": "left",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ]
    },
    {
      "type": "range",
      "id": "image_width",
      "label": "Image column width",
      "min": 30,
      "max": 60,
      "step": 5,
      "unit": "%",
      "default": 45
    },
    { "type": "text", "id": "image_caption", "label": "Image caption" },
    { "type": "header", "content": "Section style" },
    { "type": "checkbox", "id": "boxed", "label": "Show card border", "default": false },
    {
      "type": "select",
      "id": "animation",
      "label": "Animation",
      "default": "fade-up",
      "options": [
        { "value": "", "label": "None" },
        { "value": "fade", "label": "Fade" },
        { "value": "fade-up", "label": "Fade up" }
      ]
    },
    { "type": "color", "id": "bgsection", "label": "Background", "default": "#ffffff" },
    { "type": "text", "id": "paddingsection", "label": "Padding desktop", "default": "48px 0px 48px 0px" },
    { "type": "text", "id": "paddingmobile", "label": "Padding mobile", "default": "32px 0px 32px 0px" },
    { "type": "text", "id": "marginsection", "label": "Margin desktop", "default": "0px 0px 0px 0px" },
    { "type": "text", "id": "marginmobile", "label": "Margin mobile", "default": "0px 0px 0px 0px" }
  ],
  "presets": [{ "name": "IBT 2. About the product" }]
}
{% endschema %}
