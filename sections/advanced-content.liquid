<!-- advanced-content.liquid -->
{%-liquid
  assign text_color = section.settings.text_color
  assign slide_blocks = section.blocks | where: 'type', 'slide'
  assign slide_count = slide_blocks.size
  assign grid_block_count = section.blocks.size | minus: slide_count
  assign slider_height = section.settings.slider_height | default: '550'
  assign slider_height_mobile = section.settings.slider_height_mobile | default: '400'
-%}
<style>
  .customstyle{{ section.id }}{
    position: relative;
    z-index: {{ section.settings.zindex }};
    background-position: {{ section.settings.e_position }} !important;
    background-repeat: {{ section.settings.e_repeat }} !important;
    background-size: {{ section.settings.e_size }} !important;
    {% if section.settings.padding %}
    --g-hgutter: {{ section.settings.padding_custom }}px;
    {% endif %}
    {% if text_color != 'rgba(0,0,0,0)' %}
      --g-font-color-subtop: {{ text_color }};
      --g-color-heading :  {{ text_color }};
      --color-body-text : {{ text_color }};
      --color-body-text-rgb: {{ text_color.red }}, {{ text_color.green }},  {{ text_color.blue }} ;
    {% endif %}
  }
  .customstyle{{ section.id }}::before {
    position: absolute;
    top: 0;
    right: 0;
    left: 0;
    content: "";
    height: {{ section.settings.rangebg }}%;
    background-color: {{ section.settings.bgbefore }};
  }
  .customstyle{{ section.id }} .advand-html-des{
    display: inline-block;
  }
  .customstyle{{ section.id }} .advand-html-des ul li svg{
    flex-shrink: 0;
    width: auto;
    height: auto;
    
  }
  .customstyle{{ section.id }} .advand-html-des ul li{
    text-align: left;
  }
 
  @media (max-width:1499px) {
    .customstyle{{ section.id }} {
      background-image:unset !important;
    }
  }
  @media (max-width:992px) {
    .customstyle{{ section.id }} .advand-html-des ul li{
      flex-direction: column;
      text-align: center;
    }
    .customstyle{{ section.id }} .advand-html-des ul li svg{
      margin-bottom: 10px;
    }
   
  }

  {%- if slide_count > 0 -%}
  {%- liquid
    assign arrow_bg = section.settings.slider_arrow_bg | default: 'rgba(0,0,0,0.35)'
    assign dot_color = section.settings.slider_dot_color | default: '#ffffff'
  -%}
  /* ---------- Banner slider ---------- */
  .customstyle{{ section.id }} .adv-banner-slider-wrapper{
    position: relative;
    --adv-arrow-color: {{ section.settings.slider_arrow_color | default: '#ffffff' }};
    --adv-arrow-bg: {{ arrow_bg }};
    --adv-dot-rgb: {{ dot_color.red }},{{ dot_color.green }},{{ dot_color.blue }};
    --adv-content-width: {{ section.settings.slider_content_width | default: 900 }}px;
    {%- if section.settings.padding and section.settings.setwidth != 'full' -%}
    margin-right: calc(0px - var(--g-hgutter));
    margin-left: calc(0px - var(--g-hgutter));
    {%- endif -%}
  }
  .customstyle{{ section.id }} .adv-banner-slider{
    position: relative;
    margin-bottom: 0;
  }
  .customstyle{{ section.id }} .adv-banner-slider:not(.slick-initialized) .adv-banner-slide + .adv-banner-slide{
    display: none;
  }
  .customstyle{{ section.id }} .adv-banner-slide{
    position: relative;
    overflow: hidden;
    width: 100%;
    background-color: #111111;
  }
  .customstyle{{ section.id }} .adv-banner-slide__media,
  .customstyle{{ section.id }} .adv-banner-slide__overlay,
  .customstyle{{ section.id }} .adv-banner-slide__link,
  .customstyle{{ section.id }} .adv-banner-slide__inner{
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
  }
  .customstyle{{ section.id }} .adv-banner-slide__media{ z-index: 1; }
  .customstyle{{ section.id }} .adv-banner-slide__overlay{ z-index: 2; pointer-events: none; }
  .customstyle{{ section.id }} .adv-banner-slide__link{ z-index: 3; display: block; }
  .customstyle{{ section.id }} .adv-banner-slide__inner{
    z-index: 4;
    padding: 40px 6%;
    pointer-events: none;
  }
  .customstyle{{ section.id }} .adv-banner-slide__content{
    width: 100%;
    max-width: var(--adv-content-width);
    pointer-events: auto;
  }
  .customstyle{{ section.id }} .adv-banner-slide__img,
  .customstyle{{ section.id }} .adv-banner-slide__media .placeholder-svg{
    display: block;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
    object-position: var(--adv-img-pos, center center);
  }
  .customstyle{{ section.id }} .adv-banner-slide__sub{ margin-bottom: 12px; }
  .customstyle{{ section.id }} .adv-banner-slide__title{ margin-bottom: 16px; }
  .customstyle{{ section.id }} .adv-banner-slide__des{ display: inline-block; max-width: 100%; }
  .customstyle{{ section.id }} .adv-banner-slide__des ul li{ text-align: left; }
  .customstyle{{ section.id }} .adv-banner-slide__button{ margin-top: 30px; }

  /* content reveal on the active slide */
  .customstyle{{ section.id }} .adv-banner-slider.slick-initialized .adv-banner-slide__content > *{
    opacity: 0;
    transform: translateY(24px);
    transition: opacity .6s ease, transform .6s ease;
  }
  .customstyle{{ section.id }} .adv-banner-slider.slick-initialized .adv-banner-slide__content > :nth-child(2){ transition-delay: .1s; }
  .customstyle{{ section.id }} .adv-banner-slider.slick-initialized .adv-banner-slide__content > :nth-child(3){ transition-delay: .2s; }
  .customstyle{{ section.id }} .adv-banner-slider.slick-initialized .adv-banner-slide__content > :nth-child(4){ transition-delay: .3s; }
  .customstyle{{ section.id }} .adv-banner-slider.slick-initialized .slick-active .adv-banner-slide__content > *{
    opacity: 1;
    transform: translateY(0);
  }

  /* heights */
  .customstyle{{ section.id }} .adv-banner-slider--desktop-adapt .adv-banner-slide{ height: auto; aspect-ratio: var(--adv-ratio, 16 / 6); }
  .customstyle{{ section.id }} .adv-banner-slider--desktop-450 .adv-banner-slide{ height: 450px; }
  .customstyle{{ section.id }} .adv-banner-slider--desktop-550 .adv-banner-slide{ height: 550px; }
  .customstyle{{ section.id }} .adv-banner-slider--desktop-650 .adv-banner-slide{ height: 650px; }
  .customstyle{{ section.id }} .adv-banner-slider--desktop-750 .adv-banner-slide{ height: 750px; }
  .customstyle{{ section.id }} .adv-banner-slider--desktop-full .adv-banner-slide{ height: calc(100vh - var(--height-announbar, 0px) - var(--height-header, 0px)); }

  /* arrows */
  .customstyle{{ section.id }} .adv-banner-slider .slick-arrow{
    top: 50%;
    width: 48px;
    height: 48px;
    background: var(--adv-arrow-bg);
    box-shadow: none;
    z-index: 5;
    opacity: 1;
  }
  .customstyle{{ section.id }} .adv-banner-slider .slick-arrow:before{
    color: var(--adv-arrow-color);
    font-size: 16px;
  }
  .customstyle{{ section.id }} .adv-banner-slider .slick-arrow.slick-disabled{ opacity: .35; }
  .customstyle{{ section.id }} .adv-banner-slider .slick-prev{ left: 24px; right: auto; }
  .customstyle{{ section.id }} .adv-banner-slider .slick-next{ right: 24px; left: auto; }
  [dir="rtl"] .customstyle{{ section.id }} .adv-banner-slider .slick-prev{ left: auto; right: 24px; }
  [dir="rtl"] .customstyle{{ section.id }} .adv-banner-slider .slick-next{ right: auto; left: 24px; }

  /* dots */
  .customstyle{{ section.id }} .adv-banner-slider .slick-dots{
    position: absolute;
    left: 0;
    right: 0;
    bottom: 20px;
    z-index: 5;
    margin: 0;
    line-height: 0;
  }
  .customstyle{{ section.id }} .adv-banner-slider .slick-dots li button{ background: rgba(var(--adv-dot-rgb), .55); }
  .customstyle{{ section.id }} .adv-banner-slider .slick-dots li button::before{ border-color: rgb(var(--adv-dot-rgb)); }
  .customstyle{{ section.id }} .adv-banner-slider .slick-dots li.slick-active button,
  .customstyle{{ section.id }} .adv-banner-slider .slick-dots li:hover button{ background: rgb(var(--adv-dot-rgb)); }

  @media (max-width: 767px){
    .customstyle{{ section.id }} .adv-banner-slider--mobile-adapt .adv-banner-slide{ height: auto; aspect-ratio: var(--adv-ratio-mobile, var(--adv-ratio, 4 / 5)); }
    .customstyle{{ section.id }} .adv-banner-slider--mobile-300 .adv-banner-slide{ height: 300px; aspect-ratio: auto; }
    .customstyle{{ section.id }} .adv-banner-slider--mobile-400 .adv-banner-slide{ height: 400px; aspect-ratio: auto; }
    .customstyle{{ section.id }} .adv-banner-slider--mobile-500 .adv-banner-slide{ height: 500px; aspect-ratio: auto; }
    .customstyle{{ section.id }} .adv-banner-slider--mobile-full .adv-banner-slide{ height: 100vh; aspect-ratio: auto; }
    .customstyle{{ section.id }} .adv-banner-slide__inner{ padding: 30px 20px; }
    .customstyle{{ section.id }} .adv-banner-slide__button{ margin-top: 20px; }
    .customstyle{{ section.id }} .adv-banner-slider .slick-dots{ bottom: 12px; }
    {%- unless section.settings.slider_arrows_mobile -%}
    .customstyle{{ section.id }} .adv-banner-slider .slick-arrow{ display: none !important; }
    {%- endunless -%}
  }
  {%- endif -%}
</style>
<section class="customstyle{{ section.id }} lazyload {{ section.settings.text_color }}"
    data-bgset="{% render 'bgset', image: section.settings.image_bg %}"
    data-sizes="auto"
    data-parent-fit="cover" 
   data-section-id="{{ section.id }}" >
  {%- render 'style-section' -%}
  <div class="{{ section.settings.setwidth }}">
    <div class="section-block">
      {%- render 'section-heading' -%}
      {%- if slide_count > 0 -%}
        <div class="adv-banner-slider-wrapper" role="region" aria-roledescription="carousel" aria-label="{{ section.settings.title | default: 'Banner slider' | strip_html | escape }}">
          <div id="AdvBannerSlider-{{ section.id }}"
               class="adv-banner-slider adv-banner-slider--desktop-{{ slider_height }} adv-banner-slider--mobile-{{ slider_height_mobile }}"
               data-autoplay="{{ section.settings.slider_autoplay }}"
               data-speed="{{ section.settings.slider_speed | default: 5 | times: 1000 }}"
               data-pause-hover="{{ section.settings.slider_pause_hover }}"
               data-infinite="{{ section.settings.slider_infinite }}"
               data-transition="{{ section.settings.slider_transition | default: 'fade' }}"
               data-arrows="{{ section.settings.slider_arrows }}"
               data-dots="{{ section.settings.slider_dots }}"
               data-adaptive="{% if slider_height == 'adapt' or slider_height_mobile == 'adapt' %}true{% else %}false{% endif %}">
            {%- for block in slide_blocks -%}
              {%- liquid
                assign slide_image = block.settings.image
                assign slide_image_mobile = block.settings.image_mobile
                assign slide_alt = slide_image.alt | default: block.settings.title | strip_html
                case block.settings.vertical
                  when 'top'
                    assign v_align = 'start'
                  when 'bottom'
                    assign v_align = 'end'
                  else
                    assign v_align = 'center'
                endcase
                case block.settings.horizontal
                  when 'left'
                    assign h_align = 'start'
                  when 'right'
                    assign h_align = 'end'
                  else
                    assign h_align = 'center'
                endcase
                case block.settings.title_size
                  when 'h2'
                    assign title_class = 'h2'
                  when 'h3'
                    assign title_class = 'h3'
                  else
                    assign title_class = 'section-title-1'
                endcase
                assign overlay = block.settings.overlay_color | default: '#000000'
                assign overlay_alpha = block.settings.overlay_opacity | default: 0 | divided_by: 100.0
              -%}
              <div class="adv-banner-slide adv-banner-slide--{{ block.id }}"
                   style="--adv-img-pos: {{ block.settings.image_position | default: 'center center' }};{% if slide_image != blank %} --adv-ratio: {{ slide_image.aspect_ratio }};{% endif %}{% if slide_image_mobile != blank %} --adv-ratio-mobile: {{ slide_image_mobile.aspect_ratio }};{% endif %}"
                   {{ block.shopify_attributes }}>
                <div class="adv-banner-slide__media">
                  {%- if slide_image != blank -%}
                    {%- capture desktop_img_class -%}adv-banner-slide__img{% if slide_image_mobile != blank %} d-none d-md-block{% endif %}{%- endcapture -%}
                    {%- if forloop.first and slide_image_mobile == blank -%}
                      {{ slide_image | image_url: width: 1920 | image_tag: widths: '750, 1000, 1280, 1500, 1920, 2560', sizes: '100vw', loading: 'eager', fetchpriority: 'high', preload: true, alt: slide_alt, class: desktop_img_class }}
                    {%- elsif forloop.first -%}
                      {{ slide_image | image_url: width: 1920 | image_tag: widths: '750, 1000, 1280, 1500, 1920, 2560', sizes: '100vw', loading: 'eager', fetchpriority: 'high', alt: slide_alt, class: desktop_img_class }}
                    {%- else -%}
                      {{ slide_image | image_url: width: 1920 | image_tag: widths: '750, 1000, 1280, 1500, 1920, 2560', sizes: '100vw', loading: 'lazy', alt: slide_alt, class: desktop_img_class }}
                    {%- endif -%}
                    {%- if slide_image_mobile != blank -%}
                      {{ slide_image_mobile | image_url: width: 1200 | image_tag: widths: '375, 500, 750, 1000, 1200', sizes: '100vw', loading: 'lazy', alt: slide_alt, class: 'adv-banner-slide__img d-md-none' }}
                    {%- endif -%}
                  {%- else -%}
                    {%- capture placeholder_index -%}{%- cycle 1, 2 -%}{%- endcapture -%}
                    {{ 'lifestyle-' | append: placeholder_index | placeholder_svg_tag: 'placeholder-svg' }}
                  {%- endif -%}
                  {%- if block.settings.show_overlay -%}
                    <div class="adv-banner-slide__overlay" style="background-color: rgba({{ overlay.red }}, {{ overlay.green }}, {{ overlay.blue }}, {{ overlay_alpha }});"></div>
                  {%- endif -%}
                </div>
                {%- if block.settings.slide_link != blank -%}
                  <a class="adv-banner-slide__link" href="{{ block.settings.slide_link }}" aria-label="{{ block.settings.title | default: 'View banner' | strip_html | escape }}"></a>
                {%- endif -%}
                <div class="adv-banner-slide__inner d-flex align-items-{{ v_align }} justify-content-{{ h_align }}">
                  <div class="adv-banner-slide__content text-{{ block.settings.text_align | default: 'center' }}">
                    {%- if block.settings.sub != blank -%}
                      <div class="adv-banner-slide__sub subtop" style="color: {{ block.settings.color_sub }};">{{ block.settings.sub }}</div>
                    {%- endif -%}
                    {%- if block.settings.title != blank -%}
                      <h2 class="adv-banner-slide__title {{ title_class }}" style="color: {{ block.settings.color_title }};">{{ block.settings.title }}</h2>
                    {%- endif -%}
                    {%- if block.settings.code != blank -%}
                      <div class="adv-banner-slide__des" style="color: {{ block.settings.color_des }};">{{ block.settings.code }}</div>
                    {%- endif -%}
                    {%- if block.settings.button_text != blank -%}
                      <div class="adv-banner-slide__button">
                        <a href="{{ block.settings.link_button | default: '#' }}" class="btn {{ block.settings.button_style | default: 'btn-theme' }}">{{ block.settings.button_text }}{% render 'icon-button-base' %}</a>
                      </div>
                    {%- endif -%}
                  </div>
                </div>
              </div>
            {%- endfor -%}
          </div>
        </div>
      {%- endif -%}
      {%- if grid_block_count > 0 -%}
      <div class="row {% unless section.settings.padding %} m-0{% endunless %} {% if section.settings.col_center %} justify-content-center {% endif %}">
        {%- for block in section.blocks -%}
          {%- if block.type == 'slide' -%}{%- continue -%}{%- endif -%}
          {%- liquid
            case block.settings.width 
            when 'auto' 
              assign block_width = 'col-lg col-12' 
            when '20%' 
              assign block_width = 'col-1-5 col-md-6 col-sm-6 col-12' 
            when '25%' 
              assign block_width = 'col-lg-3 col-md-6 ' 
            when '33%' 
              assign block_width = 'col-lg-4 col-md-6 ' 
            when '41%' 
              assign block_width = 'col-lg-5 col-md-12 ' 
            when '50%' 
              assign block_width = 'col-lg-6 ' 
            when '58%' 
              assign block_width = 'col-lg-7 col-md-12 ' 
            when '66%' 
              assign block_width = 'col-lg-8 col-md-12 ' 
            when '75%' 
              assign block_width = 'col-lg-9 col-md-12 ' 
            when '100%' 
              assign block_width = 'col-12 ' 
          endcase 
          -%}
          <div id="block-{{ block.id }}" class="{{ block_width }} {% if block.type != 'html' %}align-self-{{ block.settings.align }}{% endif %} {% unless section.settings.padding %} p-0 mb-0 {% else %} mb-4 mb-lg-0 {% endunless %}" {{ block.shopify_attributes }}>
            <div class="grid__item-inner grid__item-inner--{{ block.type }} {% if block.type == 'html' %}h-100 align-items-{%- if block.settings.align == 'auto' -%}start{%- elsif block.settings.align == 'center' -%}center{%- else -%}end{% endif %} d-flex justify-content-center justify-content-lg-{{ block.settings.box_align }}{% endif %} {% if block.type == 'image' %}h-100{% endif %}">
              {%- case block.type -%}
                {%- when 'html' -%}
                  <style>
                      {% if block.settings.bg_block != blank %}
                        #block-{{ block.id }}{
                          background-position: center center;
                          background-size:cover;
                          background-repeat:no-repeat;
                          background-image:url({{ block.settings.bg_block | image_url: width: 1920 }});
                        }
                      {% endif %}
                      #block-{{ block.id }} .advand-html-content{
                        width: 100%;
                        max-width: ;
                      }
                      #block-{{ block.id }} .advand-html-image-sub{
                        margin-bottom: 20px;
                        max-width: 100%;
                      }
                      #block-{{ block.id }} .advand-html-image-sub img{
                        max-width: 55%;
                      }
                      #block-{{ block.id }} .advand-html-button{
                        margin-top: 35px;
                      }
                      @media (min-width:1200px) {
                        #block-{{ block.id }} .pr-custom .pr-custom{
                          padding-right: 15%;
                        }
                      }
                  </style>
                  <div data-aos="{{ section.settings.animation }}" class="advand-html d-flex justify-content-center justify-content-lg-{{ block.settings.box_align }}" data-aos-duration="500">
                    <div class="advand-html-content text-center text-lg-{{ block.settings.text_align }}">
                      {% if block.settings.image_sub != blank %}
                      <div class="advand-html-image-sub">
                        <img src="{{ block.settings.image_sub | image_url: width: 1920 }}" width="auto" height="auto" loading="lazy" alt="">
                      </div>
                      {% endif %}
                      {% if block.settings.sub != blank %}
                        <div class="advand-html-sub subtop" style="color:{{ block.settings.color_sub }};">{{ block.settings.sub }}</div>
                      {% endif %}
                      {% if block.settings.title != blank %}
                        <div class="advand-html-title mb-4 section-title-1" style="color:{{ block.settings.color_title }};">{{ block.settings.title }}</div>
                      {% endif %}
                      
                      {% if block.settings.code != blank %}
                        <div class="advand-html-des" style="color:{{ block.settings.color_des }};">{{ block.settings.code }}</div>
                      {% endif %}
                      {% if block.settings.button_text != blank %}
                        <div class="advand-html-button">
                          <a href="{{ block.settings.link_button }}" class="btn btn-theme">{{ block.settings.button_text }}{% render 'icon-button-base' %}</a>
                        </div>
                      {% endif %}
                    </div>
                  </div>

                {%- when 'video' -%}

                  {%- if block.settings.cover_image -%}{%- endif -%}

                  {%- if block.settings.show_overlay -%}
                    <style>
                      #VideoSection--{{ section.id }}.video-section__cover-text {
                        color: {{ block.settings.overlay_text }};
                      }

                      #VideoSection--{{ section.id }}.video-section__load-player-button-triangle {
                        border-left-color: {{ block.settings.overlay_text }};
                      }

                      #VideoSection--{{ section.id }}.video-section__load-player-button.animated .video-section__load-player-button-circle, #VideoSection--{{ section.id }}.video-section__load-player-button-circle {
                        border-color: {{ block.settings.overlay_text }};
                      }

                      #VideoSection--{{ section.id }} .video-section__cover-overlay {
                        background-color: {{ block.settings.overlay_color }};
                        opacity: {{ block.settings.overlay_opacity | divided_by: 100.0 }};
                      }
                    </style>
                  {%- endif -%}

                  <div id="VideoSection--{{ section.id }}" class="video-section video-section--{{ block.settings.cover_image_height }}" 
                    data-section-id="{{ section.id }}" 
                    data-section-type="video" 
                    data-video-id="{{ block.settings.video_url.id }}" 
                    data-video-type="{{ block.settings.video_url.type }}"
                    data-aos="{{ section.settings.animation }}" data-aos-delay="{{ forloop.index | times: 100 }}">
                    <div class="video-section__body-overlay"></div>
                    <div class="video-section__modal">
                      <div class="video-wrapper modal-header ">
                        <button class="video-section__player-close close">
                          <span class="visually-hidden">{{ 'video.close' | t }}
                          </span>
                          {%- render 'icon-close' -%}
                        </button>
                        <div class="video-section__player"></div>
                      </div>
                    </div>
                    <div class="video-section__cover">
                      <div class="video-section__cover-background">
                        {%- if block.settings.cover_image == blank -%}
                          {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
                        {%- else -%}
                          <div class="position-relative image-content__image-wrapper " style="padding-top:{{ 1 | divided_by: block.settings.cover_image.aspect_ratio | times: 100 }}%;">
                            {% assign img_url = block.settings.cover_image | image_url: width: 1 | replace: 'width=1', 'width={width}' %}
                            <img class="image-content__image lazyload scale-in" src="{{ block.settings.cover_image | image_url: width: 1920 }}" data-src="{{ img_url }}" data-widths="[180, 360, 540, 720, 900, 1080, 1296, 1512, 1728, 1944, 2048]" data-aspectratio="{{ block.settings.cover_image.aspect_ratio }}" data-sizes="auto" alt="{{ block.settings.cover_image.alt | escape }}" loading="lazy" width="{{ block.settings.cover_image.width }}" height="{{ block.settings.cover_image.height }}">

                          </div>
                        {%- endif -%}
                      </div>
                      <div class="video-section__cover-overlay"></div>
                      <div class="video-section__cover-content">
                        <button class="video-section__load-player-button video-section__load-player-button--large">
                          <span class="visually-hidden">{{ 'video.play' | t }}
                          </span>
                          <svg xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" version="1.1" viewBox="0 0 120 120" class="video-text">
                            <defs>
                            <path d="M 60, 60 m -60, 0 a 60,60 0 0,1 120,0 a 60,60 0 0,1 -120,0" id="txt-path"></path>
                            </defs>
                            <text>
                            <textPath startOffset="0" xlink:href="#txt-path"> {{ block.settings.text_circle }}</textPath>
                            </text>
                            </svg>
                          <div class="video-section__load-player-icon">
                            <div class="video-section__load-player-mark"></div>
                            <div class="video-section__load-player-button-circle"></div>
                            <div class="video-section__load-player-button-triangle"></div>
                          </div>
                        </button>
                        <p class="video-section__error"></p>
                      </div>
                    </div>
                  </div>

                {%- when 'image' -%}

                  <style>
                    .block-image-{{ block.id }}{
                      --o-width-image : {{ block.settings.width_image }}%;
                      width:var(--o-width-image);
                      margin:0 auto;
                    }
                    .advand-image-logo{
                      position: absolute;
                      top: 10%;
                      left: 0;
                      width: auto;
                      max-width: 40%;
                    }
                    .advand-image .block-image-{{ block.id }} img{
                      height: 100%;
                      max-width: unset;
      
                      object-fit: cover;
                      object-position: center;
                    }
                    .advand-image .block-image-{{ block.id }} {
                      overflow: hidden;
                    }
                    
                  </style>

                  <div class="advand-image position-relative h-100 {% if block.settings.padding-left %} pl-lg-5 {% endif %}{% if block.settings.padding-right %} pr-lg-5 {% endif %}" 
                    data-aos="{{ section.settings.animation }}" data-aos-delay="{{ forloop.index | times: 200 }}">
                  
                    {%- if block.settings.enable_top == true -%}
                      {%- if block.settings.code != blank -%}
                        <div class="position-relative">
                          {{ block.settings.code }}
                        </div>
                      {%- endif -%}
                    {%- endif -%}
                    <div class="h-100 block-image image-content__image-container block-image-{{ block.id }}">
                        {%- if block.settings.image != blank -%}
                          <a href="{{ block.settings.image_link }}" class="h-100 d-flex justify-content-center block-image-main" >
                            {% assign img_url = block.settings.image | image_url: width: 1 | replace: 'width=1', 'width={width}' %}
                            <img src="{{ block.settings.image | image_url: width: 1, height: 1 }}" 
                              class="lazyload scale-in {% if block.settings.width_image != 100 %}w-100{% endif %}" 
                              data-src="{{ img_url }}" 
                              data-widths="[180, 360, 540, 720, 900, 1080, 1296, 1512, 1728, 1944, 2048]"
                              data-aspectratio="{{ block.settings.image.aspect_ratio }}"
                              data-sizes="auto"
                              loading="lazy"
                              width="{{ block.settings.image.width }}"
                              height="{{ block.settings.image.height }}" />
                          </a>
                        {%- else -%}
                          {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
                        {%- endif -%}

                        

                      {%- if block.settings.enable_top == false -%}
                        {%- if block.settings.code != blank -%}
                          <div class="position-relative">
                            {{ block.settings.code }}
                          </div>
                        {%- endif -%}
                      {%- endif -%}
                      
                    </div>
                    {% if block.settings.image_logo != blank %}
                      <div class="advand-image-logo">
                        <img src="{{ block.settings.image_logo | image_url: width: 1920 }}" width="auto" height="auto" loading="lazy" alt="">
                      </div>
                    {% endif %}
                  </div>
                {%- when 'productcustom' -%}
                  <div data-aos="{{ section.settings.animation }}" data-aos-delay="{{ forloop.index | times: 200 }}">
                    {%- assign productLookbook = all_products[block.settings.product] -%}
                    {%- if productLookbook != blank -%}
                      {%- render 'product-card', product: productLookbook -%}
                    {%- else -%}
                      {%- render 'product-grid-blank' -%}
                    {%- endif -%}
                  </div>
                {%- when 'productlist' -%}
                  <div class="{% if forloop.last == true %} mb-0 {% else %} mb-5 mb-lg-0 {% endif %}" data-aos="{{ section.settings.animation }}" data-aos-delay="{{ forloop.index | times: 200 }}">
                    {%- assign collection = collections[block.settings.mini_collection] -%}
                    {%- if collection != blank -%}
                      {%- if block.settings.title != blank -%}
                        <h4 class="mb-2">
                          {{ block.settings.title }}
                        </h4>
                      {%- endif -%}
                      {%- for product in collection.products limit: block.settings.limit_product -%}
                        <div class="media adv-productlist py-4 {% unless forloop.last %}border-bottom {% endunless %}" style="border-bottom-color: {{ block.settings.p_border }}!important;">
                          <a href="{{ product.url | within: collection }}"><img class="mr-3 lazyload adv-img" 
                            data-src="{{ product.featured_image | image_url: width: 150 }}" 
                            src="{{ product.featured_image | image_url: width: 1, height: 1 }}"
                            loading="lazy"
                            width="{{ product.featured_image.width }}"
                            height="{{ product.featured_image.height }}"></a>
                          <div class="media-body">
                            <a href="{{ product.url | within: collection }}" title="{{ product.title }}" class="h6 mb-2 d-block">{{ product.title }}
                            </a>
                            {%- if product.available -%}
                              <div class="product-card__price">
                                {%- if product.compare_at_price > product.price -%}
                                  {%- if product.price_varies -%}
                                    {%- assign sale_price = product.price | money -%}
                                    {{ 'products.product.on_sale_from_html' | t: price: sale_price }}
                                  {%- else -%}
                                    <span class="visually-hidden">{{ 'products.product.regular_price' | t }}
                                    </span>
                                    <s class="product-card__regular-price">{{ product.compare_at_price | money }}
                                    </s>
                                    <span class="visually-hidden">{{ 'products.product.sale_price' | t }}
                                    </span>
                                    {{ product.price | money }}
                                  {%- endif -%}
                                {%- else -%}
                                  {%- if product.price_varies -%}
                                    {%- assign price = product.price | money -%}
                                    {{ 'products.product.from_text_html' | t: price: price }}
                                  {%- else -%}
                                    <span class="visually-hidden">{{ 'products.product.regular_price' | t }}
                                    </span>
                                    {{ product.price | money }}
                                  {%- endif -%}
                                {%- endif -%}
                              </div>
                            {%- else -%}
                              <div class="product-card__availability">
                                {{ 'products.product.sold_out' | t }}
                              </div>
                            {%- endif -%}
                          </div>
                        </div>
                      {%- endfor -%}
                    </div>
                  {%- else -%}
                    <h4 class="mb-2">
                      Collection title
                    </h4>
                    {%- assign limit =  block.settings.limit_product -%}
                    {%- for i in (1..limit) -%}
                      <div class="media py-4 {% unless forloop.last %}border-bottom{% endunless %}">
                        <div class="mr-3 border">
                          {%- capture current -%}
                            {%- cycle 1, 2, 3, 4, 5, 6 -%}
                          {%- endcapture -%}
                          <div style="width: 74px;">
                            {{ 'product-' | append: current | placeholder_svg_tag: 'placeholder-svg' }}
                          </div>
                        </div>
                        <div class="media-body">
                          <div class="product-card__name">{{ 'homepage.onboarding.product_title' | t }}
                          </div>
                          <div class="product-card__price">
                            {%- cycle '$19.99', '$28.37', '$33.22', '$41.56', '$55.21', '$62.98' -%}
                          </div>
                        </div>
                      </div>
                    {%- endfor -%}
                  {%- endif -%}
                {%- when 'bgvideo' -%}
                  {% if block.settings.link_video != blank %}
                    <div class="video-section video-section--{{ block.settings.cover_bg_video }} " data-aos="{{ section.settings.animation }}" data-aos-delay="{{ forloop.index | times: 200 }}">
                      <div class="htmlhero-video ">
                        <video id="Mp4{{ block.id }}" src="{{ block.settings.link_video }}" loop="" muted="" playsinline="" autoplay=""></video>
                      </div>
                    </div>
                  {% else if %}
                    <div class="hero-video">
                      {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
                    </div>
                  {% endif %}
                  {%- when 'promo' -%}
                    {%- liquid
                      assign promo_banner_height = block.settings.promo_banner_height
                      assign image = block.settings.image
                      assign promo_subheading = block.settings.promo_subheading
                      assign promo_heading = block.settings.promo_heading
                      assign promo_size_title = block.settings.promo_size_title
                      assign promo_paragraph = block.settings.promo_paragraph
                      assign promo_btn = block.settings.promo_btn
                      assign promo_link = block.settings.promo_link
                      assign promo_color = block.settings.promo_color

                      assign promo_position = block.settings.promo_position
                      case promo_position
                      when 'top-left'
                        assign positiontxt = 'align-items-start justify-content-start'
                        when 'top-center'
                        assign positiontxt = 'align-items-start justify-content-center text-center'
                        when 'top-right'
                        assign positiontxt = 'align-items-start justify-content-end text-right'
                        when 'mid-left'
                        assign positiontxt = 'align-items-center justify-content-start'
                        when 'mid-center'
                        assign positiontxt = 'align-items-center justify-content-center text-center'
                        when 'mid-right'
                        assign positiontxt = 'align-items-center justify-content-end text-right'
                        when 'bot-left'
                        assign positiontxt = 'align-items-end justify-content-start'
                        when 'bot-center'
                        assign positiontxt = 'align-items-end justify-content-center text-center'
                        when 'bot-right'
                        assign positiontxt = 'align-items-end justify-content-end text-right'
                        else 
                        assign positiontxt = 'align-items-end justify-content-start'
                      endcase
                    -%}
                    <div class="{% if block.settings.padding-left %} pl-lg-5 {% endif %}{% if block.settings.padding-right %} pr-lg-5 {% endif %}" 
                      data-aos="{{ section.settings.animation }}" data-aos-delay="{{ forloop.index | times: 100 }}">
                      <div class=" {% if block.settings.sub_title_block != blank  or block.settings.title_block != blank %} mb-5 {% endif %} d-flex  flex-column text-lg-left text-center">
                        {%- if block.settings.sub_title_block != blank -%}
                          <span class="subtop">{{ block.settings.sub_title_block }} </span>
                        {%- endif -%}
                        {%- if block.settings.title_block != blank -%}
                        <h3 class="py-2">{{ block.settings.title_block }}</h3>
                      {%- endif -%}
                        </div>
                    <div class="image-content__image-container overflow-hidden promo-advanced">
                      <div class="image-content__image-wrapper" style="height:{{ promo_banner_height }}px;">
                        {%- if image != blank -%}
                          {% assign img_url = image | image_url: width: 1 | replace: 'width=1', 'width={width}' %}
                          <img class="image-content__image lazyload scale-in"
                              src="{{ image | image_url: width: 1, height: 1 }}"
                              data-src="{{ img_url }}"
                              data-widths="[180, 360, 540, 720, 900, 1080, 1296, 1512, 1728, 1944, 2048]"
                              data-aspectratio="{{ image.aspect_ratio }}"
                              data-sizes="auto"
                              alt="{{ image.alt | escape }}"
                              loading="lazy"
                              width="{{ image.width }}"
                              height="{{ image.height }}">
                        {%- else -%}
                          <div class="image-content__image">
                            {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
                          </div>
                        {%- endif -%}
                          
                      </div>
                      <div class="position-absolute promo_advance-content d-flex {{ positiontxt }}" style="--g-font-color-subtop:{{ promo_color }}; --g-color-heading:{{ promo_color }}; --color-body-text: {{ promo_color }}">
                          <a class="promo_advance--link position-absolute" href="{{ promo_link }}" ></a>
                          <div class="position-relative promotion_menu--txt">
                              {%- if promo_subheading != blank -%}
                                  <div class="subtop mb-1"> {{ promo_subheading }}</div>
                              {%- endif -%}
                              {%- if promo_heading != blank -%}
                                  <div class="{{ promo_size_title }} mb-3"> {{ promo_heading }}</div>
                              {%- endif -%}
                              {%- if promo_paragraph != blank -%}
                                  <div class="mb-3" > {{ promo_paragraph }}</div>
                              {%- endif -%}
                              {%- if promo_btn != blank -%}
                                  <a class="link" href="{{ promo_link }}"> {{ promo_btn }}</a>
                              {%- endif -%}
                          </div>
                      </div>
                  </div>
                </div>
              {%- endcase -%}
            </div>
          </div>
        {%- endfor -%}
      </div>
      {%- endif -%}
    </div>
  </div>
</section>

{%- if slide_count > 0 -%}
<script>
  (function () {
    var SECTION_ID = '{{ section.id }}';
    var SLIDER_SELECTOR = '#AdvBannerSlider-' + SECTION_ID;

    function slickReady() {
      return !!(window.jQuery && jQuery.fn && jQuery.fn.slick);
    }

    function findSlider(context) {
      var root = context && context.querySelector ? context : document;
      return root.querySelector(SLIDER_SELECTOR);
    }

    function stripEditorAttrsFromClones(event, slick) {
      // Cloned slides (infinite mode) must not be selectable in the theme editor
      slick.$slider.find('.slick-cloned').removeAttr('data-shopify-editor-block');
    }

    function initBannerSlider(context) {
      if (!slickReady()) return;
      var el = findSlider(context);
      if (!el) return;
      var $slider = jQuery(el);
      if ($slider.hasClass('slick-initialized')) return;

      var d = el.dataset;
      var isFade = d.transition === 'fade';

      $slider.on('init reInit', stripEditorAttrsFromClones);
      $slider.slick({
        rtl: !!(window.theme && window.theme.rtl === true),
        slidesToShow: 1,
        slidesToScroll: 1,
        arrows: d.arrows === 'true',
        dots: d.dots === 'true',
        infinite: d.infinite === 'true',
        fade: isFade,
        cssEase: isFade ? 'ease' : 'cubic-bezier(0.4, 0, 0.2, 1)',
        speed: 700,
        autoplay: d.autoplay === 'true',
        autoplaySpeed: parseInt(d.speed, 10) || 5000,
        pauseOnHover: d.pauseHover === 'true',
        pauseOnFocus: false,
        pauseOnDotsHover: false,
        draggable: true,
        swipe: true,
        touchThreshold: 20,
        adaptiveHeight: d.adaptive === 'true',
        accessibility: true,
        waitForAnimate: true
      });
    }

    function destroyBannerSlider(context) {
      if (!slickReady()) return;
      var el = findSlider(context);
      if (!el) return;
      var $slider = jQuery(el);
      if ($slider.hasClass('slick-initialized')) {
        $slider.slick('unslick');
      }
    }

    // vendor.js / theme.js are deferred, so jQuery + slick are available once DOMContentLoaded fires.
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', function () { initBannerSlider(document); });
    } else {
      initBannerSlider(document);
    }

    // Theme editor hooks. This script re-runs on every section reload, so register them only once.
    if (!window.Shopify || !window.Shopify.designMode) return;
    window.advBannerSliderHooks = window.advBannerSliderHooks || {};
    if (window.advBannerSliderHooks[SECTION_ID]) return;
    window.advBannerSliderHooks[SECTION_ID] = true;

    document.addEventListener('shopify:section:load', function (e) {
      if (e.detail && e.detail.sectionId === SECTION_ID) initBannerSlider(e.target);
    });

    document.addEventListener('shopify:section:unload', function (e) {
      if (e.detail && e.detail.sectionId === SECTION_ID) destroyBannerSlider(e.target);
    });

    document.addEventListener('shopify:block:select', function (e) {
      if (!e.detail || e.detail.sectionId !== SECTION_ID || !slickReady()) return;
      var $slider = jQuery(SLIDER_SELECTOR);
      if (!$slider.hasClass('slick-initialized')) return;
      var $slide = $slider.find('.adv-banner-slide--' + e.detail.blockId + ':not(.slick-cloned)');
      if (!$slide.length) return;
      $slider.slick('slickGoTo', $slide.data('slick-index'));
      $slider.slick('slickPause');
    });

    document.addEventListener('shopify:block:deselect', function (e) {
      if (!e.detail || e.detail.sectionId !== SECTION_ID || !slickReady()) return;
      var $slider = jQuery(SLIDER_SELECTOR);
      if (!$slider.hasClass('slick-initialized')) return;
      if ($slider.attr('data-autoplay') === 'true') $slider.slick('slickPlay');
    });
  })();
</script>
{%- endif -%}


