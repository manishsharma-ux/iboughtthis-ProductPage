<!-- marquee-gallery.liquid -->
<style>
  .customstyle{{ section.id }} {
    position: relative;
    z-index: {{ section.settings.zindex | default: 1 }};
    background-color: {{ section.settings.bgsection }};
    background-position: {{ section.settings.e_pos }} !important;
    background-repeat: {{ section.settings.e_repeat }} !important;
    background-size: {{ section.settings.e_size }} !important;
    overflow: hidden;
  }

  /* ===== Marquee Wrapper ===== */
  .marquee-gallery {
    display: flex;
    flex-direction: column;
    gap: {{ section.settings.row_gap }}px;
    padding: {{ section.settings.paddingsection }};
  }

  .marquee-row {
    overflow: hidden;
    width: 100%;
    position: relative;
  }

  /* Pause on hover */
  {% if section.settings.pause_on_hover %}
  .marquee-row:hover .marquee-track {
    animation-play-state: paused;
  }
  {% endif %}

  .marquee-track {
    display: flex;
    width: max-content;
    gap: {{ section.settings.image_gap }}px;
    will-change: transform;
  }

  /* Row 1 & 3 — scroll left */
  .marquee-row--left .marquee-track {
    animation: marquee-left {{ section.settings.speed_row1 }}s linear infinite;
  }

  /* Row 2 — scroll right */
  .marquee-row--right .marquee-track {
    animation: marquee-right {{ section.settings.speed_row2 }}s linear infinite;
  }

  @keyframes marquee-left {
    0%   { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }

  @keyframes marquee-right {
    0%   { transform: translateX(-50%); }
    100% { transform: translateX(0); }
  }

  /* ===== Image Items ===== */
  .marquee-item {
    flex-shrink: 0;
    width: {{ section.settings.image_width }}px;
    height: {{ section.settings.image_height }}px;
    overflow: hidden;
    border-radius: {{ section.settings.image_radius }}px;
  }

  .marquee-item img {
    width: 100%;
    height: 100%;
    object-fit: {{ section.settings.image_fit }};
    object-position: center;
    display: block;
    pointer-events: none;
    user-select: none;
  }

  /* ===== Optional heading ===== */
  .marquee-gallery__heading {
    text-align: {{ section.settings.heading_align }};
    padding: 0 20px {{ section.settings.heading_mb }}px;
  }

  .marquee-gallery__heading h2 {
    font-size: {{ section.settings.heading_size }}px;
    font-weight: {{ section.settings.heading_weight }};
    color: {{ section.settings.heading_color }};
    margin: 0;
    line-height: 1.2;
  }

  .marquee-gallery__subheading {
    font-size: {{ section.settings.subheading_size }}px;
    color: {{ section.settings.subheading_color }};
    margin-top: 8px;
  }

  /* ===== Responsive ===== */
  @media (max-width: 768px) {
    .marquee-gallery {
      padding: {{ section.settings.paddingmobile }};
      gap: {{ section.settings.row_gap_mobile }}px;
    }
    .marquee-item {
      width: {{ section.settings.image_width_mobile }}px;
      height: {{ section.settings.image_height_mobile }}px;
    }
  }
</style>

<section
  class="customstyle{{ section.id }} lazyload"
  data-aos="{{ section.settings.animation }}"
  data-bgset="{% render 'bgset', image: section.settings.image_bg %}"
  data-sizes="auto"
  data-parent-fit="cover"
>
  {%- render 'style-section' -%}

  <div class="marquee-gallery">

    {%- if section.settings.heading != blank -%}
      <div class="marquee-gallery__heading">
        <h2>{{ section.settings.heading }}</h2>
        {%- if section.settings.subheading != blank -%}
          <p class="marquee-gallery__subheading">{{ section.settings.subheading }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- comment -%} Split blocks into 3 rows {%- endcomment -%}
    {%- assign row1_blocks = section.blocks | where: 'type', 'image_row1' -%}
    {%- assign row2_blocks = section.blocks | where: 'type', 'image_row2' -%}
    {%- assign row3_blocks = section.blocks | where: 'type', 'image_row3' -%}

    {%- comment -%} ROW 1 — Left {%- endcomment -%}
    {%- if row1_blocks.size > 0 -%}
    <div class="marquee-row marquee-row--left">
      <div class="marquee-track" aria-hidden="true">
        {%- comment -%} Duplicate for seamless loop {%- endcomment -%}
        {%- for i in (1..2) -%}
          {%- for block in row1_blocks -%}
            {%- if block.settings.image != blank -%}
            <div class="marquee-item" {{ block.shopify_attributes }}>
              {%- assign img_url = block.settings.image | image_url: width: 1 | replace: 'width=1', 'width={width}' -%}
              <img
                class="lazyload"
                src="{{ block.settings.image | image_url: width: 20 }}"
                data-src="{{ img_url }}"
                data-widths="[200, 300, 400, 500, 600]"
                data-sizes="auto"
                loading="lazy"
                alt="{{ block.settings.image.alt | default: 'Gallery image' }}"
              >
            </div>
            {%- endif -%}
          {%- endfor -%}
        {%- endfor -%}
      </div>
    </div>
    {%- endif -%}

    {%- comment -%} ROW 2 — Right {%- endcomment -%}
    {%- if row2_blocks.size > 0 -%}
    <div class="marquee-row marquee-row--right">
      <div class="marquee-track" aria-hidden="true">
        {%- for i in (1..2) -%}
          {%- for block in row2_blocks -%}
            {%- if block.settings.image != blank -%}
            <div class="marquee-item" {{ block.shopify_attributes }}>
              {%- assign img_url = block.settings.image | image_url: width: 1 | replace: 'width=1', 'width={width}' -%}
              <img
                class="lazyload"
                src="{{ block.settings.image | image_url: width: 20 }}"
                data-src="{{ img_url }}"
                data-widths="[200, 300, 400, 500, 600]"
                data-sizes="auto"
                loading="lazy"
                alt="{{ block.settings.image.alt | default: 'Gallery image' }}"
              >
            </div>
            {%- endif -%}
          {%- endfor -%}
        {%- endfor -%}
      </div>
    </div>
    {%- endif -%}

    {%- comment -%} ROW 3 — Left {%- endcomment -%}
    {%- if row3_blocks.size > 0 -%}
    <div class="marquee-row marquee-row--left">
      <div class="marquee-track" aria-hidden="true">
        {%- for i in (1..2) -%}
          {%- for block in row3_blocks -%}
            {%- if block.settings.image != blank -%}
            <div class="marquee-item" {{ block.shopify_attributes }}>
              {%- assign img_url = block.settings.image | image_url: width: 1 | replace: 'width=1', 'width={width}' -%}
              <img
                class="lazyload"
                src="{{ block.settings.image | image_url: width: 20 }}"
                data-src="{{ img_url }}"
                data-widths="[200, 300, 400, 500, 600]"
                data-sizes="auto"
                loading="lazy"
                alt="{{ block.settings.image.alt | default: 'Gallery image' }}"
              >
            </div>
            {%- endif -%}
          {%- endfor -%}
        {%- endfor -%}
      </div>
    </div>
    {%- endif -%}

  </div>
</section>

{% schema %}
{
  "name": "Marquee Gallery",
  "class": "index-section",
  "settings": [
    {
      "type": "header",
      "content": "Animation"
    },
    {
      "type": "select",
      "id": "animation",
      "label": "Section Entry Animation",
      "options": [
        { "value": "", "label": "None" },
        { "value": "fade", "label": "Fade" },
        { "value": "fade-up", "label": "Fade Up" },
        { "value": "zoom-in", "label": "Zoom In" }
      ]
    },
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Heading"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Sub Heading"
    },
    {
      "type": "select",
      "id": "heading_align",
      "label": "Heading Alignment",
      "default": "center",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ]
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading Font Size (px)",
      "min": 16,
      "max": 72,
      "step": 2,
      "default": 32
    },
    {
      "type": "select",
      "id": "heading_weight",
      "label": "Heading Font Weight",
      "default": "700",
      "options": [
        { "value": "400", "label": "Normal" },
        { "value": "600", "label": "Semi Bold" },
        { "value": "700", "label": "Bold" },
        { "value": "800", "label": "Extra Bold" }
      ]
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#1a1a1a"
    },
    {
      "type": "range",
      "id": "subheading_size",
      "label": "Subheading Font Size (px)",
      "min": 10,
      "max": 28,
      "step": 1,
      "default": 16
    },
    {
      "type": "color",
      "id": "subheading_color",
      "label": "Subheading Color",
      "default": "#555555"
    },
    {
      "type": "range",
      "id": "heading_mb",
      "label": "Heading Bottom Gap (px)",
      "min": 0,
      "max": 80,
      "step": 4,
      "default": 24
    },
    {
      "type": "header",
      "content": "Scroll Speed"
    },
    {
      "type": "range",
      "id": "speed_row1",
      "label": "Row 1 Speed (seconds per loop)",
      "min": 5,
      "max": 120,
      "step": 5,
      "default": 35,
      "info": "Lower = faster"
    },
    {
      "type": "range",
      "id": "speed_row2",
      "label": "Row 2 Speed (seconds per loop)",
      "min": 5,
      "max": 120,
      "step": 5,
      "default": 40,
      "info": "Lower = faster"
    },
    {
      "type": "checkbox",
      "id": "pause_on_hover",
      "label": "Pause on Hover",
      "default": true
    },
    {
      "type": "header",
      "content": "Image Size (Desktop)"
    },
    {
      "type": "range",
      "id": "image_width",
      "label": "Image Width (px)",
      "min": 100,
      "max": 600,
      "step": 10,
      "default": 280
    },
    {
      "type": "range",
      "id": "image_height",
      "label": "Image Height (px)",
      "min": 80,
      "max": 600,
      "step": 10,
      "default": 200
    },
    {
      "type": "range",
      "id": "image_gap",
      "label": "Gap Between Images (px)",
      "min": 0,
      "max": 40,
      "step": 2,
      "default": 6
    },
    {
      "type": "range",
      "id": "row_gap",
      "label": "Gap Between Rows (px)",
      "min": 0,
      "max": 40,
      "step": 2,
      "default": 6
    },
    {
      "type": "range",
      "id": "image_radius",
      "label": "Image Border Radius (px)",
      "min": 0,
      "max": 30,
      "step": 2,
      "default": 0
    },
    {
      "type": "select",
      "id": "image_fit",
      "label": "Image Fit",
      "default": "cover",
      "options": [
        { "value": "cover", "label": "Cover" },
        { "value": "contain", "label": "Contain" }
      ]
    },
    {
      "type": "header",
      "content": "Image Size (Mobile)"
    },
    {
      "type": "range",
      "id": "image_width_mobile",
      "label": "Image Width Mobile (px)",
      "min": 80,
      "max": 300,
      "step": 10,
      "default": 160
    },
    {
      "type": "range",
      "id": "image_height_mobile",
      "label": "Image Height Mobile (px)",
      "min": 60,
      "max": 300,
      "step": 10,
      "default": 120
    },
    {
      "type": "range",
      "id": "row_gap_mobile",
      "label": "Row Gap Mobile (px)",
      "min": 0,
      "max": 20,
      "step": 2,
      "default": 4
    },
    {
      "type": "header",
      "content": "Background"
    },
    {
      "type": "color",
      "id": "bgsection",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "image_picker",
      "id": "image_bg",
      "label": "Background Image"
    },
    {
      "type": "select",
      "id": "e_size",
      "label": "Background Size",
      "default": "cover",
      "options": [
        { "value": "auto", "label": "Auto" },
        { "value": "cover", "label": "Cover" },
        { "value": "contain", "label": "Contain" }
      ]
    },
    {
      "type": "select",
      "id": "e_repeat",
      "label": "Background Repeat",
      "default": "no-repeat",
      "options": [
        { "value": "no-repeat", "label": "No-repeat" },
        { "value": "repeat", "label": "Repeat" }
      ]
    },
    {
      "type": "select",
      "id": "e_pos",
      "label": "Background Position",
      "default": "center center",
      "options": [
        { "value": "center center", "label": "Center" },
        { "value": "top center", "label": "Top Center" },
        { "value": "bottom center", "label": "Bottom Center" }
      ]
    },
    {
      "type": "header",
      "content": "Section Padding"
    },
    {
      "type": "text",
      "id": "paddingsection",
      "label": "Padding (Desktop)",
      "default": "0px 0px 0px 0px",
      "info": "Top Right Bottom Left"
    },
    {
      "type": "text",
      "id": "paddingmobile",
      "label": "Padding (Mobile)",
      "default": "0px 0px 0px 0px",
      "info": "Top Right Bottom Left"
    },
    {
      "type": "header",
      "content": "Section Margin"
    },
    {
      "type": "text",
      "id": "marginsection",
      "label": "Margin Section",
      "default": "0px 0px 0px 0px",
      "info": "Margin: Top Right Bottom Left"
    },
    {
      "type": "text",
      "id": "marginmobile",
      "label": "Margin Mobile",
      "default": "0px 0px 0px 0px",
      "info": "Margin: Top Right Bottom Left"
    }
  ],
  "blocks": [
    {
      "type": "image_row1",
      "name": "Row 1 Image (→ Left)",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        }
      ]
    },
    {
      "type": "image_row2",
      "name": "Row 2 Image (← Right)",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        }
      ]
    },
    {
      "type": "image_row3",
      "name": "Row 3 Image (→ Left)",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Marquee Gallery",
      "blocks": [
        { "type": "image_row1" },
        { "type": "image_row1" },
        { "type": "image_row1" },
        { "type": "image_row1" },
        { "type": "image_row1" },
        { "type": "image_row1" },
        { "type": "image_row1" },
        { "type": "image_row2" },
        { "type": "image_row2" },
        { "type": "image_row2" },
        { "type": "image_row2" },
        { "type": "image_row2" },
        { "type": "image_row2" },
        { "type": "image_row2" },
        { "type": "image_row3" },
        { "type": "image_row3" },
        { "type": "image_row3" },
        { "type": "image_row3" },
        { "type": "image_row3" },
        { "type": "image_row3" },
        { "type": "image_row3" }
      ]
    }
  ]
}
{% endschema %}