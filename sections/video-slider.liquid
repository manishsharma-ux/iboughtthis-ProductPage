<!-- video-slider.liquid -->
<style>
  .customstyle{{ section.id }} {
    position: relative;
    z-index: {{ section.settings.zindex | default: 1 }};
    background-color: {{ section.settings.bgsection }};
    background-position: {{ section.settings.e_pos }} !important;
    background-repeat: {{ section.settings.e_repeat }} !important;
    background-size: {{ section.settings.e_size }} !important;
  }

  .video-slider-section {
    padding: {{ section.settings.paddingsection }};
  }

  /* ===== Heading ===== */
  .video-slider-section__heading {
    text-align: {{ section.settings.heading_align }};
    margin-bottom: {{ section.settings.heading_mb }}px;
  }
  .video-slider-section__heading h2 {
    font-size: {{ section.settings.heading_size }}px;
    font-weight: {{ section.settings.heading_weight }};
    color: {{ section.settings.heading_color }};
    margin: 0 0 8px;
    line-height: 1.2;
  }
  .video-slider-section__heading p {
    font-size: {{ section.settings.subheading_size }}px;
    color: {{ section.settings.subheading_color }};
    margin: 0;
  }

  /* ===== Slider Container ===== */
  .video-slider-wrap {
    position: relative;
  }

  .video-slider-track-outer {
    overflow: hidden;
    border-radius: {{ section.settings.card_radius }}px;
  }

  .video-slider-track {
    display: flex;
    gap: {{ section.settings.card_gap }}px;
    transition: transform 0.45s cubic-bezier(0.4, 0, 0.2, 1);
    will-change: transform;
    cursor: grab;
    user-select: none;
  }

  .video-slider-track.is-dragging {
    cursor: grabbing;
    transition: none;
  }

  /* ===== Video Card ===== */
  .video-card {
    flex-shrink: 0;
    width: {{ section.settings.card_width }}px;
    border-radius: {{ section.settings.card_radius }}px;
    overflow: hidden;
    position: relative;
    background: #000;
    aspect-ratio: {{ section.settings.card_ratio }};
    cursor: pointer;
  }

  /* Thumbnail */
  .video-card__thumb {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s ease, opacity 0.3s ease;
  }

  .video-card:hover .video-card__thumb {
    transform: scale(1.04);
    opacity: 0.85;
  }

  /* Play Button */
  .video-card__play {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: {{ section.settings.play_btn_size }}px;
    height: {{ section.settings.play_btn_size }}px;
    background: {{ section.settings.play_btn_bg }};
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.25s ease, background 0.25s ease;
    pointer-events: none;
    z-index: 2;
  }

  .video-card__play svg {
    width: {{ section.settings.play_btn_size | divided_by: 2.5 | round }}px;
    height: {{ section.settings.play_btn_size | divided_by: 2.5 | round }}px;
    fill: {{ section.settings.play_btn_color }};
    margin-left: 3px;
  }

  .video-card:hover .video-card__play {
    transform: translate(-50%, -50%) scale(1.12);
    background: {{ section.settings.play_btn_bg_hover }};
  }

  /* Pause indicator (while playing inline) */
  .video-card__pause {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: {{ section.settings.play_btn_size }}px;
    height: {{ section.settings.play_btn_size }}px;
    background: rgba(0,0,0,0.45);
    border-radius: 50%;
    display: none;
    align-items: center;
    justify-content: center;
    z-index: 2;
    pointer-events: none;
  }

  .video-card__pause svg {
    width: {{ section.settings.play_btn_size | divided_by: 2.8 | round }}px;
    height: {{ section.settings.play_btn_size | divided_by: 2.8 | round }}px;
    fill: #fff;
  }

  .video-card.is-playing .video-card__play { display: none; }
  .video-card.is-playing .video-card__pause { display: flex; }

  /* Inline video element */
  .video-card__video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: none;
    z-index: 1;
  }

  .video-card.is-playing .video-card__thumb { opacity: 0; pointer-events: none; }
  .video-card.is-playing .video-card__video { display: block; }

  /* ===== Nav Arrows ===== */
  .video-slider-arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: {{ section.settings.arrow_size }}px;
    height: {{ section.settings.arrow_size }}px;
    border-radius: 50%;
    background: {{ section.settings.arrow_bg }};
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 10;
    transition: background 0.2s ease, transform 0.2s ease;
    box-shadow: 0 2px 12px rgba(0,0,0,0.15);
  }

  .video-slider-arrow:hover {
    background: {{ section.settings.arrow_bg_hover }};
    transform: translateY(-50%) scale(1.08);
  }

  .video-slider-arrow svg {
    width: 16px;
    height: 16px;
    fill: none;
    stroke: {{ section.settings.arrow_color }};
    stroke-width: 2.2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .video-slider-arrow--prev { left: -{{ section.settings.arrow_size | divided_by: 2 }}px; }
  .video-slider-arrow--next { right: -{{ section.settings.arrow_size | divided_by: 2 }}px; }

  .video-slider-arrow.is-disabled {
    opacity: 0.35;
    pointer-events: none;
  }

  /* ===== Dots ===== */
  {% if section.settings.show_dots %}
  .video-slider-dots {
    display: flex;
    justify-content: center;
    gap: 8px;
    margin-top: 20px;
  }

  .video-slider-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: {{ section.settings.dot_inactive_color }};
    border: none;
    cursor: pointer;
    padding: 0;
    transition: background 0.25s ease, width 0.25s ease;
  }

  .video-slider-dot.is-active {
    background: {{ section.settings.dot_active_color }};
    width: 22px;
    border-radius: 4px;
  }
  {% endif %}

  /* ===== Responsive ===== */
  @media (max-width: 768px) {
    .video-slider-section {
      padding: {{ section.settings.paddingmobile }};
    }
    .video-card {
      width: {{ section.settings.card_width_mobile }}px;
    }
    .video-slider-arrow--prev { left: 4px; }
    .video-slider-arrow--next { right: 4px; }
    .video-lightbox__inner {
      max-width: 100%;
    }
  }
</style>

<section
  class="customstyle{{ section.id }} lazyload"
  data-aos="{{ section.settings.animation }}"
  data-bgset="{% render 'bgset', image: section.settings.image_bg %}"
  data-sizes="auto"
  data-parent-fit="cover"
>
  {%- render 'style-section' -%}

  <div class="{{ section.settings.setwidth }}">
    <div class="video-slider-section">

      {%- if section.settings.heading != blank or section.settings.subheading != blank -%}
        <div class="video-slider-section__heading">
          {%- if section.settings.heading != blank -%}
            <h2>{{ section.settings.heading }}</h2>
          {%- endif -%}
          {%- if section.settings.subheading != blank -%}
            <p>{{ section.settings.subheading }}</p>
          {%- endif -%}
        </div>
      {%- endif -%}

      {%- if section.blocks.size > 0 -%}
        <div class="video-slider-wrap" id="video-slider-{{ section.id }}">

          {%- if section.settings.show_arrows -%}
          <button class="video-slider-arrow video-slider-arrow--prev" aria-label="Previous" data-slider="{{ section.id }}">
            <svg viewBox="0 0 24 24"><polyline points="15 18 9 12 15 6"/></svg>
          </button>
          {%- endif -%}

          <div class="video-slider-track-outer">
            <div class="video-slider-track" id="track-{{ section.id }}">
              {%- for block in section.blocks -%}
                {%- assign has_video = false -%}
                {%- if block.settings.video_url != blank or block.settings.video_file != blank -%}
                  {%- assign has_video = true -%}
                {%- endif -%}

                {%- comment -%} Resolve thumbnail: manual > video preview > placeholder {%- endcomment -%}
                {%- assign auto_thumb = blank -%}
                {%- if block.settings.thumbnail != blank -%}
                  {%- assign auto_thumb = block.settings.thumbnail -%}
                {%- elsif block.settings.video_file != blank and block.settings.video_file.preview_image != blank -%}
                  {%- assign auto_thumb = block.settings.video_file.preview_image -%}
                {%- endif -%}

                {%- comment -%} Resolve best video source (prefer mp4) {%- endcomment -%}
                {%- assign video_src = blank -%}
                {%- if block.settings.video_file != blank -%}
                  {%- for source in block.settings.video_file.sources -%}
                    {%- if source.mime_type == 'video/mp4' and video_src == blank -%}
                      {%- assign video_src = source.url -%}
                    {%- endif -%}
                  {%- endfor -%}
                  {%- if video_src == blank and block.settings.video_file.sources.size > 0 -%}
                    {%- assign video_src = block.settings.video_file.sources[0].url -%}
                  {%- endif -%}
                {%- endif -%}

                <div
                  class="video-card"
                  data-video-url="{{ block.settings.video_url }}"
                  data-video-type="{{ block.settings.video_type }}"
                  data-play-mode="inline"
                  {{ block.shopify_attributes }}
                >
                  {%- comment -%} Thumbnail image {%- endcomment -%}
                  {%- if auto_thumb != blank -%}
                    {%- assign thumb_url = auto_thumb | image_url: width: 1 | replace: 'width=1', 'width={width}' -%}
                    <img
                      class="video-card__thumb lazyload"
                      src="{{ auto_thumb | image_url: width: 20 }}"
                      data-src="{{ thumb_url }}"
                      data-widths="[300, 400, 500, 600]"
                      data-sizes="auto"
                      loading="lazy"
                      alt="{{ auto_thumb.alt | default: 'Video thumbnail' }}"
                    >
                  {%- else -%}
                    <div class="video-card__thumb" style="background:#1a1a1a;"></div>
                  {%- endif -%}

                  {%- comment -%} Play / Pause overlays {%- endcomment -%}
                  {%- if has_video -%}
                    <div class="video-card__play">
                      <svg viewBox="0 0 24 24"><polygon points="5 3 19 12 5 21 5 3"/></svg>
                    </div>
                    <div class="video-card__pause">
                      <svg viewBox="0 0 24 24"><rect x="6" y="4" width="4" height="16"/><rect x="14" y="4" width="4" height="16"/></svg>
                    </div>
                    {%- comment -%} Inline video element {%- endcomment -%}
                    {%- if video_src != blank -%}
                      <video class="video-card__video" playsinline controls preload="none">
                        <source src="{{ video_src }}" type="video/mp4">
                      </video>
                    {%- endif -%}
                  {%- endif -%}
                </div>
              {%- endfor -%}
            </div>
          </div>

          {%- if section.settings.show_arrows -%}
          <button class="video-slider-arrow video-slider-arrow--next" aria-label="Next" data-slider="{{ section.id }}">
            <svg viewBox="0 0 24 24"><polyline points="9 18 15 12 9 6"/></svg>
          </button>
          {%- endif -%}

        </div>

        {%- if section.settings.show_dots -%}
        <div class="video-slider-dots" id="dots-{{ section.id }}">
          {%- for block in section.blocks -%}
            <button class="video-slider-dot {% if forloop.first %}is-active{% endif %}" data-index="{{ forloop.index0 }}" aria-label="Go to slide {{ forloop.index }}"></button>
          {%- endfor -%}
        </div>
        {%- endif -%}

      {%- endif -%}
    </div>
  </div>
</section>

<script>
(function() {
  var sectionId = '{{ section.id }}';
  var slider = document.getElementById('video-slider-' + sectionId);
  if (!slider) return;

  var track = document.getElementById('track-' + sectionId);
  var cards = Array.prototype.slice.call(track.querySelectorAll('.video-card'));
  var dotsContainer = document.getElementById('dots-' + sectionId);
  var dots = dotsContainer ? Array.prototype.slice.call(dotsContainer.querySelectorAll('.video-slider-dot')) : [];

  var gap           = {{ section.settings.card_gap }};
  var visibleCount  = {{ section.settings.visible_cards }};
  var loopEnabled   = {{ section.settings.loop_slider }};
  var autoplayOn    = {{ section.settings.autoplay }};
  var autoplayDelay = {{ section.settings.autoplay_speed }} * 1000;

  var totalCards    = cards.length;
  var currentIndex  = 0;
  var maxIndex      = Math.max(0, totalCards - visibleCount);
  var autoplayTimer = null;

  /* ─── drag state ───────────────────────────────────────── */
  var isDragging  = false;
  var dragStartX  = 0;
  var dragDeltaX  = 0;
  var didDrag     = false;

  /* ─── helpers ──────────────────────────────────────────── */

  function getStepWidth() {
    /* offsetWidth works correctly even inside overflow:hidden containers */
    var card = cards[0];
    if (!card) return 0;
    return card.offsetWidth + gap;
  }

  function goTo(index, stopAuto) {
    /* Always reset drag flags on slide change */
    didDrag    = false;
    dragDeltaX = 0;

    /* Loop logic */
    if (loopEnabled) {
      if (index > maxIndex) index = 0;
      if (index < 0)        index = maxIndex;
    } else {
      index = Math.max(0, Math.min(index, maxIndex));
    }

    currentIndex = index;
    var offset = -(currentIndex * getStepWidth());
    track.style.transform = 'translateX(' + offset + 'px)';
    updateDots();
    updateArrows();

    /* Stop any playing video when slide changes */
    stopAllVideos(null);

    if (stopAuto) stopAutoplay();
  }

  function updateDots() {
    dots.forEach(function(dot, i) {
      dot.classList.toggle('is-active', i === currentIndex);
    });
  }

  function updateArrows() {
    var prev = slider.querySelector('.video-slider-arrow--prev');
    var next = slider.querySelector('.video-slider-arrow--next');
    if (!loopEnabled) {
      if (prev) prev.classList.toggle('is-disabled', currentIndex === 0);
      if (next) next.classList.toggle('is-disabled', currentIndex >= maxIndex);
    } else {
      if (prev) prev.classList.remove('is-disabled');
      if (next) next.classList.remove('is-disabled');
    }
  }

  /* ─── autoplay ─────────────────────────────────────────── */

  function startAutoplay() {
    if (!autoplayOn) return;
    clearInterval(autoplayTimer);
    autoplayTimer = setInterval(function() {
      goTo(currentIndex + 1, false);
    }, autoplayDelay);
  }

  function stopAutoplay() {
    clearInterval(autoplayTimer);
    autoplayTimer = null;
  }

  /* Pause autoplay on hover */
  {% if section.settings.pause_on_hover %}
  slider.addEventListener('mouseenter', stopAutoplay);
  slider.addEventListener('mouseleave', function() { if (autoplayOn) startAutoplay(); });
  {% endif %}

  /* ─── arrows ───────────────────────────────────────────── */

  slider.querySelectorAll('.video-slider-arrow').forEach(function(btn) {
    /* Prevent drag from starting when clicking arrows */
    btn.addEventListener('mousedown', function(e) {
      e.stopPropagation();
    });

    btn.addEventListener('click', function(e) {
      e.stopPropagation();
      e.preventDefault();

      /* Cancel any in-progress drag state */
      isDragging = false;
      didDrag    = false;
      dragDeltaX = 0;
      track.classList.remove('is-dragging');

      if (btn.classList.contains('video-slider-arrow--prev')) {
        goTo(currentIndex - 1, true);
      } else {
        goTo(currentIndex + 1, true);
      }

      if (autoplayOn) startAutoplay();
    });
  });

  /* ─── dots ─────────────────────────────────────────────── */

  dots.forEach(function(dot) {
    dot.addEventListener('click', function() {
      goTo(parseInt(dot.getAttribute('data-index')), true);
      if (autoplayOn) startAutoplay();
    });
  });

  /* ─── drag / swipe ─────────────────────────────────────── */

  track.addEventListener('mousedown', function(e) {
    /* Ignore if target is an arrow button */
    if (e.target.closest && e.target.closest('.video-slider-arrow')) return;
    isDragging = true;
    didDrag    = false;
    dragStartX = e.clientX;
    dragDeltaX = 0;
    track.classList.add('is-dragging');
    stopAutoplay();
  });

  document.addEventListener('mousemove', function(e) {
    if (!isDragging) return;
    dragDeltaX = e.clientX - dragStartX;
    if (Math.abs(dragDeltaX) > 5) didDrag = true;
    var offset = -(currentIndex * getStepWidth()) + dragDeltaX;
    track.style.transform = 'translateX(' + offset + 'px)';
  });

  document.addEventListener('mouseup', function() {
    if (!isDragging) return;
    isDragging = false;
    track.classList.remove('is-dragging');

    var delta = dragDeltaX; /* capture before goTo resets it */

    if (delta < -50)      goTo(currentIndex + 1, true);
    else if (delta > 50)  goTo(currentIndex - 1, true);
    else                  goTo(currentIndex, false);

    if (autoplayOn) startAutoplay();

    /* Small delay so the card click handler can still read didDrag */
    setTimeout(function() {
      dragDeltaX = 0;
      didDrag    = false;
    }, 60);
  });

  /* ─── touch ────────────────────────────────────────────── */

  var touchStartX = 0;

  track.addEventListener('touchstart', function(e) {
    touchStartX = e.touches[0].clientX;
    dragDeltaX  = 0;
    didDrag     = false;
    stopAutoplay();
  }, { passive: true });

  track.addEventListener('touchmove', function(e) {
    dragDeltaX = e.touches[0].clientX - touchStartX;
    if (Math.abs(dragDeltaX) > 5) didDrag = true;
    var offset = -(currentIndex * getStepWidth()) + dragDeltaX;
    track.style.transform = 'translateX(' + offset + 'px)';
  }, { passive: true });

  track.addEventListener('touchend', function() {
    var delta = dragDeltaX;

    if (delta < -50)      goTo(currentIndex + 1, true);
    else if (delta > 50)  goTo(currentIndex - 1, true);
    else                  goTo(currentIndex, false);

    if (autoplayOn) startAutoplay();

    setTimeout(function() {
      dragDeltaX = 0;
      didDrag    = false;
    }, 60);
  }, { passive: true });

  /* ─── video play logic ─────────────────────────────────── */

  function stopAllVideos(exceptCard) {
    cards.forEach(function(card) {
      if (card === exceptCard) return;
      var vid = card.querySelector('.video-card__video');
      if (vid && !vid.paused) { vid.pause(); vid.currentTime = 0; }
      card.classList.remove('is-playing');
    });
  }

  cards.forEach(function(card) {
    card.addEventListener('click', function() {
      /* Ignore if this was a drag gesture */
      if (didDrag || Math.abs(dragDeltaX) > 8) return;

      var vid = card.querySelector('.video-card__video');
      if (!vid) return;

      if (card.classList.contains('is-playing')) {
        if (vid.paused) {
          vid.play();
        } else {
          vid.pause();
          card.classList.remove('is-playing');
        }
      } else {
        stopAllVideos(card);
        card.classList.add('is-playing');
        vid.play().catch(function() {});
      }
    });

    /* When video ends, reset card to thumbnail state */
    var vid = card.querySelector('.video-card__video');
    if (vid) {
      vid.addEventListener('ended', function() {
        card.classList.remove('is-playing');
        vid.currentTime = 0;
      });
    }
  });

  /* ─── init ─────────────────────────────────────────────── */

  goTo(0, false);
  startAutoplay();

  window.addEventListener('resize', function() {
    goTo(currentIndex, false);
  });
})();
</script>

{% schema %}
{
  "name": "Video Slider",
  "class": "index-section",
  "settings": [
    {
      "type": "header",
      "content": "Animation"
    },
    {
      "type": "select",
      "id": "animation",
      "label": "Entry Animation",
      "options": [
        { "value": "", "label": "None" },
        { "value": "fade", "label": "Fade" },
        { "value": "fade-up", "label": "Fade Up" },
        { "value": "zoom-in", "label": "Zoom In" }
      ]
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "setwidth",
      "label": "Container Width",
      "default": "container-fluid",
      "options": [
        { "value": "container", "label": "Box" },
        { "value": "container-fluid", "label": "Container Fluid" },
        { "value": "full", "label": "Full" }
      ]
    },
    {
      "type": "range",
      "id": "visible_cards",
      "label": "Visible Cards (Desktop)",
      "min": 1,
      "max": 8,
      "step": 1,
      "default": 5,
      "info": "How many cards are fully visible at once"
    },
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Heading"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Subheading"
    },
    {
      "type": "select",
      "id": "heading_align",
      "label": "Heading Alignment",
      "default": "center",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ]
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading Font Size (px)",
      "min": 16,
      "max": 64,
      "step": 2,
      "default": 32
    },
    {
      "type": "select",
      "id": "heading_weight",
      "label": "Heading Font Weight",
      "default": "700",
      "options": [
        { "value": "400", "label": "Normal" },
        { "value": "600", "label": "Semi Bold" },
        { "value": "700", "label": "Bold" }
      ]
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#1a1a1a"
    },
    {
      "type": "range",
      "id": "subheading_size",
      "label": "Subheading Font Size (px)",
      "min": 10,
      "max": 28,
      "step": 1,
      "default": 16
    },
    {
      "type": "color",
      "id": "subheading_color",
      "label": "Subheading Color",
      "default": "#555555"
    },
    {
      "type": "range",
      "id": "heading_mb",
      "label": "Heading Bottom Gap (px)",
      "min": 0,
      "max": 60,
      "step": 4,
      "default": 24
    },
    {
      "type": "header",
      "content": "Card"
    },
    {
      "type": "range",
      "id": "card_width",
      "label": "Card Width Desktop (px)",
      "min": 120,
      "max": 600,
      "step": 10,
      "default": 270
    },
    {
      "type": "range",
      "id": "card_width_mobile",
      "label": "Card Width Mobile (px)",
      "min": 100,
      "max": 320,
      "step": 10,
      "default": 180
    },
    {
      "type": "select",
      "id": "card_ratio",
      "label": "Card Aspect Ratio",
      "default": "9/16",
      "options": [
        { "value": "9/16", "label": "Portrait 9:16" },
        { "value": "4/5", "label": "Portrait 4:5" },
        { "value": "1/1", "label": "Square 1:1" },
        { "value": "16/9", "label": "Landscape 16:9" }
      ]
    },
    {
      "type": "range",
      "id": "card_gap",
      "label": "Gap Between Cards (px)",
      "min": 0,
      "max": 40,
