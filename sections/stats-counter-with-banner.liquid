<!-- stats-counter.liquid -->
<style>
  .customstyle{{ section.id }} {
    position: relative;
    z-index: {{ section.settings.zindex | default: 1 }};
    background-color: {{ section.settings.bgsection }};
    background-position: {{ section.settings.e_pos }} !important;
    background-repeat: {{ section.settings.e_repeat }} !important;
    background-size: {{ section.settings.e_size }} !important;
    overflow: hidden;
  }

  /* ===== Background Image Overlay ===== */
  .stats-counter-section {
    position: relative;
    min-height: {{ section.settings.section_min_height }}px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: {{ section.settings.paddingsection }};
  }

  .stats-counter-section__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: {{ section.settings.bg_image_position }};
    display: block;
    z-index: 0;
  }

  .stats-counter-section__overlay {
    position: absolute;
    inset: 0;
    background: {{ section.settings.overlay_color }};
    opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
    z-index: 1;
  }

  /* ===== Content Layer ===== */
  .stats-counter-section__inner {
    position: relative;
    z-index: 2;
    width: 100%;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-height: inherit;
    gap: 40px;
  }

  /* ===== Heading ===== */
  .stats-counter-section__heading {
    max-width: {{ section.settings.heading_max_width }}px;
    text-align: {{ section.settings.heading_align }};
  }

  .stats-counter-section__heading h2 {
    font-size: {{ section.settings.heading_size }}px;
    font-weight: {{ section.settings.heading_weight }};
    color: {{ section.settings.heading_color }};
    line-height: 1.2;
    margin: 0;
  }

  /* ===== Stats Row ===== */
  .stats-counter-section__stats {
    display: flex;
    align-items: flex-start;
    gap: 0;
  }

  .stat-item {
    flex: 1;
    padding-right: 40px;
    position: relative;
  }

  .stat-item:not(:last-child)::after {
    content: '';
    position: absolute;
    right: 20px;
    top: 0;
    height: 100%;
    width: 1px;
    background: {{ section.settings.divider_color }};
    opacity: 0.5;
  }

  .stat-item__number {
    display: flex;
    align-items: baseline;
    gap: 2px;
    line-height: 1;
    margin-bottom: 8px;
  }

  .stat-item__count {
    font-size: {{ section.settings.number_size }}px;
    font-weight: {{ section.settings.number_weight }};
    color: {{ section.settings.number_color }};
    line-height: 1;
    font-family: {{ section.settings.number_font }};
  }

  .stat-item__suffix {
    font-size: {{ section.settings.suffix_size }}px;
    font-weight: {{ section.settings.number_weight }};
    color: {{ section.settings.number_color }};
    line-height: 1;
  }

  .stat-item__label {
    font-size: {{ section.settings.label_size }}px;
    color: {{ section.settings.label_color }};
    font-weight: {{ section.settings.label_weight }};
    line-height: 1.5;
    max-width: 280px;
  }

  /* ===== Animate in ===== */
  .stat-item__count {
    transition: none;
  }

  /* ===== Responsive ===== */
  @media (max-width: 768px) {
    .stats-counter-section {
      padding: {{ section.settings.paddingmobile }};
      min-height: auto;
    }
    .stats-counter-section__stats {
      flex-direction: column;
      gap: 30px;
    }
    .stat-item {
      padding-right: 0;
      padding-bottom: 24px;
    }
    .stat-item:not(:last-child)::after {
      right: auto;
      top: auto;
      bottom: 0;
      left: 0;
      width: 60px;
      height: 1px;
    }
    .stats-counter-section__heading h2 {
      font-size: {{ section.settings.heading_size | times: 0.65 | round }}px;
    }
    .stat-item__count {
      font-size: {{ section.settings.number_size | times: 0.7 | round }}px;
    }
    .stat-item__suffix {
      font-size: {{ section.settings.suffix_size | times: 0.7 | round }}px;
    }
  }
</style>

<section
  class="customstyle{{ section.id }} lazyload"
  data-aos="{{ section.settings.animation }}"
  data-bgset="{% render 'bgset', image: section.settings.image_bg %}"
  data-sizes="auto"
  data-parent-fit="cover"
>
  {%- render 'style-section' -%}

  <div class="stats-counter-section" id="stats-section-{{ section.id }}">

    {%- if section.settings.bg_image != blank -%}
      {%- assign bg_img_url = section.settings.bg_image | image_url: width: 1 | replace: 'width=1', 'width={width}' -%}
      <img
        class="stats-counter-section__bg lazyload"
        src="{{ section.settings.bg_image | image_url: width: 20 }}"
        data-src="{{ bg_img_url }}"
        data-widths="[600, 800, 1000, 1200, 1400, 1600, 1920, 2400]"
        data-sizes="auto"
        alt=""
        aria-hidden="true"
      >
    {%- endif -%}

    {%- if section.settings.overlay_opacity > 0 -%}
      <div class="stats-counter-section__overlay"></div>
    {%- endif -%}

    <div class="stats-counter-section__inner {{ section.settings.setwidth }}">

      {%- if section.settings.heading != blank -%}
        <div class="stats-counter-section__heading">
          <h2>{{ section.settings.heading }}</h2>
        </div>
      {%- endif -%}

      {%- if section.blocks.size > 0 -%}
        <div class="stats-counter-section__stats">
          {%- for block in section.blocks -%}
            <div class="stat-item" {{ block.shopify_attributes }}>
              <div class="stat-item__number">
                <span
                  class="stat-item__count"
                  data-target="{{ block.settings.stat_number }}"
                  data-duration="{{ section.settings.count_duration }}"
                >0</span>
                {%- if block.settings.stat_suffix != blank -%}
                  <span class="stat-item__suffix">{{ block.settings.stat_suffix }}</span>
                {%- endif -%}
              </div>
              {%- if block.settings.stat_label != blank -%}
                <p class="stat-item__label">{{ block.settings.stat_label }}</p>
              {%- endif -%}
            </div>
          {%- endfor -%}
        </div>
      {%- endif -%}

    </div>
  </div>
</section>

<script>
(function() {
  var section = document.getElementById('stats-section-{{ section.id }}');
  if (!section) return;

  var counters = section.querySelectorAll('.stat-item__count');
  var hasAnimated = false;

  function easeOutQuad(t) {
    return t * (2 - t);
  }

  function animateCounter(el) {
    var target = parseFloat(el.getAttribute('data-target'));
    var duration = parseInt(el.getAttribute('data-duration')) || 2000;
    var isDecimal = target % 1 !== 0;
    var startTime = null;

    function step(timestamp) {
      if (!startTime) startTime = timestamp;
      var elapsed = timestamp - startTime;
      var progress = Math.min(elapsed / duration, 1);
      var eased = easeOutQuad(progress);
      var current = eased * target;

      el.textContent = isDecimal
        ? current.toFixed(1)
        : Math.floor(current).toString();

      if (progress < 1) {
        requestAnimationFrame(step);
      } else {
        el.textContent = isDecimal ? target.toFixed(1) : Math.floor(target).toString();
      }
    }

    requestAnimationFrame(step);
  }

  function runCounters() {
    if (hasAnimated) return;
    hasAnimated = true;
    counters.forEach(function(el) {
      animateCounter(el);
    });
  }

  // IntersectionObserver — triggers when section scrolls into view
  if ('IntersectionObserver' in window) {
    var observer = new IntersectionObserver(function(entries) {
      entries.forEach(function(entry) {
        if (entry.isIntersecting) {
          runCounters();
          observer.disconnect();
        }
      });
    }, { threshold: {{ section.settings.trigger_threshold | divided_by: 100.0 }} });

    observer.observe(section);
  } else {
    // Fallback for older browsers
    runCounters();
  }
})();
</script>

