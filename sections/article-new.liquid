{%- comment -%} ══ MOBILE AUTHOR TOGGLE ══ {%- endcomment -%}
<script>
(function () {
  function getBackdrop() { return document.querySelector('.rl-popup-backdrop'); }
  function closeAll() {
    document.querySelectorAll('.rl-author-popup.is-open').forEach(function(p){ p.classList.remove('is-open'); });
    var bd = getBackdrop();
    if (bd) { bd.classList.remove('is-visible'); setTimeout(function(){ if(bd.parentNode) bd.parentNode.removeChild(bd); }, 220); }
    document.querySelectorAll('.rl-author-toggle[aria-expanded="true"]').forEach(function(btn){
      btn.setAttribute('aria-expanded','false');
      btn.setAttribute('aria-label', btn.closest('.rl-reviewer-item') ? 'Show reviewer info' : 'Show author info');
    });
    document.body.style.overflow = '';
  }
  function openPopup(item) {
    closeAll();
    var popup = item.querySelector('.rl-author-popup');
    var btn   = item.querySelector('.rl-author-toggle');
    if (!popup) return;
    var bd = document.createElement('div');
    bd.className = 'rl-popup-backdrop';
    bd.addEventListener('click', closeAll);
    document.body.appendChild(bd);
    requestAnimationFrame(function(){ bd.classList.add('is-visible'); });
    popup.classList.add('is-open');
    if (btn) {
      btn.setAttribute('aria-expanded','true');
      btn.setAttribute('aria-label', item.classList.contains('rl-reviewer-item') ? 'Hide reviewer info' : 'Hide author info');
    }
    document.body.style.overflow = 'hidden';
  }
  function init() {
    document.querySelectorAll('.rl-author-toggle').forEach(function(btn){
      btn.addEventListener('click', function(e){
        e.stopPropagation();
        var item  = btn.closest('.rl-author-item');
        var popup = item && item.querySelector('.rl-author-popup');
        if (popup && popup.classList.contains('is-open')) { closeAll(); } else if (item) { openPopup(item); }
      });
    });
    document.querySelectorAll('.rl-popup-close').forEach(function(closeBtn){
      closeBtn.addEventListener('click', function(e){ e.stopPropagation(); closeAll(); });
    });
    document.addEventListener('keydown', function(e){ if (e.key === 'Escape') closeAll(); });
  }
  if (document.readyState === 'loading') { document.addEventListener('DOMContentLoaded', init); } else { init(); }
})();
</script>

