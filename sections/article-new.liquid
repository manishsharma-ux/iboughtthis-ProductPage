.rl-compare-card { background: #fff; border: 1px solid #e5e7eb; border-radius: 12px; padding: 20px 16px 18px; text-align: center; position: relative; display: flex; flex-direction: column; align-items: center; gap: 8px; height: 100%; width: 100%; box-sizing: border-box; overflow: visible; transition: border-color 0.2s, box-shadow 0.2s; }
.rl-compare-card:hover { border-color: #0b2a4a; box-shadow: 0 6px 24px rgba(11,42,74,0.09); }
.rl-compare-badge { position: absolute; top: -1px; left: 50%; transform: translateX(-50%); background: #f59e0b; color: #000; font-size: 10px; font-weight: 700; padding: 2px 12px; border-radius: 0 0 8px 8px; letter-spacing: 0.05em; text-transform: uppercase; white-space: nowrap; }
.rl-compare-rank { width: 28px; height: 28px; border-radius: 50%; background: #0b2a4a; color: #fff; font-size: 13px; font-weight: 700; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
.rl-compare-img { height: 100px; display: flex; align-items: center; justify-content: center; }
.rl-compare-img img { max-width: 140px; max-height: 100px; object-fit: contain; }
.rl-compare-title { font-size: 20px; color: #111; margin: 0; line-height: 1.3; }
.rl-compare-desc { font-size: 12px; color: #6b7280; line-height: 1.5; margin: 0; }
.rl-compare-features { width: 100%; text-align: left; border-top: 1px solid #f0f0f0; padding-top: 8px; margin-top: 0; flex-grow: 1; }
.rl-compare-features .rl-feat-item { font-size: 14px; margin-bottom: 16px; gap: 5px; line-height: 1.4; }
.rl-compare-features .rl-feat-key { font-size: 14px; }
.rl-compare-features .rl-feat-val { font-size: 14px; color: #4b5563; }
.rl-compare-cta { display: inline-flex; align-items: center; gap: 6px; background: #657e79; color: #fff; padding: 10px 20px; border-radius: 7px; font-size: 13px; font-weight: 700; text-decoration: none; width: 100%; justify-content: center; margin-top: auto; transition: background 0.2s; box-sizing: border-box; }
.rl-compare-cta:hover { background: #0b2a4a; color: #fff; }
.swiper-wrapper { align-items: stretch; }
.swiper-slide { height: auto !important; }
.rl-compare-section .rl-page-width { padding-left: 0; padding-right: 0; max-width: 100%; }

/* ══════════════════════════════════════════
   ARTICLE CONTENT
══════════════════════════════════════════ */
.rl-main-article { background: #fff; padding: 48px 0 64px; }
@media (max-width: 640px) { .rl-main-article { padding: 32px 0 40px; } }
.rl-article-content { color: #374151; font-size: 16px; line-height: 1.8; }
.rl-article-content h2 { font-family: Georgia,'Times New Roman',serif; font-size: clamp(20px,2.5vw,28px); font-weight: 700; color: #111; margin: 36px 0 12px; padding-bottom: 10px; border-bottom: 2px solid #e5e7eb; }
.rl-article-content h3 { font-size: clamp(17px,2vw,22px); font-weight: 700; color: #1f2937; margin: 28px 0 10px; }
.rl-article-content p { margin: 0 0 16px; }
.rl-article-content ul, .rl-article-content ol { padding-left: 20px; margin: 0 0 16px; }
.rl-article-content li { margin-bottom: 6px; }
.rl-article-content a { color: #3a7eff; }
.rl-article-content a:hover { color: #4a6360; }
.rl-article-content blockquote { border-left: 4px solid #0b2a4a; margin: 24px 0; padding: 12px 20px; background: #f1f5f9; font-style: italic; }
.rl-article-content img { max-width: 100%; border-radius: 8px; height: auto; }
.rl-article-content table { width: 100%; border-collapse: collapse; font-size: 14px; margin: 20px 0; display: block; overflow-x: auto; -webkit-overflow-scrolling: touch; }
.rl-article-content table th { background: #0b2a4a; color: #fff; padding: 10px 14px; text-align: left; font-weight: 600; }
.rl-article-content table td { padding: 10px 14px; border: 1px solid #e5e7eb; }
.rl-article-content table tr:nth-child(even) td { background: #f9fafb; }
.rl-article-tags { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; margin-top: 40px; padding-top: 24px; border-top: 1px solid #e5e7eb; max-width: 820px; }
.rl-tags-label { font-size: 13px; font-weight: 600; color: #6b7280; text-transform: uppercase; letter-spacing: 0.05em; }
.rl-tag { background: #f1f5f9; color: #374151; font-size: 13px; padding: 4px 12px; border-radius: 100px; text-decoration: none; transition: background 0.2s; }
.rl-tag:hover { background: #0b2a4a; color: #fff; }
.rl-article-sources { max-width: 820px; margin-top: 48px; padding: 24px; background: #f9fafb; border: 1px solid #e5e7eb; border-radius: 8px; }
.rl-article-sources h4 { font-size: 15px; font-weight: 700; color: #111; margin: 0 0 12px; text-transform: uppercase; letter-spacing: 0.06em; }
.rl-article-sources p, .rl-article-sources li { font-size: 13px; color: #6b7280; line-height: 1.7; margin: 0 0 6px; }

/* ══════════════════════════════════════════
   AD CARD (inline article widget)
══════════════════════════════════════════ */
.rl-adcard { position: relative; display: flex; align-items: center; gap: 0; border: 1px solid #e5e7eb; border-radius: 10px; background: #fff; overflow: hidden; margin: 28px 0; box-shadow: 0 2px 12px rgba(0,0,0,.06); min-height: 120px; }
.rl-adcard__badge { position: absolute; top: 10px; right: 12px; display: flex; align-items: center; gap: 3px; font-size: 11px; font-weight: 600; color: #9ca3af; letter-spacing: .04em; z-index: 2; line-height: 1; }
.rl-adcard__img-wrap { width: 170px; min-width: 150px; flex-shrink: 0; display: flex; align-items: center; justify-content: center; align-self: stretch; padding: 16px; }
.rl-adcard__img { width: 130px; height: 130px; object-fit: contain; display: block; }
.rl-adcard__body { flex: 1; padding: 20px 16px 20px 20px; min-width: 0; }
.rl-adcard__sub { font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: .08em; color: #657e79; margin: 0 0 8px; }
.rl-adcard__headline { font-size: clamp(16px,2.2vw,22px); font-weight: 700; color: #111; line-height: 1.3; margin: 0; }
.rl-adcard__cta-wrap { flex-shrink: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 8px; padding: 20px 24px 20px 16px; min-width: 160px; }
.rl-adcard__cta-btn { display: inline-flex; align-items: center; justify-content: center; background: #657e79; color: #fff; font-size: 15px; font-weight: 700; padding: 13px 24px; border-radius: 7px; text-decoration: none; white-space: nowrap; width: 100%; text-align: center; transition: background .2s; box-sizing: border-box; }
.rl-adcard__cta-btn:hover { background: #0b2a4a; color: #fff; }
.rl-adcard__cta-sub { font-size: 12px; color: #6b7280; margin: 0; text-align: center; white-space: nowrap; }
@media (max-width: 600px) {
  .rl-adcard { flex-direction: column; align-items: stretch; }
  .rl-adcard__img-wrap { width: 100%; min-width: unset; border-bottom: 1px solid #e5e7eb; }
  .rl-adcard__img { width: auto; height: 120px; }
  .rl-adcard__body { padding: 16px 16px 8px; }
  .rl-adcard__cta-wrap { padding: 12px 16px 16px; min-width: unset; width: 100%; box-sizing: border-box; }
}
</style>

{%- comment -%} ══ USP FEATURE PARSER ══ {%- endcomment -%}
<script>
(function () {
  function parseFeatureBlock(wrapper) {
    var raw = wrapper.querySelector('.metafield-rich_text_field');
    if (!raw) return;
    var html = raw.innerHTML;
    html = html
      .replace(/<br\s*\/?>/gi,'\n').replace(/<\/p>/gi,'\n').replace(/<p[^>]*>/gi,'')
      .replace(/<\/?(strong|b|em|i)[^>]*>/gi,'|BOLD|').replace(/<[^>]+>/g,'');
    var tmp = document.createElement('textarea');
    tmp.innerHTML = html;
    html = tmp.value;
    var lines = html.split('\n').map(function(l){ return l.trim(); }).filter(Boolean);
    var ul = document.createElement('ul');
    ul.className = 'rl-feat-list';
    lines.forEach(function(line) {
      if (!line) return;
      var li = document.createElement('li');
      li.className = 'rl-feat-item';
      li.innerHTML = '<svg class="rl-feat-icon" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><circle cx="10" cy="10" r="9" fill="#dcfce7"/><path d="M6 10.5l2.5 2.5 5.5-5.5" fill="none" stroke="#16a34a" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>';
      var colonIdx = line.indexOf(':');
      var span = document.createElement('span');
      if (colonIdx > 0) {
        var key = line.substring(0, colonIdx).replace(/\|BOLD\|/g,'').trim();
        var val = line.substring(colonIdx + 1).replace(/\|BOLD\|/g,'').trim();
        span.innerHTML = '<span class="rl-feat-key">' + key + ':</span> <span class="rl-feat-val">' + val + '</span>';
      } else {
        span.className = 'rl-feat-val';
        span.textContent = line.replace(/\|BOLD\|/g,'').trim();
      }
      li.appendChild(span);
      ul.appendChild(li);
    });
    wrapper.appendChild(ul);
  }
  function init() { document.querySelectorAll('.rl-rank-features--parsed').forEach(parseFeatureBlock); }
  if (document.readyState === 'loading') { document.addEventListener('DOMContentLoaded', init); } else { init(); }
})();
</script>

