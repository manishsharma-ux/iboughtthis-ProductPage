{%- comment -%} ══════════════════════════════════════════════
  Article New SECTION — Full-featured ranking + compare layout
  Drop into: sections/article-body.liquid
══════════════════════════════════════════════ {%- endcomment -%}

{%- assign author_name   = article.metafields.custom.author_name   | default: article.author -%}
{%- assign author_role   = article.metafields.custom.author_role   | default: 'Staff Editor' -%}
{%- assign author_image  = article.metafields.custom.author_image -%}
{%- assign author_bio    = article.metafields.custom.author_bio -%}
{%- assign author_li     = article.metafields.custom.author_linkedin -%}
{%- assign reviewer_name = article.metafields.custom.reviewer_name -%}
{%- assign reviewer_role = article.metafields.custom.reviewer_role | default: 'Medical Reviewer' -%}
{%- assign reviewer_image= article.metafields.custom.reviewer_image -%}
{%- assign reviewer_bio  = article.metafields.custom.reviewer_bio -%}
{%- assign reviewer_li   = article.metafields.custom.reviewer_linkedin -%}

{%- comment -%} ── Section-level overrides ── {%- endcomment -%}
{%- if section.settings.author_name_override    != blank -%}{%- assign author_name   = section.settings.author_name_override    -%}{%- endif -%}
{%- if section.settings.author_role_override    != blank -%}{%- assign author_role   = section.settings.author_role_override    -%}{%- endif -%}
{%- if section.settings.author_bio_override     != blank -%}{%- assign author_bio    = section.settings.author_bio_override     -%}{%- endif -%}
{%- if section.settings.author_image_override   != blank -%}{%- assign author_image  = section.settings.author_image_override   -%}{%- endif -%}
{%- if section.settings.reviewer_name_override  != blank -%}{%- assign reviewer_name = section.settings.reviewer_name_override  -%}{%- endif -%}
{%- if section.settings.reviewer_role_override  != blank -%}{%- assign reviewer_role = section.settings.reviewer_role_override  -%}{%- endif -%}
{%- if section.settings.reviewer_bio_override   != blank -%}{%- assign reviewer_bio  = section.settings.reviewer_bio_override   -%}{%- endif -%}
{%- if section.settings.reviewer_image_override != blank -%}{%- assign reviewer_image= section.settings.reviewer_image_override -%}{%- endif -%}

{%- comment -%} ── Intro ── {%- endcomment -%}
{%- assign intro_content = article.metafields.custom.intro_text -%}
{%- if section.settings.intro_text != blank -%}{%- assign intro_content = section.settings.intro_text -%}{%- endif -%}

{%- comment -%} ── Collections ── {%- endcomment -%}
{%- assign ranking_collection = collections[section.settings.ranking_collection] -%}
{%- assign compare_collection = collections[section.settings.compare_collection] -%}

{%- comment -%} ── Sticky widget ── {%- endcomment -%}
{%- assign fp_enabled = section.settings.show_featured_product -%}
{%- assign fp_product = section.settings.featured_product -%}
{%- assign fp_link    = section.settings.featured_product_link -%}
{%- assign fp_cta     = section.settings.featured_cta_label | default: 'Learn More' -%}
{%- assign fp_top     = section.settings.sticky_top_offset  | default: 100 -%}
{%- if fp_link == blank and fp_product != blank -%}
  {%- assign fp_link = fp_product.metafields.custom.tracking_link | default: fp_product.url -%}
{%- endif -%}

<div class="rl-body-wrap{% if fp_enabled and fp_product != blank %} rl-body-wrap--has-sidebar{% endif %}">

  {%- comment -%} ═══════ LEFT COLUMN ═══════ {%- endcomment -%}
  <div class="rl-body-main">

    {%- comment -%} ── 1. AUTHOR ROW ── {%- endcomment -%}
    <section class="rl-article-author">
      <div class="rl-page-width">
        <div class="rl-author-row">

          <!-- AUTHOR -->
          <div class="rl-author-item" tabindex="0">
            <div class="rl-author-avatar">
              {%- if author_image != blank -%}
                <img src="{{ author_image | image_url: width: 80 }}" alt="{{ author_name }}" width="40" height="40" loading="lazy">
              {%- else -%}
                <div class="rl-avatar-placeholder">{{ author_name | slice: 0 }}</div>
              {%- endif -%}
            </div>
            <div class="rl-author-text">
              <span class="rl-author-label">Written By</span>
              <span class="rl-author-name">{{ author_name }}</span>
              <span class="rl-author-role">{{ author_role }}</span>
            </div>
            <button class="rl-author-toggle" aria-label="Show author info" aria-expanded="false">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none"><path d="M6 9l6 6 6-6" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </button>
            <div class="rl-author-popup" role="dialog" aria-modal="true">
              <button class="rl-popup-close" aria-label="Close">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none"><path d="M18 6L6 18M6 6l12 12" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </button>
              <div class="rl-popup-inner">
                <div class="rl-popup-top">
                  {%- if author_image != blank -%}
                    <img src="{{ author_image | image_url: width: 120 }}" alt="{{ author_name }}" class="rl-popup-avatar" loading="lazy">
                  {%- else -%}
                    <div class="rl-avatar-placeholder rl-popup-avatar">{{ author_name | slice: 0 }}</div>
                  {%- endif -%}
                  <div>
                    <p class="rl-popup-name">{{ author_name }}</p>
                    <p class="rl-popup-role">{{ author_role }}</p>
                  </div>
                </div>
                {%- if author_bio != blank -%}<p class="rl-popup-bio">{{ author_bio }}</p>{%- endif -%}
              </div>
            </div>
          </div>

          {%- if reviewer_name != blank -%}
          <!-- REVIEWER -->
          <div class="rl-author-item rl-reviewer-item" tabindex="0">
            <div class="rl-author-avatar">
              {%- if reviewer_image != blank -%}
                <img src="{{ reviewer_image | image_url: width: 80 }}" alt="{{ reviewer_name }}" width="40" height="40" loading="lazy">
              {%- else -%}
                <div class="rl-avatar-placeholder">{{ reviewer_name | slice: 0 }}</div>
              {%- endif -%}
            </div>
            <div class="rl-author-text">
              <span class="rl-author-name">{{ reviewer_name }}</span>
              <div>
                <span class="rl-author-label rl-reviewer-label">
                  <span>
                    <svg fill="none" width="23" height="21" viewBox="0 0 23 21" xmlns="http://www.w3.org/2000/svg" class="badge-icon-svg relative medical-review">
                      <rect width="23" height="21"></rect>
                      <path d="M20.141 7.70375C20.1412 6.78472 19.8504 5.88577 19.3046 5.11799C18.7588 4.35022 17.9818 3.74727 17.0697 3.38368C16.1576 3.02009 15.1504 2.91178 14.1725 3.07215C13.1946 3.23252 12.2889 3.65453 11.5674 4.28602C11.0781 3.85941 10.5023 3.52686 9.87318 3.30763C9.24409 3.08839 8.57424 2.98683 7.90244 3.00882C7.23064 3.03081 6.57022 3.17592 5.95944 3.43575C5.34866 3.69557 4.79965 4.06495 4.34421 4.52248C3.88876 4.98002 3.53593 5.51662 3.30614 6.10122C3.07635 6.68583 2.97418 7.3068 3.00553 7.9282C3.03689 8.5496 3.20114 9.15906 3.4888 9.7213C3.77645 10.2835 4.18178 10.7874 4.68132 11.2037L6.84182 13.2697L11.5623 17.7841L16.628 12.965L18.9083 10.7745C19.705 9.9215 20.1427 8.83124 20.141 7.70375Z" fill="#007AC8"></path>
                      <path fill-rule="evenodd" clip-rule="evenodd" d="M11.5623 17.7841L4.68132 11.2037C4.18178 10.7874 3.77645 10.2835 3.4888 9.7213C3.20115 9.15906 3.03689 8.54959 3.00553 7.92819C2.97418 7.3068 3.07635 6.68582 3.30614 6.10122C3.53593 5.51662 3.88876 4.98001 4.34421 4.52248C4.79965 4.06494 5.34866 3.69557 5.95944 3.43574C6.57022 3.17592 7.23064 3.03081 7.90244 3.00882C8.57424 2.98682 9.24409 3.08839 9.87318 3.30762C10.5023 3.52686 11.0781 3.85941 11.5674 4.28602C12.2889 3.65452 13.1946 3.23251 14.1725 3.07215C15.1504 2.91178 16.1576 3.02008 17.0697 3.38368C17.9818 3.74727 18.7588 4.35021 19.3046 5.11799C19.8504 5.88576 20.1412 6.78472 20.141 7.70375C20.1427 8.83124 19.705 9.92149 18.9083 10.7745L16.628 12.9649L11.5623 17.7841ZM22.141 7.70426C22.1426 9.35778 21.499 10.9308 20.3699 12.1397L20.3329 12.1793L18.0066 14.414L11.5586 20.548L5.45955 14.7152L3.34428 12.6924C2.66931 12.1176 2.11123 11.4198 1.7083 10.6322C1.29388 9.82222 1.05389 8.93707 1.00807 8.02898C0.962249 7.1208 1.11199 6.21621 1.44477 5.36958C1.77736 4.52344 2.28396 3.75726 2.92676 3.11151C3.56923 2.46609 4.33537 1.95318 5.17654 1.59534C6.01756 1.23758 6.92151 1.03986 7.837 1.00989C8.75249 0.979917 9.66777 1.11807 10.5313 1.41902C10.888 1.54331 11.2338 1.69466 11.5652 1.87171C12.2741 1.49147 13.0469 1.23001 13.8488 1.09851C15.1819 0.879892 16.5573 1.02636 17.8103 1.52585C19.064 2.02563 20.156 2.86392 20.9346 3.95913C21.7148 5.05649 22.1413 6.35875 22.141 7.70426Z" fill="white"></path>
                      <path d="M9.95714 6.90795C9.95714 6.43077 10.344 6.04395 10.8211 6.04395H11.8884C12.3656 6.04395 12.7525 6.43077 12.7525 6.90795V13.0068C12.7525 13.484 12.3656 13.8708 11.8884 13.8708H10.8211C10.344 13.8708 9.95714 13.484 9.95714 13.0068V6.90795Z" fill="white"></path>
                      <path d="M14.3111 8.65283C14.7882 8.65283 15.1751 9.03966 15.1751 9.51684L15.1751 10.5841C15.1751 11.0613 14.7882 11.4481 14.3111 11.4481L8.2122 11.4481C7.73503 11.4481 7.3482 11.0613 7.3482 10.5841L7.3482 9.51684C7.3482 9.03966 7.73503 8.65283 8.2122 8.65283L14.3111 8.65283Z" fill="white"></path>
                    </svg>
                    Medically Reviewed
                  </span>
                  <span class="rl-author-role">{{ reviewer_role }}</span>
                </span>
              </div>
            </div>
            <button class="rl-author-toggle" aria-label="Show reviewer info" aria-expanded="false">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none"><path d="M6 9l6 6 6-6" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </button>
            <div class="rl-author-popup" role="dialog" aria-modal="true">
              <button class="rl-popup-close" aria-label="Close">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none"><path d="M18 6L6 18M6 6l12 12" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </button>
              <div class="rl-popup-inner">
                <div class="rl-popup-top">
                  {%- if reviewer_image != blank -%}
                    <img src="{{ reviewer_image | image_url: width: 120 }}" alt="{{ reviewer_name }}" class="rl-popup-avatar" loading="lazy">
                  {%- else -%}
                    <div class="rl-avatar-placeholder rl-popup-avatar">{{ reviewer_name | slice: 0 }}</div>
                  {%- endif -%}
                  <div>
                    <p class="rl-popup-name">{{ reviewer_name }}</p>
                    <p class="rl-popup-role">{{ reviewer_role }}</p>
                  </div>
                </div>
                {%- if reviewer_bio != blank -%}<p class="rl-popup-bio">{{ reviewer_bio }}</p>{%- endif -%}
              </div>
            </div>
          </div>
          {%- endif -%}

        </div>
      </div>
    </section>

    {%- comment -%} ── 2. INTRO ── {%- endcomment -%}
    {%- if intro_content != blank -%}
      <section class="rl-article-intro">
        <div class="rl-page-width">
          <div class="rl-intro-body">{{ intro_content }}</div>
        </div>
      </section>
    {%- endif -%}

    {%- comment -%} ── 3. FULL-WIDTH BANNER ── {%- endcomment -%}
    {%- assign fw_image = section.settings.fullwidth_image -%}
    {%- if fw_image != blank -%}
      <div class="rl-fullwidth-banner">
        <img
          src="{{ fw_image | image_url: width: 1400 }}"
          alt="{{ section.settings.fullwidth_image_alt | default: '' }}"
          loading="lazy" width="1400" height="auto"
          class="rl-fullwidth-banner__img"
        >
      </div>
    {%- endif -%}

    {%- comment -%} ── 4. PRODUCT RANKING ── {%- endcomment -%}
    {%- if ranking_collection != blank and ranking_collection.products_count > 0 -%}
      <section class="rl-ranking-section">
        <div class="rl-page-width">
          {%- if section.settings.ranking_title != blank -%}
            <h2 class="rl-section-title">{{ section.settings.ranking_title }}</h2>
          {%- endif -%}
          <div class="rl-ranking-list">
            {%- for product in ranking_collection.products -%}
              {%- assign rank         = forloop.index -%}
              {%- assign rating       = product.metafields.custom.rating       | default: 9.0 -%}
              {%- assign score_label  = product.metafields.custom.score_label  | default: 'Excellent' -%}
              {%- assign review_count = product.metafields.custom.review_count -%}
              {%- assign short_desc   = product.metafields.custom.short_description -%}
              {%- assign usp_details  = product.metafields.custom.usp_details -%}
              {%- assign badge_text   = product.metafields.custom.badge -%}
              {%- assign tracking_link= product.metafields.custom.tracking_link -%}
              {%- assign rank_cta     = section.settings.ranking_cta | default: 'Learn More' -%}
              {%- if section.settings.rating_scale == '10' -%}
                {%- assign stars_exact = rating | times: 1.0 | divided_by: 2.0 -%}
              {%- else -%}
                {%- assign stars_exact = rating | times: 1.0 -%}
              {%- endif -%}
              {%- assign stars_exact = stars_exact | at_most: 5.0 -%}
              {%- assign full_stars  = stars_exact | floor -%}
              {%- assign partial_pct = stars_exact | minus: full_stars | times: 100 | round -%}
              {%- assign partial_star = full_stars | plus: 1 -%}
              {%- assign star_uid    = product.id | append: '-rank' -%}

              <div class="rl-rank-card{% if rank == 1 %} rl-rank-card--first{% endif %}">
                {%- if badge_text != blank -%}
                  <div class="deal-badge">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2l2.09 6.26L20 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l5.91-.91L12 2z"/></svg>
                    {{ badge_text }}
                  </div>
                {%- endif -%}

                <div class="rl-rank-number">{{ rank }}</div>

                <div class="rl-rank-image">
                  {%- if product.featured_image -%}
                    <img src="{{ product.featured_image | image_url: width: 220 }}" alt="{{ product.title | escape }}" width="220" height="160" loading="lazy">
                  {%- endif -%}
                </div>

                <div class="rl-rank-content">
                  {%- if short_desc != blank -%}<p class="rl-rank-short-desc">{{ short_desc }}</p>{%- endif -%}
                  <h3 class="rl-rank-title">{{ product.title }}</h3>
                  {%- if usp_details != blank -%}
                    <div class="rl-rank-features rl-rank-features--parsed">{{- usp_details | metafield_tag -}}</div>
                  {%- endif -%}
                </div>

                <div class="rl-rank-cta-box">
                  <div class="rl-rank-score">
                    <span class="rl-score-number">{{ rating }}</span>
                    <div class="rl-score-label-box">
                      <span class="rl-score-label">{{ score_label }}</span>
                      <div class="rl-score-stars" aria-label="{{ rating }} out of {% if section.settings.rating_scale == '10' %}10{% else %}5{% endif %}" role="img">
                        <svg width="0" height="0" style="position:absolute">
                          <defs>
                            {%- for i in (1..5) -%}
                              {%- if i <= full_stars -%}{%- assign fill_stop = 100 -%}
                              {%- elsif i == partial_star -%}{%- assign fill_stop = partial_pct -%}
                              {%- else -%}{%- assign fill_stop = 0 -%}{%- endif -%}
                              <linearGradient id="star-{{ star_uid }}-{{ i }}" x1="0%" y1="0%" x2="100%" y2="0%">
                                <stop offset="{{ fill_stop }}%" stop-color="#f59e0b"/>
                                <stop offset="{{ fill_stop }}%" stop-color="#d1d5db"/>
                              </linearGradient>
                            {%- endfor -%}
                          </defs>
                        </svg>
                        {%- for i in (1..5) -%}
                          <svg class="rl-star-svg" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                            <polygon points="10,1 12.9,7 19.5,7.6 14.5,12 16.2,18.5 10,15 3.8,18.5 5.5,12 0.5,7.6 7.1,7" fill="url(#star-{{ star_uid }}-{{ i }})"/>
                          </svg>
                        {%- endfor -%}
                      </div>
                    </div>
                    {%- if review_count != blank -%}<span class="rl-review-count">{{ review_count }} reviews</span>{%- endif -%}
                  </div>
                  {%- if tracking_link != blank -%}
                    <a href="{{ tracking_link }}" target="_blank" rel="noopener sponsored" class="rl-rank-cta-btn"
                       onclick="if(typeof fbq!=='undefined')fbq('track','AddToCart');">
                      {{ rank_cta }}
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none"><path d="M5 12h14M12 5l7 7-7 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    </a>
                  {%- endif -%}
                </div>
              </div>
            {%- endfor -%}
          </div>
        </div>
      </section>
    {%- endif -%}

    {%- comment -%} ── 5. COMPARE SLIDER ── {%- endcomment -%}
    {%- if compare_collection != blank and compare_collection.products_count > 0 -%}
      {%- if section.settings.compare_title != blank -%}
        <h2 class="rl-section-title rl-compare-heading">{{ section.settings.compare_title }}</h2>
      {%- endif -%}
      <section class="rl-compare-section">
        <div class="rl-page-width">
          <div class="rl-swiper-wrapper">
            <button class="rl-swiper-prev" aria-label="Previous">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none"><path d="M15 18l-6-6 6-6" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </button>
            <button class="rl-swiper-next" aria-label="Next">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none"><path d="M9 18l6-6-6-6" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </button>
            <div class="swiper rl-compare-swiper">
              <div class="swiper-wrapper">
                {%- for product in compare_collection.products limit: 8 -%}
                  {%- assign c_rating      = product.metafields.custom.rating            | default: 9.0 -%}
                  {%- assign c_score_label = product.metafields.custom.score_label        | default: 'Excellent' -%}
                  {%- assign c_short_desc  = product.metafields.custom.short_description -%}
                  {%- assign c_usp_details = product.metafields.custom.usp_details -%}
                  {%- assign c_link        = product.metafields.custom.tracking_link -%}
                  {%- assign c_badge       = product.metafields.custom.badge -%}
                  {%- assign c_review_count= product.metafields.custom.review_count -%}
                  {%- assign c_cta         = section.settings.compare_cta | default: 'Shop Now' -%}
                  {%- if section.settings.rating_scale == '10' -%}
                    {%- assign c_stars_exact = c_rating | times: 1.0 | divided_by: 2.0 -%}
                  {%- else -%}
                    {%- assign c_stars_exact = c_rating | times: 1.0 -%}
                  {%- endif -%}
                  {%- assign c_stars_exact  = c_stars_exact | at_most: 5.0 -%}
                  {%- assign c_full_stars   = c_stars_exact | floor -%}
                  {%- assign c_partial_pct  = c_stars_exact | minus: c_full_stars | times: 100 | round -%}
                  {%- assign c_partial_star = c_full_stars | plus: 1 -%}
                  {%- assign c_star_uid     = product.id | append: '-cmp' -%}

                  <div class="swiper-slide">
                    <div class="rl-compare-card">
                      {%- if c_badge != blank -%}
                        <div class="rl-compare-badge">{{ c_badge }}</div>
                      {%- endif -%}
                      <div class="rl-compare-rank">{{ forloop.index }}</div>
                      <div class="rl-compare-img">
                        {%- if product.featured_image -%}
                          <img src="{{ product.featured_image | image_url: width: 200 }}" alt="{{ product.title | escape }}" width="140" height="100" loading="lazy">
                        {%- endif -%}
                      </div>
                      <h3 class="rl-compare-title">{{ product.title }}</h3>
                      {%- if c_short_desc != blank -%}<p class="rl-compare-desc">{{ c_short_desc }}</p>{%- endif -%}
                      {%- if c_usp_details != blank -%}
                        <div class="rl-rank-features rl-rank-features--parsed rl-compare-features">{{- c_usp_details | metafield_tag -}}</div>
                      {%- endif -%}
                      <div class="rl-rank-score">
                        <span class="rl-score-number">{{ c_rating }}</span>
                        <div class="rl-score-label-box">
                          <span class="rl-score-label">{{ c_score_label }}</span>
                          <div class="rl-score-stars" aria-label="{{ c_rating }} out of {% if section.settings.rating_scale == '10' %}10{% else %}5{% endif %}" role="img">
                            <svg width="0" height="0" style="position:absolute">
                              <defs>
                                {%- for i in (1..5) -%}
                                  {%- if i <= c_full_stars -%}{%- assign fill_stop = 100 -%}
                                  {%- elsif i == c_partial_star -%}{%- assign fill_stop = c_partial_pct -%}
                                  {%- else -%}{%- assign fill_stop = 0 -%}{%- endif -%}
                                  <linearGradient id="star-{{ c_star_uid }}-{{ i }}" x1="0%" y1="0%" x2="100%" y2="0%">
                                    <stop offset="{{ fill_stop }}%" stop-color="#f59e0b"/>
                                    <stop offset="{{ fill_stop }}%" stop-color="#d1d5db"/>
                                  </linearGradient>
                                {%- endfor -%}
                              </defs>
                            </svg>
                            {%- for i in (1..5) -%}
                              <svg class="rl-star-svg" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                                <polygon points="10,1 12.9,7 19.5,7.6 14.5,12 16.2,18.5 10,15 3.8,18.5 5.5,12 0.5,7.6 7.1,7" fill="url(#star-{{ c_star_uid }}-{{ i }})"/>
                              </svg>
                            {%- endfor -%}
                          </div>
                        </div>
                        {%- if c_review_count != blank -%}<span class="rl-review-count">{{ c_review_count }} reviews</span>{%- endif -%}
                      </div>
                      {%- if c_link != blank -%}
                        <a href="{{ c_link }}" target="_blank" rel="noopener sponsored" class="rl-compare-cta"
                           onclick="if(typeof fbq!=='undefined')fbq('track','AddToCart');">
                          {{ c_cta }}
