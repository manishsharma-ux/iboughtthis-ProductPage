<!-- ibt-expert-review.liquid | IBT product page - Section 4: Expert review -->
{%- liquid
  assign r_name = product.metafields.custom.reviewer_name.value | default: product.metafields.custom.author_name.value
  assign r_role = product.metafields.custom.reviewer_role.value | default: product.metafields.custom.author_role.value
  assign r_img = product.metafields.custom.reviewer_image.value | default: product.metafields.custom.author_image.value
  assign r_bio = product.metafields.custom.reviewer_bio.value | default: product.metafields.custom.author_bio.value
  assign r_link = product.metafields.custom.reviewer_linkedin.value | default: product.metafields.custom.author_linkedin.value

  if section.settings.byline_name != blank
    assign r_name = section.settings.byline_name
  endif
  if section.settings.byline_role != blank
    assign r_role = section.settings.byline_role
  endif

  assign show_byline = false
  if section.settings.show_byline and r_name != blank
    assign show_byline = true
  endif

  assign verdict = product.metafields.custom.score_label.value
  assign rating = product.metafields.custom.rating.value
  assign rating_pct = 0
  if rating != blank
    assign rating_pct = rating | times: 20
  endif

  assign show_verdict = false
  if section.settings.show_verdict and rating != blank
    assign show_verdict = true
  endif

  assign show_header_band = false
  if show_byline or show_verdict
    assign show_header_band = true
  endif
-%}

{%- style -%}
  #shopify-section-{{ section.id }}{
    --ibt-ink:#1a1a1a;
    --ibt-body:#54595f;
    --ibt-line:#e3e6ec;
    --ibt-soft:#f7f7f5;
    --ibt-accent:{{ section.settings.accent_color }};
    --ibt-accent-soft:{{ section.settings.accent_color | color_modify: 'alpha', 0.08 }};
    --ibt-star:#ffa41c;
    --ibt-radius:14px;
    background-color:{{ section.settings.bgsection }};
    padding:{{ section.settings.paddingsection }};
    margin:{{ section.settings.marginsection }};
    {% if section.settings.show_top_accent %}
      border-top:3px solid var(--ibt-accent);
    {% endif %}
  }
  @media (max-width:750px){
    #shopify-section-{{ section.id }}{
      padding:{{ section.settings.paddingmobile }};
      margin:{{ section.settings.marginmobile }};
    }
  }
{%- endstyle -%}

<style>
  /* ---------- Section header ---------- */
  #shopify-section-{{ section.id }} .ibt-xr__header{
    margin:0 0 26px;
    text-align:{{ section.settings.align }};
  }
  #shopify-section-{{ section.id }} .ibt-eyebrow{
    display:inline-flex;
    align-items:center;
    gap:7px;
    font-size:12px;
    font-weight:700;
    letter-spacing:.08em;
    text-transform:uppercase;
    color:var(--ibt-accent);
    margin:0 0 10px;
  }
  #shopify-section-{{ section.id }} .ibt-eyebrow svg{ width:14px; height:14px; }
  #shopify-section-{{ section.id }} .ibt-h2{
    font-size:30px;
    line-height:1.25;
    font-weight:700;
    color:var(--ibt-ink);
    margin:0;
  }
  #shopify-section-{{ section.id }} .ibt-xr__rule{
    display:block;
    width:64px;
    height:3px;
    border:0;
    border-radius:2px;
    background:var(--ibt-accent);
    margin:14px 0 0;
    {% if section.settings.align == 'center' %}margin-left:auto;margin-right:auto;{% endif %}
  }
  #shopify-section-{{ section.id }} .ibt-xr__intro{
    font-size:16.5px;
    line-height:1.7;
    color:var(--ibt-body);
    margin:16px 0 0;
    max-width:70ch;
    {% if section.settings.align == 'center' %}margin-left:auto;margin-right:auto;{% endif %}
  }

  /* ---------- Reviewer + verdict band ---------- */
  #shopify-section-{{ section.id }} .ibt-xr__band{
    display:flex;
    align-items:center;
    justify-content:space-between;
    flex-wrap:wrap;
    gap:18px;
    padding:18px 22px;
    background:#fff;
    border:1px solid var(--ibt-line);
    border-left:4px solid var(--ibt-accent);
    border-radius:12px;
    margin:0 0 26px;
  }
  #shopify-section-{{ section.id }} .ibt-byline{
    display:flex;
    align-items:center;
    gap:14px;
    min-width:0;
  }
  #shopify-section-{{ section.id }} .ibt-byline__img{
    flex:0 0 auto;
    width:50px;
    height:50px;
    border-radius:50%;
    object-fit:cover;
    background:var(--ibt-soft);
    border:1px solid var(--ibt-line);
  }
  #shopify-section-{{ section.id }} .ibt-byline__meta{ min-width:0; }
  #shopify-section-{{ section.id }} .ibt-byline__label{
    display:block;
    font-size:11px;
    font-weight:700;
    letter-spacing:.07em;
    text-transform:uppercase;
    color:#8a8f94;
    margin:0 0 2px;
  }
  #shopify-section-{{ section.id }} .ibt-byline__name{
    font-size:16px;
    font-weight:700;
    color:var(--ibt-ink);
    margin:0;
  }
  #shopify-section-{{ section.id }} .ibt-byline__role{
    font-size:13px;
    color:var(--ibt-body);
    margin:2px 0 0;
  }
  #shopify-section-{{ section.id }} .ibt-byline__bio{
    font-size:13px;
    line-height:1.6;
    color:var(--ibt-body);
    margin:6px 0 0;
  }
  #shopify-section-{{ section.id }} .ibt-byline__link{
    display:inline-block;
    font-size:13px;
    color:var(--ibt-accent);
    text-decoration:underline;
    margin-top:4px;
  }
  #shopify-section-{{ section.id }} .ibt-verdict{
    display:flex;
    align-items:center;
    gap:12px;
    flex-wrap:wrap;
  }
  #shopify-section-{{ section.id }} .ibt-verdict__scorebox{
    display:flex;
    flex-direction:column;
    align-items:center;
    justify-content:center;
    min-width:60px;
    padding:8px 12px;
    background:var(--ibt-accent);
    border-radius:10px;
    line-height:1;
  }
  #shopify-section-{{ section.id }} .ibt-verdict__score{
    font-size:22px;
    font-weight:800;
    color:#fff;
  }
  #shopify-section-{{ section.id }} .ibt-verdict__out{
    font-size:10px;
    font-weight:600;
    color:rgba(255,255,255,.8);
    margin-top:3px;
    letter-spacing:.04em;
  }
  #shopify-section-{{ section.id }} .ibt-verdict__right{ min-width:0; }
  #shopify-section-{{ section.id }} .ibt-stars{
    position:relative;
    display:inline-block;
    line-height:1;
    font-size:17px;
    letter-spacing:1px;
  }
  #shopify-section-{{ section.id }} .ibt-stars__bg{ color:#dcdcdc; }
  #shopify-section-{{ section.id }} .ibt-stars__fill{
    position:absolute;
    top:0;
    left:0;
    overflow:hidden;
    white-space:nowrap;
    color:var(--ibt-star);
  }
  #shopify-section-{{ section.id }} .ibt-verdict__label{
    display:block;
    font-size:13px;
    font-weight:700;
    color:var(--ibt-ink);
    margin-top:6px;
  }

  /* ---------- Subhead parts ---------- */
  #shopify-section-{{ section.id }} .ibt-xr__parts{
    display:grid;
    grid-template-columns:1fr;
    gap:{% if section.settings.part_style == 'cards' %}16px{% else %}0{% endif %};
  }
  #shopify-section-{{ section.id }} .ibt-xr__part{
    {% if section.settings.part_style == 'cards' %}
      background:#fff;
      border:1px solid var(--ibt-line);
      border-radius:var(--ibt-radius);
      padding:24px 26px;
    {% elsif section.settings.part_style == 'divided' %}
      border-top:1px solid var(--ibt-line);
      padding:26px 0 0;
      margin-top:26px;
    {% else %}
      padding:0;
      margin-bottom:28px;
    {% endif %}
  }
  {% if section.settings.part_style == 'divided' %}
    #shopify-section-{{ section.id }} .ibt-xr__part:first-child{
      border-top:0;
      padding-top:0;
      margin-top:0;
    }
  {% endif %}
  {% if section.settings.part_style == 'plain' %}
    #shopify-section-{{ section.id }} .ibt-xr__part:last-child{ margin-bottom:0; }
  {% endif %}

  #shopify-section-{{ section.id }} .ibt-xr__subhead{
    display:flex;
    align-items:center;
    gap:12px;
    font-size:19px;
    font-weight:700;
    line-height:1.35;
    color:var(--ibt-ink);
    margin:0 0 12px;
  }
  #shopify-section-{{ section.id }} .ibt-xr__chip{
    flex:0 0 auto;
    display:inline-flex;
    align-items:center;
    justify-content:center;
    width:36px;
    height:36px;
    border-radius:10px;
    background:var(--ibt-accent-soft);
    color:var(--ibt-accent);
    font-size:13px;
    font-weight:800;
    letter-spacing:.02em;
  }
  #shopify-section-{{ section.id }} .ibt-xr__chip svg{ width:19px; height:19px; }
  #shopify-section-{{ section.id }} .ibt-xr__copy{
    font-size:16.5px;
    line-height:1.8;
    color:var(--ibt-body);
    {% if section.settings.indent_copy %}
      padding-left:48px;
    {% endif %}
  }
  @media (max-width:600px){
    #shopify-section-{{ section.id }} .ibt-xr__copy{ padding-left:0; }
  }
  #shopify-section-{{ section.id }} .ibt-xr__copy p{ margin:0 0 14px; }
  #shopify-section-{{ section.id }} .ibt-xr__copy > *:last-child{ margin-bottom:0; }
  #shopify-section-{{ section.id }} .ibt-xr__copy ul,
  #shopify-section-{{ section.id }} .ibt-xr__copy ol{
    margin:0 0 14px;
    padding-left:20px;
  }
  #shopify-section-{{ section.id }} .ibt-xr__copy li{ margin-bottom:7px; }
  #shopify-section-{{ section.id }} .ibt-xr__copy strong{ color:var(--ibt-ink); }
  #shopify-section-{{ section.id }} .ibt-xr__copy a{
    color:var(--ibt-accent);
    text-decoration:underline;
  }

  /* ---------- Pros & cons ---------- */
  #shopify-section-{{ section.id }} .ibt-pc{
    display:grid;
    grid-template-columns:1fr;
    gap:16px;
    {% if section.settings.indent_copy %}padding-left:48px;{% endif %}
  }
  @media (max-width:600px){
    #shopify-section-{{ section.id }} .ibt-pc{ padding-left:0; }
  }
  #shopify-section-{{ section.id }} .ibt-pc__col{
    border:1px solid var(--ibt-line);
    border-radius:12px;
    padding:18px 20px;
    background:{% if section.settings.part_style == 'cards' %}#fbfbfa{% else %}#fff{% endif %};
  }
  #shopify-section-{{ section.id }} .ibt-pc__col--pros{ border-top:3px solid #1c6b33; }
  #shopify-section-{{ section.id }} .ibt-pc__col--cons{ border-top:3px solid #b12704; }
  #shopify-section-{{ section.id }} .ibt-pc__title{
    display:flex;
    align-items:center;
    gap:7px;
    font-size:14px;
    font-weight:800;
    text-transform:uppercase;
    letter-spacing:.05em;
    margin:0 0 12px;
  }
  #shopify-section-{{ section.id }} .ibt-pc__title svg{ width:15px; height:15px; }
  #shopify-section-{{ section.id }} .ibt-pc__col--pros .ibt-pc__title{ color:#1c6b33; }
  #shopify-section-{{ section.id }} .ibt-pc__col--cons .ibt-pc__title{ color:#b12704; }
  #shopify-section-{{ section.id }} .ibt-pc__list{
    list-style:none;
    margin:0;
    padding:0;
  }
  #shopify-section-{{ section.id }} .ibt-pc__list li{
    position:relative;
    padding-left:24px;
    font-size:15.5px;
    line-height:1.65;
    color:var(--ibt-body);
    margin-bottom:10px;
  }
  #shopify-section-{{ section.id }} .ibt-pc__list li:last-child{ margin-bottom:0; }
  #shopify-section-{{ section.id }} .ibt-pc__col--pros .ibt-pc__list li::before{
    content:"+";
    position:absolute;
    left:2px;
    top:-1px;
    font-size:17px;
    font-weight:800;
    color:#1c6b33;
  }
  #shopify-section-{{ section.id }} .ibt-pc__col--cons .ibt-pc__list li::before{
    content:"\2013";
    position:absolute;
    left:2px;
    top:-1px;
    font-size:17px;
    font-weight:800;
    color:#b12704;
  }

  @media (min-width:768px){
    #shopify-section-{{ section.id }} .ibt-pc{
      grid-template-columns:repeat(2,minmax(0,1fr));
      gap:18px;
    }
    {% if section.settings.two_col_parts and section.settings.part_style == 'cards' %}
      #shopify-section-{{ section.id }} .ibt-xr__parts{
        grid-template-columns:repeat(2,minmax(0,1fr));
        align-items:start;
      }
      #shopify-section-{{ section.id }} .ibt-xr__part--wide{ grid-column:1 / -1; }
    {% endif %}
  }
  @media (max-width:767px){
    #shopify-section-{{ section.id }} .ibt-h2{ font-size:25px; }
    #shopify-section-{{ section.id }} .ibt-xr__part{
      {% if section.settings.part_style == 'cards' %}padding:20px 18px;{% endif %}
    }
    #shopify-section-{{ section.id }} .ibt-xr__subhead{ font-size:17.5px; }
    #shopify-section-{{ section.id }} .ibt-xr__copy{ font-size:16px; }
    #shopify-section-{{ section.id }} .ibt-xr__band{
      flex-direction:column;
      align-items:flex-start;
      gap:16px;
    }
  }
</style>

<div class="{{ section.settings.setwidth }}" id="ibt-expert-review">
  <div {% if section.settings.animation != blank %}data-aos="{{ section.settings.animation }}"{% endif %}>

    <header class="ibt-xr__header">
      {%- if section.settings.eyebrow != blank -%}
        <p class="ibt-eyebrow">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
            <path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/>
          </svg>
          {{ section.settings.eyebrow }}
        </p>
      {%- endif -%}
      <h2 class="ibt-h2">{{ section.settings.heading | default: 'Expert review' }}</h2>
      {%- if section.settings.show_rule -%}
        <hr class="ibt-xr__rule">
      {%- endif -%}
      {%- if section.settings.intro != blank -%}
        <p class="ibt-xr__intro">{{ section.settings.intro }}</p>
      {%- endif -%}
    </header>

    {%- if show_header_band -%}
      <div class="ibt-xr__band">
        {%- if show_byline -%}
          <div class="ibt-byline">
            {%- if r_img != blank -%}
              <img
                class="ibt-byline__img"
                src="{{ r_img | image_url: width: 100, height: 100, crop: 'center' }}"
                alt="{{ r_name | escape }}"
                width="50"
                height="50"
                loading="lazy"
              >
            {%- endif -%}
            <div class="ibt-byline__meta">
              <span class="ibt-byline__label">{{ section.settings.byline_prefix | default: 'Reviewed by' }}</span>
              <p class="ibt-byline__name">{{ r_name }}</p>
              {%- if r_role != blank -%}
                <p class="ibt-byline__role">{{ r_role }}</p>
              {%- endif -%}
              {%- if section.settings.show_bio and r_bio != blank -%}
                <p class="ibt-byline__bio">{{ r_bio | strip_html | truncate: 200 }}</p>
              {%- endif -%}
              {%- if r_link != blank -%}
                <a class="ibt-byline__link" href="{{ r_link }}" target="_blank" rel="noopener nofollow">LinkedIn profile</a>
              {%- endif -%}
            </div>
          </div>
        {%- endif -%}

        {%- if show_verdict -%}
          <div class="ibt-verdict">
            <div class="ibt-verdict__scorebox">
              <span class="ibt-verdict__score">{{ rating }}</span>
              <span class="ibt-verdict__out">OUT OF 5</span>
            </div>
            <div class="ibt-verdict__right">
              <span class="ibt-stars" role="img" aria-label="Rated {{ rating }} out of 5">
                <span class="ibt-stars__bg">&#9733;&#9733;&#9733;&#9733;&#9733;</span>
                <span class="ibt-stars__fill" style="width:{{ rating_pct }}%">&#9733;&#9733;&#9733;&#9733;&#9733;</span>
              </span>
              {%- if verdict != blank -%}
                <span class="ibt-verdict__label">{{ verdict }}</span>
              {%- endif -%}
            </div>
          </div>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="ibt-xr__parts">
      {%- assign part_no = 0 -%}
      {%- for block in section.blocks -%}
        {%- liquid
          assign src = block.settings.source
          assign copy = ''
          assign is_pc = false

          case src
            when 'richtext'
              assign copy = block.settings.copy
            when 'expert_review'
              assign copy = product.metafields.custom.our_expert_review
            when 'experience'
              assign copy = product.metafields.custom.our_experience
            when 'pros_cons'
              assign is_pc = true
          endcase

          if src != 'richtext' and src != 'pros_cons' and copy == blank
            assign copy = block.settings.copy
          endif
        -%}

        {%- comment -%} Build the numbered / icon chip once per part. {%- endcomment -%}
        {%- capture chip -%}
          {%- if section.settings.numbered -%}
            <span class="ibt-xr__chip">{{ part_no | plus: 1 | prepend: '0' | slice: -2, 2 }}</span>
          {%- elsif block.settings.icon != 'none' -%}
            <span class="ibt-xr__chip">{%- render 'ibt-xr-icon', ibt_icon: block.settings.icon -%}</span>
          {%- endif -%}
        {%- endcapture -%}

        {%- if is_pc -%}
          {%- assign pc_source = product.metafields.custom.pros_cons -%}
          {%- if pc_source != blank -%}
            {%- assign pc_text = pc_source | metafield_text -%}
            {%- assign pc_lines = pc_text | newline_to_br | split: '<br />' -%}
            {%- capture pros_items -%}
              {%- for line in pc_lines -%}
                {%- assign l = line | strip_html | strip -%}
                {%- if l contains '✅' -%}<li>{{ l | remove: '✅' | strip }}</li>{%- endif -%}
              {%- endfor -%}
            {%- endcapture -%}
            {%- capture cons_items -%}
              {%- for line in pc_lines -%}
                {%- assign l = line | strip_html | strip -%}
                {%- if l contains '❌' -%}<li>{{ l | remove: '❌' | strip }}</li>{%- endif -%}
              {%- endfor -%}
            {%- endcapture -%}

            {%- assign part_no = part_no | plus: 1 -%}
            <section class="ibt-xr__part ibt-xr__part--wide" {{ block.shopify_attributes }}>
              {%- if block.settings.subhead != blank -%}
                <h3 class="ibt-xr__subhead">{{ chip }}<span>{{ block.settings.subhead }}</span></h3>
              {%- endif -%}

              {%- if pros_items != blank or cons_items != blank -%}
                <div class="ibt-pc">
                  {%- if pros_items != blank -%}
                    <div class="ibt-pc__col ibt-pc__col--pros">
                      <p class="ibt-pc__title">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M20 6L9 17l-5-5"/></svg>
                        {{ section.settings.pros_label | default: 'Pros' }}
                      </p>
                      <ul class="ibt-pc__list">{{ pros_items }}</ul>
                    </div>
                  {%- endif -%}
                  {%- if cons_items != blank -%}
                    <div class="ibt-pc__col ibt-pc__col--cons">
                      <p class="ibt-pc__title">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M18 6L6 18M6 6l12 12"/></svg>
                        {{ section.settings.cons_label | default: 'Cons' }}
                      </p>
                      <ul class="ibt-pc__list">{{ cons_items }}</ul>
                    </div>
                  {%- endif -%}
                </div>
              {%- else -%}
                {%- comment -%} No tick/cross markers found - show it as ordinary copy. {%- endcomment -%}
                <div class="ibt-xr__copy rte">{{ pc_source | metafield_tag }}</div>
              {%- endif -%}
            </section>

          {%- elsif block.settings.copy != blank -%}
            {%- assign part_no = part_no | plus: 1 -%}
            <section class="ibt-xr__part" {{ block.shopify_attributes }}>
              {%- if block.settings.subhead != blank -%}
                <h3 class="ibt-xr__subhead">{{ chip }}<span>{{ block.settings.subhead }}</span></h3>
              {%- endif -%}
              <div class="ibt-xr__copy rte">{{ block.settings.copy }}</div>
            </section>
          {%- endif -%}

        {%- elsif copy != blank -%}
          {%- assign part_no = part_no | plus: 1 -%}
          <section class="ibt-xr__part" {{ block.shopify_attributes }}>
            {%- if block.settings.subhead != blank -%}
              <h3 class="ibt-xr__subhead">{{ chip }}<span>{{ block.settings.subhead }}</span></h3>
            {%- endif -%}
            <div class="ibt-xr__copy rte">
              {%- if src == 'richtext' -%}
                {{ copy }}
              {%- else -%}
                {{ copy | metafield_tag }}
              {%- endif -%}
            </div>
          </section>
        {%- endif -%}
      {%- endfor -%}
    </div>

  </div>
</div>

{% schema %}
{
  "name": "IBT 4. Expert review",
  "settings": [
    {
      "type": "select",
      "id": "setwidth",
      "label": "Container",
      "default": "container",
      "options": [
        { "value": "container", "label": "Container" },
        { "value": "container-fluid", "label": "Container fluid" },
        { "value": "full", "label": "Full width" }
      ]
    },
    { "type": "header", "content": "Heading" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow label", "default": "Hands-on testing" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Expert review" },
    { "type": "text", "id": "intro", "label": "Intro line" },
    {
      "type": "select",
      "id": "align",
      "label": "Heading alignment",
      "default": "left",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ]
    },
