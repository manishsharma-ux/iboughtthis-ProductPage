<!-- ibt-expert-review.liquid | IBT product page - Section 4: Expert review -->
{%- liquid
  assign r_name = product.metafields.custom.reviewer_name.value | default: product.metafields.custom.author_name.value
  assign r_role = product.metafields.custom.reviewer_role.value | default: product.metafields.custom.author_role.value
  assign r_img = product.metafields.custom.reviewer_image.value | default: product.metafields.custom.author_image.value
  assign r_bio = product.metafields.custom.reviewer_bio.value | default: product.metafields.custom.author_bio.value
  assign r_link = product.metafields.custom.reviewer_linkedin.value | default: product.metafields.custom.author_linkedin.value

  if section.settings.byline_name != blank
    assign r_name = section.settings.byline_name
  endif
  if section.settings.byline_role != blank
    assign r_role = section.settings.byline_role
  endif

  assign show_byline = false
  if section.settings.show_byline and r_name != blank
    assign show_byline = true
  endif

  assign verdict = product.metafields.custom.score_label.value
  assign rating = product.metafields.custom.rating.value
  assign rating_pct = 0
  if rating != blank
    assign rating_pct = rating | times: 20
  endif
-%}

{%- style -%}
  #shopify-section-{{ section.id }}{
    --ibt-ink:#1a1a1a;
    --ibt-body:#54595f;
    --ibt-line:#e6e6e6;
    --ibt-soft:#f7f7f5;
    --ibt-accent:{{ section.settings.accent_color }};
    --ibt-star:#ffa41c;
    --ibt-radius:14px;
    background-color:{{ section.settings.bgsection }};
    padding:{{ section.settings.paddingsection }};
    margin:{{ section.settings.marginsection }};
  }
  @media (max-width:750px){
    #shopify-section-{{ section.id }}{
      padding:{{ section.settings.paddingmobile }};
      margin:{{ section.settings.marginmobile }};
    }
  }
{%- endstyle -%}

<style>
  #shopify-section-{{ section.id }} .ibt-xr{
    {% if section.settings.boxed %}
      border:1px solid var(--ibt-line);
      border-radius:var(--ibt-radius);
      padding:32px 36px;
      background:#fff;
    {% endif %}
  }
  #shopify-section-{{ section.id }} .ibt-eyebrow{
    font-size:12px;
    font-weight:700;
    letter-spacing:.08em;
    text-transform:uppercase;
    color:#8a8f94;
    margin:0 0 10px;
  }
  #shopify-section-{{ section.id }} .ibt-h2{
    font-size:28px;
    line-height:1.3;
    font-weight:700;
    color:var(--ibt-ink);
    margin:0 0 6px;
  }
  #shopify-section-{{ section.id }} .ibt-xr__intro{
    font-size:16px;
    line-height:1.7;
    color:var(--ibt-body);
    margin:0 0 24px;
  }

  /* Reviewer byline */
  #shopify-section-{{ section.id }} .ibt-byline{
    display:flex;
    align-items:center;
    gap:14px;
    padding:16px 18px;
    background:var(--ibt-soft);
    border:1px solid var(--ibt-line);
    border-radius:12px;
    margin:0 0 26px;
  }
  #shopify-section-{{ section.id }} .ibt-byline__img{
    flex:0 0 auto;
    width:52px;
    height:52px;
    border-radius:50%;
    object-fit:cover;
    background:#e9e9e6;
  }
  #shopify-section-{{ section.id }} .ibt-byline__meta{ min-width:0; }
  #shopify-section-{{ section.id }} .ibt-byline__name{
    font-size:15px;
    font-weight:700;
    color:var(--ibt-ink);
    margin:0;
  }
  #shopify-section-{{ section.id }} .ibt-byline__role{
    font-size:13px;
    color:var(--ibt-body);
    margin:2px 0 0;
  }
  #shopify-section-{{ section.id }} .ibt-byline__bio{
    font-size:13px;
    line-height:1.6;
    color:var(--ibt-body);
    margin:6px 0 0;
  }
  #shopify-section-{{ section.id }} .ibt-byline__link{
    font-size:13px;
    color:var(--ibt-accent);
    text-decoration:underline;
  }

  /* Verdict strip */
  #shopify-section-{{ section.id }} .ibt-verdict{
    display:flex;
    align-items:center;
    flex-wrap:wrap;
    gap:12px;
    padding:14px 18px;
    border:1px solid var(--ibt-line);
    border-left:4px solid var(--ibt-accent);
    border-radius:10px;
    background:#fff;
    margin:0 0 26px;
  }
  #shopify-section-{{ section.id }} .ibt-verdict__score{
    font-size:22px;
    font-weight:800;
    color:var(--ibt-ink);
    line-height:1;
  }
  #shopify-section-{{ section.id }} .ibt-verdict__out{
    font-size:13px;
    color:#8a8f94;
    font-weight:500;
  }
  #shopify-section-{{ section.id }} .ibt-stars{
    position:relative;
    display:inline-block;
    line-height:1;
    font-size:17px;
    letter-spacing:1px;
  }
  #shopify-section-{{ section.id }} .ibt-stars__bg{ color:#dcdcdc; }
  #shopify-section-{{ section.id }} .ibt-stars__fill{
    position:absolute;
    top:0;
    left:0;
    overflow:hidden;
    white-space:nowrap;
    color:var(--ibt-star);
  }
  #shopify-section-{{ section.id }} .ibt-verdict__label{
    font-size:14px;
    font-weight:700;
    color:var(--ibt-ink);
  }

  /* Subhead blocks */
  #shopify-section-{{ section.id }} .ibt-xr__body{
    {% if section.settings.show_rule %}
      border-left:3px solid var(--ibt-line);
      padding-left:26px;
    {% endif %}
  }
  #shopify-section-{{ section.id }} .ibt-xr__part{
    margin:0 0 28px;
  }
  #shopify-section-{{ section.id }} .ibt-xr__part:last-child{ margin-bottom:0; }
  #shopify-section-{{ section.id }} .ibt-xr__subhead{
    font-size:19px;
    font-weight:700;
    line-height:1.4;
    color:var(--ibt-ink);
    margin:0 0 10px;
  }
  #shopify-section-{{ section.id }} .ibt-xr__copy{
    font-size:16px;
    line-height:1.75;
    color:var(--ibt-body);
  }
  #shopify-section-{{ section.id }} .ibt-xr__copy p{ margin:0 0 14px; }
  #shopify-section-{{ section.id }} .ibt-xr__copy > *:last-child{ margin-bottom:0; }
  #shopify-section-{{ section.id }} .ibt-xr__copy ul,
  #shopify-section-{{ section.id }} .ibt-xr__copy ol{
    margin:0 0 14px;
    padding-left:20px;
  }
  #shopify-section-{{ section.id }} .ibt-xr__copy li{ margin-bottom:6px; }

  /* Pros & cons */
  #shopify-section-{{ section.id }} .ibt-pc{
    display:grid;
    grid-template-columns:1fr;
    gap:16px;
  }
  #shopify-section-{{ section.id }} .ibt-pc__col{
    border:1px solid var(--ibt-line);
    border-radius:12px;
    padding:18px 20px;
    background:#fff;
  }
  #shopify-section-{{ section.id }} .ibt-pc__col--pros{ border-top:3px solid #1c6b33; }
  #shopify-section-{{ section.id }} .ibt-pc__col--cons{ border-top:3px solid #b12704; }
  #shopify-section-{{ section.id }} .ibt-pc__title{
    font-size:15px;
    font-weight:700;
    text-transform:uppercase;
    letter-spacing:.04em;
    margin:0 0 12px;
  }
  #shopify-section-{{ section.id }} .ibt-pc__col--pros .ibt-pc__title{ color:#1c6b33; }
  #shopify-section-{{ section.id }} .ibt-pc__col--cons .ibt-pc__title{ color:#b12704; }
  #shopify-section-{{ section.id }} .ibt-pc__list{
    list-style:none;
    margin:0;
    padding:0;
  }
  #shopify-section-{{ section.id }} .ibt-pc__list li{
    position:relative;
    padding-left:24px;
    font-size:15px;
    line-height:1.6;
    color:var(--ibt-body);
    margin-bottom:10px;
  }
  #shopify-section-{{ section.id }} .ibt-pc__list li:last-child{ margin-bottom:0; }
  #shopify-section-{{ section.id }} .ibt-pc__col--pros .ibt-pc__list li::before{
    content:"+";
    position:absolute;
    left:0;
    top:-1px;
    font-size:17px;
    font-weight:800;
    color:#1c6b33;
  }
  #shopify-section-{{ section.id }} .ibt-pc__col--cons .ibt-pc__list li::before{
    content:"\2013";
    position:absolute;
    left:0;
    top:-1px;
    font-size:17px;
    font-weight:800;
    color:#b12704;
  }

  @media (min-width:768px){
    #shopify-section-{{ section.id }} .ibt-pc{
      grid-template-columns:repeat(2,minmax(0,1fr));
      gap:20px;
    }
  }
  @media (max-width:767px){
    #shopify-section-{{ section.id }} .ibt-xr{ {% if section.settings.boxed %}padding:24px 20px;{% endif %} }
    #shopify-section-{{ section.id }} .ibt-h2{ font-size:24px; }
    #shopify-section-{{ section.id }} .ibt-xr__body{ {% if section.settings.show_rule %}padding-left:16px;{% endif %} }
    #shopify-section-{{ section.id }} .ibt-byline{ align-items:flex-start; }
  }
</style>

<div class="{{ section.settings.setwidth }}" id="ibt-expert-review">
  <div class="ibt-xr" {% if section.settings.animation != blank %}data-aos="{{ section.settings.animation }}"{% endif %}>

    {%- if section.settings.eyebrow != blank -%}
      <p class="ibt-eyebrow">{{ section.settings.eyebrow }}</p>
    {%- endif -%}
    <h2 class="ibt-h2">{{ section.settings.heading | default: 'Expert review' }}</h2>
    {%- if section.settings.intro != blank -%}
      <p class="ibt-xr__intro">{{ section.settings.intro }}</p>
    {%- endif -%}

    {%- if show_byline -%}
      <div class="ibt-byline">
        {%- if r_img != blank -%}
          <img
            class="ibt-byline__img"
            src="{{ r_img | image_url: width: 104, height: 104, crop: 'center' }}"
            alt="{{ r_name | escape }}"
            width="52"
            height="52"
            loading="lazy"
          >
        {%- endif -%}
        <div class="ibt-byline__meta">
          <p class="ibt-byline__name">
            {{ section.settings.byline_prefix | default: 'Reviewed by' }} {{ r_name }}
          </p>
          {%- if r_role != blank -%}
            <p class="ibt-byline__role">{{ r_role }}</p>
          {%- endif -%}
          {%- if section.settings.show_bio and r_bio != blank -%}
            <p class="ibt-byline__bio">{{ r_bio | strip_html | truncate: 220 }}</p>
          {%- endif -%}
          {%- if r_link != blank -%}
            <a class="ibt-byline__link" href="{{ r_link }}" target="_blank" rel="noopener nofollow">LinkedIn profile</a>
          {%- endif -%}
        </div>
      </div>
    {%- endif -%}

    {%- if section.settings.show_verdict and rating != blank -%}
      <div class="ibt-verdict">
        <span class="ibt-verdict__score">{{ rating }}</span>
        <span class="ibt-verdict__out">/ 5</span>
        <span class="ibt-stars" role="img" aria-label="Rated {{ rating }} out of 5">
          <span class="ibt-stars__bg">&#9733;&#9733;&#9733;&#9733;&#9733;</span>
          <span class="ibt-stars__fill" style="width:{{ rating_pct }}%">&#9733;&#9733;&#9733;&#9733;&#9733;</span>
        </span>
        {%- if verdict != blank -%}
          <span class="ibt-verdict__label">{{ verdict }}</span>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="ibt-xr__body">
      {%- for block in section.blocks -%}
        {%- liquid
          assign src = block.settings.source
          assign copy = ''
          assign is_pc = false

          case src
            when 'richtext'
              assign copy = block.settings.copy
            when 'expert_review'
              assign copy = product.metafields.custom.our_expert_review
            when 'experience'
              assign copy = product.metafields.custom.our_experience
            when 'pros_cons'
              assign is_pc = true
          endcase

          if src != 'richtext' and src != 'pros_cons' and copy == blank
            assign copy = block.settings.copy
          endif
        -%}

        {%- if is_pc -%}
          {%- assign pc_source = product.metafields.custom.pros_cons -%}
          {%- if pc_source != blank -%}
            {%- assign pc_text = pc_source | metafield_text -%}
            {%- assign pc_lines = pc_text | newline_to_br | split: '<br />' -%}
            {%- capture pros_items -%}
              {%- for line in pc_lines -%}
                {%- assign l = line | strip_html | strip -%}
                {%- if l contains '✅' -%}<li>{{ l | remove: '✅' | strip }}</li>{%- endif -%}
              {%- endfor -%}
            {%- endcapture -%}
            {%- capture cons_items -%}
              {%- for line in pc_lines -%}
                {%- assign l = line | strip_html | strip -%}
                {%- if l contains '❌' -%}<li>{{ l | remove: '❌' | strip }}</li>{%- endif -%}
              {%- endfor -%}
            {%- endcapture -%}

            {%- if pros_items != blank or cons_items != blank -%}
              <div class="ibt-xr__part" {{ block.shopify_attributes }}>
                {%- if block.settings.subhead != blank -%}
                  <h3 class="ibt-xr__subhead">{{ block.settings.subhead }}</h3>
                {%- endif -%}
                <div class="ibt-pc">
                  {%- if pros_items != blank -%}
                    <div class="ibt-pc__col ibt-pc__col--pros">
                      <p class="ibt-pc__title">{{ section.settings.pros_label | default: 'Pros' }}</p>
                      <ul class="ibt-pc__list">{{ pros_items }}</ul>
                    </div>
                  {%- endif -%}
                  {%- if cons_items != blank -%}
                    <div class="ibt-pc__col ibt-pc__col--cons">
                      <p class="ibt-pc__title">{{ section.settings.cons_label | default: 'Cons' }}</p>
                      <ul class="ibt-pc__list">{{ cons_items }}</ul>
                    </div>
                  {%- endif -%}
                </div>
              </div>
            {%- else -%}
              {%- comment -%} Metafield had no marker lines - render it as plain copy. {%- endcomment -%}
              <div class="ibt-xr__part" {{ block.shopify_attributes }}>
                {%- if block.settings.subhead != blank -%}
                  <h3 class="ibt-xr__subhead">{{ block.settings.subhead }}</h3>
                {%- endif -%}
                <div class="ibt-xr__copy rte">{{ pc_source | metafield_tag }}</div>
              </div>
            {%- endif -%}
          {%- elsif block.settings.copy != blank -%}
            <div class="ibt-xr__part" {{ block.shopify_attributes }}>
              {%- if block.settings.subhead != blank -%}
                <h3 class="ibt-xr__subhead">{{ block.settings.subhead }}</h3>
              {%- endif -%}
              <div class="ibt-xr__copy rte">{{ block.settings.copy }}</div>
            </div>
          {%- endif -%}

        {%- elsif copy != blank -%}
          <div class="ibt-xr__part" {{ block.shopify_attributes }}>
            {%- if block.settings.subhead != blank -%}
              <h3 class="ibt-xr__subhead">{{ block.settings.subhead }}</h3>
            {%- endif -%}
            <div class="ibt-xr__copy rte">
              {%- if src == 'richtext' -%}
                {{ copy }}
              {%- else -%}
                {{ copy | metafield_tag }}
              {%- endif -%}
            </div>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>

  </div>
</div>

{% schema %}
{
  "name": "IBT 4. Expert review",
  "settings": [
    {
      "type": "select",
      "id": "setwidth",
      "label": "Container",
      "default": "container",
      "options": [
        { "value": "container", "label": "Container" },
        { "value": "container-fluid", "label": "Container fluid" },
        { "value": "full", "label": "Full width" }
      ]
    },
    { "type": "header", "content": "Heading" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow label", "default": "Hands-on testing" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Expert review" },
    { "type": "text", "id": "intro", "label": "Intro line" },
    { "type": "header", "content": "Reviewer byline" },
    { "type": "checkbox", "id": "show_byline", "label": "Show reviewer byline", "default": true },
    {
      "type": "paragraph",
      "content": "Pulls Reviewer Name / Role / Image / Bio / LinkedIn metafields, falling back to the Author equivalents."
    },
    { "type": "text", "id": "byline_prefix", "label": "Byline prefix", "default": "Reviewed by" },
    { "type": "text", "id": "byline_name", "label": "Name override" },
    { "type": "text", "id": "byline_role", "label": "Role override" },
    { "type": "checkbox", "id": "show_bio", "label": "Show reviewer bio", "default": false },
    { "type": "header", "content": "Verdict strip" },
    { "type": "checkbox", "id": "show_verdict", "label": "Show score + verdict", "default": true },
    {
      "type": "paragraph",
      "content": "Uses the Rating and score label metafields."
    },
    { "type": "header", "content": "Pros & cons labels" },
    { "type": "text", "id": "pros_label", "label": "Pros label", "default": "Pros" },
    { "type": "text", "id": "cons_label", "label": "Cons label", "default": "Cons" },
    {
      "type": "paragraph",
      "content": "The Pros & Cons metafield is split on lines starting with a green tick or a red cross."
    },
    { "type": "header", "content": "Section style" },
    { "type": "checkbox", "id": "boxed", "label": "Show card border", "default": true },
    { "type": "checkbox", "id": "show_rule", "label": "Show left accent rule", "default": true },
    { "type": "color", "id": "accent_color", "label": "Accent colour", "default": "#1c4ead" },
    {
      "type": "select",
      "id": "animation",
      "label": "Animation",
      "default": "fade-up",
      "options": [
        { "value": "", "label": "None" },
        { "value": "fade", "label": "Fade" },
        { "value": "fade-up", "label": "Fade up" }
      ]
    },
    { "type": "color", "id": "bgsection", "label": "Background", "default": "#ffffff" },
    { "type": "text", "id": "paddingsection", "label": "Padding desktop", "default": "56px 0px 56px 0px" },
    { "type": "text", "id": "paddingmobile", "label": "Padding mobile", "default": "36px 0px 36px 0px" },
    { "type": "text", "id": "marginsection", "label": "Margin desktop", "default": "0px 0px 0px 0px" },
    { "type": "text", "id": "marginmobile", "label": "Margin mobile", "default": "0px 0px 0px 0px" }
  ],
  "blocks": [
    {
      "type": "part",
      "name": "Review part",
      "settings": [
        {
          "type": "text",
          "id": "subhead",
          "label": "Subhead",
          "default": "Who it's for"
        },
        {
          "type": "select",
          "id": "source",
          "label": "Content source",
          "default": "richtext",
          "options": [
            { "value": "richtext", "label": "This block's copy" },
            { "value": "expert_review", "label": "Metafield: Our Expert Review" },
            { "value": "experience", "label": "Metafield: Our Experience" },
            { "value": "pros_cons", "label": "Metafield: Pros & Cons (two columns)" }
          ]
        },
        {
          "type": "richtext",
          "id": "copy",
          "label": "Copy",
          "info": "Used when the source is set to this block's copy, and as the fallback if the chosen metafield is empty."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "IBT 4. Expert review",
      "blocks": [
        { "type": "part" },
        { "type": "part" },
        { "type": "part" }
      ]
    }
  ]
}
{% endschema %}
