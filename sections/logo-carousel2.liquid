<!-- brand-carousel.liquid -->
<style>
  .customstyle{{ section.id }} .brand-item{
    text-align: center;
    padding: {{ section.settings.pd_items }}px;
  }
  .customstyle{{ section.id }} .brand-item a{
    display: inline-block;
  }
  .customstyle{{ section.id }} .brand-item a img{
    margin: 0 auto;
  }
  .customstyle{{ section.id }} .brand-item img{
    transition: all .3s ease;
  }
  .customstyle{{ section.id }} .brand-item:hover img{
    transform: scale(1.05);
  }
  .customstyle{{ section.id }} .brand-slider .slick-track{
    display: flex !important;
    align-items: center;
  }
  @media (min-width:992px) {
    .customstyle{{ section.id }} .section-title-1{
      font-size: var(--g-h2-font-size);
    }
  }

  /* Added: style for brand name under logo */
  .customstyle{{ section.id }} .brand-name {
    display: block;
    text-align: center;
    margin-top: 8px;
    font-size: 14px;
    color: #333;
    line-height: 1.4;
  }
</style>

<div class="customstyle{{ section.id }}" data-aos="{{ section.settings.animation }}">
  {%- render 'style-section' -%}
  <div class="{{ section.settings.setwidth }}">
    <div class="section-block">
      {%- render 'section-heading' -%}
      <div class="brand-wrapper dots-negative">
        <div class="brand-slider row mb-0" id="collection-list-{{ section.id }}"
            data-rows="{{ section.settings.rows }}"
            data-slidesToShow="{{ section.settings.slidestoshow }}"
            data-slidestoscroll="{{ section.settings.slidescroll }}"
            data-arrows="{{ section.settings.arrows }}"
            data-dots="{{ section.settings.dots }}" 
            data-draggable="{{ section.settings.draggable }}" 
            data-infinite="{{ section.settings.infinite }}" 
            data-section-id="{{ section.id }}" 
            data-section-type="slickCarousels"
            data-slidesToShow-mobile="2">
          {%- for block in section.blocks -%}
          <div class="col brand-item carousel__slide-wrapper--{{ block.id }}" {{ block.shopify_attributes }}>
            <div data-aos="{{ section.settings.animation }}" data-aos-delay="{{ forloop.index | times: 100 }}">
              <div class="image-content__image-container overflow-hidden mx-auto" style="width: {{ section.settings.width_image }}%;">
                <a href="{{ block.settings.link | default: '#' }}" 
                  class="brand-image d-block {% if section.settings.grayscale -%} hv-image-grayscale {% endif %}"
                  title="{{ block.settings.image.alt }}">
                  {% assign img_url = block.settings.image | image_url: width: 1 | replace: 'width=1', 'width={width}' %}
                  {%- if block.settings.image != blank -%}
                    <img src="{{ block.settings.image | image_url: width: 1920 }}" width="auto" height="auto" alt="{{ block.settings.image.alt }}">
                  {%- else -%}
                    <div class="image-block__image">
                      {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
                    </div>
                  {%- endif -%}
                </a>
                {%- if section.settings.show_names and block.settings.name != blank -%}
                  <span class="brand-name">{{ block.settings.name }}</span>
                {%- endif -%}
              </div>
            </div>
          </div>
          {%- endfor -%}
        </div>
      </div>
      {%- if section.blocks.size == 0 -%}
        {%- render 'no-blocks' -%}
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Logo carousel 2",
  "class": "index-section",
  "max_blocks": 20,
  "settings": [
    {
      "type": "select",
      "id": "animation",
      "options": [
        { "value": "", "label": "None" },
        { "value": "fade", "label": "Fade" },
        { "value": "fade-up", "label": "Fade Up" },
        { "value": "fade-down", "label": "Fade Down" },
        { "value": "fade-left", "label": "Fade Left" },
        { "value": "fade-right", "label": "Fade Right" },
        { "value": "zoom-in", "label": "Zoom In" },
        { "value": "zoom-out", "label": "Zoom Out" }
      ],
      "label": "Select Animation"
    },
    {
      "type": "select",
      "id": "setwidth",
      "label": "Full Width",
      "default": "container",
      "options": [
        { "value": "container", "label": "Box" },
        { "value": "container-fluid", "label": "Container Fluid" },
        { "value": "full", "label": "Full" }
      ]
    },
    {
      "type": "color",
      "id": "bgsection",
      "label": "Background Section",
      "default": "#ffffff"
    },
    {
      "type": "text",
      "id": "title_top",
      "label": "Sub Title Top",
      "default": "Sub Title Top"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Logo Carousel 2"
    },
    {
      "type": "textarea",
      "id": "des",
      "label": "HTML / Description"
    },
    {
      "type": "select",
      "id": "align-heading",
      "label": "Align Heading",
      "default": "center",
      "options": [
        { "value": "center", "label": "Center" },
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ]
    },
    {
      "type": "checkbox",
      "id": "grayscale",
      "label": "Grayscale effect",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "arrows",
      "label": "Arrows",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "draggable",
      "label": "Draggable",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "dots",
      "label": "Dots",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "infinite",
      "label": "Infinite",
      "default": true
    },
    {
      "type": "range",
      "id": "width_image",
      "label": "Width Image of Column",
      "max": 100,
      "min": 50,
      "step": 1,
      "unit": "%",
      "default": 70
    },
    {
      "type": "range",
      "id": "slidestoshow",
      "label": "Show",
      "max": 18,
      "min": 1,
      "step": 1,
      "unit": "lm",
      "default": 5
    },
    {
      "type": "range",
      "id": "slidescroll",
      "label": "Scroll",
      "max": 6,
      "min": 1,
      "step": 1,
      "unit": "ste",
      "default": 1
    },
    {
      "type": "range",
      "id": "pd_items",
      "label": "Padding items",
      "max": 20,
      "min": 1,
      "step": 1,
      "unit": "px",
      "default": 15
    },
    {
      "type": "select",
      "id": "rows",
      "label": "Rows",
      "default": "1",
      "options": [
        { "value": "1", "label": "1 row" },
        { "value": "2", "label": "2 rows" },
        { "value": "3", "label": "3 rows" }
      ]
    },
    {
      "type": "checkbox",
      "id": "show_names",
      "label": "Show brand names under logos",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "logo",
      "name": "Logo",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "url", "id": "link", "label": "Logo link to" },
        { "type": "text", "id": "name", "label": "Brand name (shown under logo)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Logo carousel 2",
      "category": "Image",
      "blocks": [
        { "type": "logo" },
        { "type": "logo" },
        { "type": "logo" },
        { "type": "logo" },
        { "type": "logo" },
        { "type": "logo" }
      ]
    }
  ]
}
{% endschema %}
