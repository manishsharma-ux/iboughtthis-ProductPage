<script>
  (function () {
    var section = document.getElementById('pr-section-{{ section.id }}');
    if (!section) return;

    /* ════════════════════════════════════════════════
       Rating scale: read from data-rating-max attribute
       Default = 10  (set to 5 in section settings if your
       ratings are entered as e.g. "4.7" out of 5)
    ════════════════════════════════════════════════ */
    var RATING_MAX = parseFloat(section.getAttribute('data-rating-max')) || 10;

    /* ────────────────────────────────────────────
       ★  STAR RATINGS — product cards
       Stars always use a /5 scale:
         4.7  → 4.7/5 = 94% filled
         9.4  → treated as 9.4/10 → 4.7/5 = 94% filled
    ──────────────────────────────────────────── */
    section.querySelectorAll('.rc__star-rating[data-rating]').forEach(function (el) {
      var rating = parseFloat(el.getAttribute('data-rating'));
      if (isNaN(rating)) return;

      // Normalise to a /5 value then convert to %
      // If the rating scale is /10, halve it first so it maps to /5
      // Rating is always out of 5 — rating 4.7 = 94%, rating 5 = 100%
      var pct = Math.min(Math.max((rating / 5) * 100, 0), 100);

      var fillEl = el.querySelector('.rc__stars-fill');
      if (fillEl) {
        requestAnimationFrame(function () {
          setTimeout(function () {
            fillEl.style.width = pct + '%';
          }, 80);
        });
      }
    });

    /* ────────────────────────────────────────────
       ◉  DONUT CHARTS — comparison table
    ──────────────────────────────────────────── */
    section.querySelectorAll('.pr-table__donut[data-rating]').forEach(function (el) {
      var rating = parseFloat(el.getAttribute('data-rating'));
      if (isNaN(rating)) return;

      // Rating is always out of 5 — rating 4.7 = 94%, rating 5 = full circle
      var pct = Math.min(Math.max(rating / 5, 0), 1);
      var pctInt = Math.round(pct * 100);

      // SVG donut geometry
      var cx = 28, cy = 28, r = 20;
      var circ   = 2 * Math.PI * r;            // ~125.66
      var filled = pct * circ;
      var empty  = circ - filled;

      // Arc starts at 12 o'clock: achieved via transform rotate(-90)
      var svg =
        '<svg width="56" height="56" viewBox="0 0 56 56" aria-label="Rating ' + rating + ' out of ' + RATING_MAX + '">' +
          // Track (dark grey full ring)
          '<circle cx="' + cx + '" cy="' + cy + '" r="' + r + '"' +
          ' fill="none" stroke="#2d2d2d" stroke-width="6"/>' +
          // Progress arc (yellow)
          '<circle cx="' + cx + '" cy="' + cy + '" r="' + r + '"' +
          ' fill="none"' +
          ' stroke="#f5c518"' +
          ' stroke-width="6"' +
          ' stroke-linecap="round"' +
          ' stroke-dasharray="0 ' + circ + '"' +
          ' transform="rotate(-90 ' + cx + ' ' + cy + ')"' +
          ' class="pr-donut-arc"' +
          ' data-filled="' + filled + '"' +
          ' data-circ="' + circ + '"/>' +
          // Rating number + percent label
          '<text x="' + cx + '" y="' + (cy - 5) + '"' +
          ' text-anchor="middle" dominant-baseline="central"' +
          ' font-family="Inter,sans-serif" font-size="11" font-weight="800" fill="#1a1a1a">' + rating + '</text>' +
          
        '</svg>';

      el.innerHTML = svg;

      // Animate the arc in after paint
      var arc = el.querySelector('.pr-donut-arc');
      if (arc) {
        var filledVal = parseFloat(arc.getAttribute('data-filled'));
        var circVal   = parseFloat(arc.getAttribute('data-circ'));
        requestAnimationFrame(function () {
          setTimeout(function () {
            arc.style.transition = 'stroke-dasharray 0.9s cubic-bezier(0.4,0,0.2,1)';
            arc.setAttribute('stroke-dasharray', filledVal + ' ' + (circVal - filledVal));
          }, 100);
        });
      }
    });

    /* ────────────────────────────────────────────
       Tab switching — review cards
    ──────────────────────────────────────────── */
    section.querySelectorAll('.rc__tab-btn').forEach(function (btn) {
      btn.addEventListener('click', function () {
        var wrapper = btn.closest('.rc__tabs');
        wrapper.querySelectorAll('.rc__tab-btn').forEach(function (b) { b.classList.remove('rc__tab-btn--active'); });
        wrapper.querySelectorAll('.rc__tab-panel').forEach(function (p) { p.classList.remove('rc__tab-panel--active'); });
        btn.classList.add('rc__tab-btn--active');
        var t = document.getElementById(btn.getAttribute('data-target'));
        if (t) t.classList.add('rc__tab-panel--active');
      });
    });

    /* ────────────────────────────────────────────
       Sidebar active-section tracking
    ──────────────────────────────────────────── */
    var toc = section.querySelector('.pr__toc');
    if (!toc) return;

    var tocItems = section.querySelectorAll('.pr__toc-item[data-toc-target]');
    var targets  = Array.from(tocItems).map(function (item) {
      return document.getElementById(item.getAttribute('data-toc-target'));
    }).filter(Boolean);

    var lastActiveId = null;
    function updateActiveTocItem() {
      var scrollY = window.scrollY + 80;
      var active  = targets[0];
      targets.forEach(function (t) { if (t && t.offsetTop <= scrollY) active = t; });
      tocItems.forEach(function (item) {
        var isActive = item.getAttribute('data-toc-target') === active.id;
        item.classList.toggle('pr__toc-item--active', isActive);
        var arrowSpan = item.querySelector('.pr__toc-arrow');
        if (arrowSpan) {
          arrowSpan.textContent = isActive ? '→' : '↙';
          arrowSpan.classList.toggle('pr__toc-arrow--right', isActive);
        }
      });

      // On mobile (horizontal tab bar) keep the active tab centred in view
      if (active.id !== lastActiveId) {
        lastActiveId = active.id;
        if (window.matchMedia('(max-width: 900px)').matches && toc.scrollWidth > toc.clientWidth) {
          var activeEl = section.querySelector('.pr__toc-item--active');
          if (activeEl) {
            var target = activeEl.offsetLeft - (toc.clientWidth / 2) + (activeEl.offsetWidth / 2);
            toc.scrollTo({ left: Math.max(0, target), behavior: 'smooth' });
          }
        }
      }
    }

    /* ────────────────────────────────────────────
       Fixed-on-scroll (desktop sidebar)
       • Add  .pr__toc--fixed  when the sidebar's top reaches the top of the page
       • Remove it when the section's bottom reaches the top of the page
       Uses position:fixed (set via the class) instead of position:sticky,
       which can be silently broken by an ancestor with overflow set.
    ──────────────────────────────────────────── */
    var TOP_OFFSET = {{ section.settings.sticky_top_offset | default: 0 }}; // px gap from the top when fixed (theme setting)
    var desktopMq  = window.matchMedia('(min-width: 901px)');
    var colLeft = 0, colWidth = 0, tocOffsetInSection = 0;

    function measureToc() {
      // Measure column geometry in the natural (unfixed) state.
      // Vertical triggers are read live on every scroll (see applyTocState),
      // so they never go stale when the section height changes.
      toc.classList.remove('pr__toc--fixed');
      toc.style.left = '';
      toc.style.width = '';
      toc.style.top = '';
      toc.style.maxHeight = '';
      var r  = toc.getBoundingClientRect();
      var sr = section.getBoundingClientRect();
      colLeft  = r.left;
      colWidth = r.width;
      tocOffsetInSection = r.top - sr.top;   // sidebar's natural distance below the section top
      applyTocState();
    }

    function applyTocState() {
      if (!desktopMq.matches) {           // mobile uses the sticky horizontal tab bar
        toc.classList.remove('pr__toc--fixed');
        toc.style.left = '';
        toc.style.width = '';
        toc.style.top = '';
        toc.style.maxHeight = '';
        return;
      }
      // Live, viewport-relative position of THIS section (self-corrects for any
      // layout change). Section height is driven by .pr__main, so this reads the
      // same whether the sidebar is fixed or not.
      var sr = section.getBoundingClientRect();
      var pinReached  = (sr.top + tocOffsetInSection) <= TOP_OFFSET; // sidebar top hits the line
      var sectionLeft = sr.bottom > TOP_OFFSET;                      // section bottom still below the line
      var shouldFix = pinReached && sectionLeft;
      if (shouldFix) {
        toc.classList.add('pr__toc--fixed');
        toc.style.left  = colLeft + 'px';
        toc.style.width = colWidth + 'px';
        toc.style.top   = TOP_OFFSET + 'px';
        toc.style.maxHeight = 'calc(100vh - ' + TOP_OFFSET + 'px)';
      } else if (toc.classList.contains('pr__toc--fixed')) {
        toc.classList.remove('pr__toc--fixed');
        toc.style.left  = '';
        toc.style.width = '';
        toc.style.top   = '';
        toc.style.maxHeight = '';
      }
    }

    function onScroll() {
      applyTocState();
      updateActiveTocItem();
    }

    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', measureToc);
    if (window.ResizeObserver) { new ResizeObserver(measureToc).observe(section); }
    window.addEventListener('load', measureToc);

    measureToc();
    updateActiveTocItem();
  })();
</script>

