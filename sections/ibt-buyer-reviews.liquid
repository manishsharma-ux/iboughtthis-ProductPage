<!-- ibt-buyer-reviews.liquid | IBT product page - Section 6: Buyer reviews -->
{%- liquid
  comment
    Source priority: the product's own Buyer Reviews metafield (JSON list),
    then the section's Review blocks as a store-wide fallback.
  endcomment
  assign mf_reviews = product.metafields.custom.buyer_reviews.value
  assign use_mf = false
  assign review_blocks = 0

  if mf_reviews != blank and mf_reviews.size > 0
    for row in mf_reviews
      assign rq = row.quote | default: row.body | default: row.text
      if rq != blank
        assign review_blocks = review_blocks | plus: 1
      endif
    endfor
    if review_blocks > 0
      assign use_mf = true
    endif
  endif

  unless use_mf
    assign review_blocks = 0
    for block in section.blocks
      if block.settings.quote != blank
        assign review_blocks = review_blocks | plus: 1
      endif
    endfor
  endunless

  assign agg_rating = product.metafields.custom.rating.value
  assign agg_count = product.metafields.custom.number_of_reviews.value
  assign agg_pct = 0
  if agg_rating != blank
    assign agg_pct = agg_rating | times: 20
  endif

  assign buy_url = product.metafields.custom.custom_tracking_link.value
  if buy_url == blank
    assign buy_url = product.metafields.custom.tracking_link.value
  endif
-%}

{%- style -%}
  #shopify-section-{{ section.id }}{
    --ibt-ink:#1a1a1a;
    --ibt-body:#54595f;
    --ibt-line:#e6e6e6;
    --ibt-soft:#f7f7f5;
    --ibt-accent:{{ section.settings.accent_color }};
    --ibt-star:#ffa41c;
    --ibt-radius:14px;
    background-color:{{ section.settings.bgsection }};
    padding:{{ section.settings.paddingsection }};
    margin:{{ section.settings.marginsection }};
  }
  @media (max-width:750px){
    #shopify-section-{{ section.id }}{
      padding:{{ section.settings.paddingmobile }};
      margin:{{ section.settings.marginmobile }};
    }
  }
{%- endstyle -%}

<style>
  #shopify-section-{{ section.id }} .ibt-eyebrow{
    font-size:12px;
    font-weight:700;
    letter-spacing:.08em;
    text-transform:uppercase;
    color:#8a8f94;
    margin:0 0 10px;
  }
  #shopify-section-{{ section.id }} .ibt-h2{
    font-size:28px;
    line-height:1.3;
    font-weight:700;
    color:var(--ibt-ink);
    margin:0 0 8px;
  }
  #shopify-section-{{ section.id }} .ibt-br__head{
    text-align:{{ section.settings.align }};
    margin-bottom:24px;
  }
  #shopify-section-{{ section.id }} .ibt-br__intro{
    font-size:16px;
    line-height:1.7;
    color:var(--ibt-body);
    margin:0;
  }

  /* Aggregate summary */
  #shopify-section-{{ section.id }} .ibt-br__summary{
    display:flex;
    align-items:center;
    flex-wrap:wrap;
    gap:12px;
    justify-content:{% if section.settings.align == 'center' %}center{% else %}flex-start{% endif %};
    padding:16px 20px;
    border:1px solid var(--ibt-line);
    border-radius:12px;
    background:#fff;
    margin:0 0 24px;
  }
  #shopify-section-{{ section.id }} .ibt-br__summary-score{
    font-size:24px;
    font-weight:800;
    line-height:1;
    color:var(--ibt-ink);
  }
  #shopify-section-{{ section.id }} .ibt-br__summary-count{
    font-size:14px;
    color:var(--ibt-body);
  }

  #shopify-section-{{ section.id }} .ibt-stars{
    position:relative;
    display:inline-block;
    line-height:1;
    font-size:16px;
    letter-spacing:1px;
  }
  #shopify-section-{{ section.id }} .ibt-stars__bg{ color:#dcdcdc; }
  #shopify-section-{{ section.id }} .ibt-stars__fill{
    position:absolute;
    top:0;
    left:0;
    overflow:hidden;
    white-space:nowrap;
    color:var(--ibt-star);
  }

  /* Cards */
  #shopify-section-{{ section.id }} .ibt-br__grid{
    display:grid;
    grid-template-columns:1fr;
    gap:20px;
  }
  #shopify-section-{{ section.id }} .ibt-rc{
    display:flex;
    flex-direction:column;
    border:1px solid var(--ibt-line);
    border-radius:var(--ibt-radius);
    background:#fff;
    padding:22px;
  }
  #shopify-section-{{ section.id }} .ibt-rc__top{
    display:flex;
    align-items:center;
    gap:12px;
    margin-bottom:12px;
  }
  #shopify-section-{{ section.id }} .ibt-rc__avatar{
    flex:0 0 auto;
    width:40px;
    height:40px;
    border-radius:50%;
    object-fit:cover;
    background:var(--ibt-soft);
    display:flex;
    align-items:center;
    justify-content:center;
    font-size:15px;
    font-weight:700;
    color:var(--ibt-accent);
    text-transform:uppercase;
    border:1px solid var(--ibt-line);
  }
  #shopify-section-{{ section.id }} .ibt-rc__who{ min-width:0; }
  #shopify-section-{{ section.id }} .ibt-rc__name{
    font-size:15px;
    font-weight:700;
    color:var(--ibt-ink);
    margin:0;
    display:flex;
    align-items:center;
    gap:6px;
    flex-wrap:wrap;
  }
  #shopify-section-{{ section.id }} .ibt-rc__verified{
    display:inline-flex;
    align-items:center;
    gap:4px;
    font-size:11px;
    font-weight:700;
    color:#1c6b33;
    background:#eaf4ec;
    padding:2px 7px;
    border-radius:999px;
    text-transform:none;
    letter-spacing:0;
  }
  #shopify-section-{{ section.id }} .ibt-rc__verified svg{ width:11px; height:11px; }
  #shopify-section-{{ section.id }} .ibt-rc__date{
    font-size:12px;
    color:#8a8f94;
    margin:2px 0 0;
  }
  #shopify-section-{{ section.id }} .ibt-rc__stars{ margin-bottom:10px; }
  #shopify-section-{{ section.id }} .ibt-rc__title{
    font-size:15px;
    font-weight:700;
    color:var(--ibt-ink);
    margin:0 0 6px;
  }
  #shopify-section-{{ section.id }} .ibt-rc__quote{
    font-size:15px;
    line-height:1.7;
    color:var(--ibt-body);
    margin:0;
  }
  #shopify-section-{{ section.id }} .ibt-rc__quote p{ margin:0 0 10px; }
  #shopify-section-{{ section.id }} .ibt-rc__quote > *:last-child{ margin-bottom:0; }

  /* Attribution + CTA */
  #shopify-section-{{ section.id }} .ibt-br__foot{
    margin:22px 0 0;
    text-align:{{ section.settings.align }};
  }
  #shopify-section-{{ section.id }} .ibt-br__attrib{
    font-size:13px;
    color:#8a8f94;
    margin:0;
  }
  #shopify-section-{{ section.id }} .ibt-br__attrib a{
    color:#8a8f94;
    text-decoration:underline;
  }
  #shopify-section-{{ section.id }} .ibt-br__cta{
    display:inline-flex;
    align-items:center;
    gap:8px;
    margin-top:16px;
    background:var(--ibt-accent);
    color:{{ section.settings.cta_color }};
    font-size:15px;
    font-weight:700;
    padding:14px 26px;
    border-radius:10px;
    text-decoration:none;
    transition:transform .12s ease,filter .2s ease;
  }
  #shopify-section-{{ section.id }} .ibt-br__cta:hover{
    color:{{ section.settings.cta_color }};
    text-decoration:none;
    filter:brightness(.93);
    transform:translateY(-1px);
  }
  #shopify-section-{{ section.id }} .ibt-br__cta svg{ width:16px; height:16px; }

  @media (min-width:768px){
    #shopify-section-{{ section.id }} .ibt-br__grid{
      grid-template-columns:repeat({{ section.settings.columns }},minmax(0,1fr));
    }
  }
  @media (min-width:576px) and (max-width:767px){
    #shopify-section-{{ section.id }} .ibt-br__grid{
      grid-template-columns:repeat(2,minmax(0,1fr));
    }
  }
  @media (max-width:767px){
    #shopify-section-{{ section.id }} .ibt-h2{ font-size:24px; }
    #shopify-section-{{ section.id }} .ibt-rc{ padding:18px; }
  }
</style>

<div class="{{ section.settings.setwidth }}" id="ibt-buyer-reviews">
  <div {% if section.settings.animation != blank %}data-aos="{{ section.settings.animation }}"{% endif %}>

    <div class="ibt-br__head">
      {%- if section.settings.eyebrow != blank -%}
        <p class="ibt-eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      <h2 class="ibt-h2">{{ section.settings.heading | default: 'Buyer reviews' }}</h2>
      {%- if section.settings.intro != blank -%}
        <p class="ibt-br__intro">{{ section.settings.intro }}</p>
      {%- endif -%}
    </div>

    {%- if section.settings.show_summary and agg_rating != blank -%}
      <div class="ibt-br__summary">
        <span class="ibt-br__summary-score">{{ agg_rating }}</span>
        <span class="ibt-stars" role="img" aria-label="Average rating {{ agg_rating }} out of 5">
          <span class="ibt-stars__bg">&#9733;&#9733;&#9733;&#9733;&#9733;</span>
          <span class="ibt-stars__fill" style="width:{{ agg_pct }}%">&#9733;&#9733;&#9733;&#9733;&#9733;</span>
        </span>
        {%- if agg_count != blank -%}
          <span class="ibt-br__summary-count">
            {{ section.settings.summary_prefix | default: 'Average of' }} {{ agg_count }} {{ section.settings.summary_suffix | default: 'customer ratings' }}
          </span>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if review_blocks > 0 -%}
      <div class="ibt-br__grid">
        {%- if use_mf -%}
          {%- for row in mf_reviews -%}
            {%- liquid
              assign rq = row.quote | default: row.body | default: row.text
              assign r_verified = row.verified
              if row.verified == nil
                assign r_verified = true
              endif
            -%}
            {%- if rq != blank -%}
              {%- render 'ibt-review-card',
                ibt_name: row.name,
                ibt_rating: row.rating,
                ibt_title: row.title,
                ibt_quote: rq,
                ibt_date: row.date,
                ibt_verified: r_verified,
                ibt_verified_label: section.settings.verified_label
              -%}
            {%- endif -%}
          {%- endfor -%}
        {%- else -%}
          {%- for block in section.blocks -%}
            {%- if block.settings.quote != blank -%}
              {%- render 'ibt-review-card',
                ibt_name: block.settings.name,
                ibt_rating: block.settings.rating,
                ibt_title: block.settings.title,
                ibt_quote: block.settings.quote,
                ibt_date: block.settings.date,
                ibt_verified: block.settings.verified,
                ibt_avatar: block.settings.avatar,
                ibt_verified_label: section.settings.verified_label,
                ibt_attrs: block.shopify_attributes
              -%}
            {%- endif -%}
          {%- endfor -%}
        {%- endif -%}
      </div>
    {%- elsif request.design_mode -%}
      <p style="color:#8a8f94;font-size:15px;">Add Review blocks to fill this section.</p>
    {%- endif -%}

    {%- if section.settings.attribution != blank or section.settings.show_cta -%}
      <div class="ibt-br__foot">
        {%- if section.settings.attribution != blank -%}
          <p class="ibt-br__attrib">
            {{ section.settings.attribution }}
            {%- if section.settings.attribution_link_text != blank and buy_url != blank -%}
              <a href="{{ buy_url }}" target="_blank" rel="nofollow sponsored noopener">{{ section.settings.attribution_link_text }}</a>
            {%- endif -%}
          </p>
        {%- endif -%}

        {%- if section.settings.show_cta and buy_url != blank -%}
          <a
            href="{{ buy_url }}"
            id="ibtCtaReviews-{{ section.id }}"
            class="ibt-br__cta"
            target="_blank"
            rel="nofollow sponsored noopener"
          >
            {{ section.settings.cta_label | default: 'View Deal on Amazon' }}
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
              <path d="M5 12h13M13 6l6 6-6 6"/>
            </svg>
          </a>
        {%- endif -%}
      </div>
    {%- endif -%}

  </div>
</div>

{%- if section.settings.show_cta -%}
  <script>
    (function () {
      var cta = document.getElementById('ibtCtaReviews-{{ section.id }}');
      if (!cta) return;
      cta.addEventListener('click', function () {
        if (typeof fbq === 'function') {
          fbq('track', 'Purchase');
        }
        if (typeof gtag === 'function') {
          gtag('event', 'affiliate_click', {
            product_title: {{ product.title | json }},
            product_handle: {{ product.handle | json }},
            placement: 'ibt_buyer_reviews'
          });
        }
      });
    })();
  </script>
{%- endif -%}

{% schema %}
{
  "name": "IBT 6. Buyer reviews",
  "settings": [
    {
      "type": "select",
      "id": "setwidth",
      "label": "Container",
      "default": "container",
      "options": [
        { "value": "container", "label": "Container" },
        { "value": "container-fluid", "label": "Container fluid" },
        { "value": "full", "label": "Full width" }
      ]
    },
    { "type": "header", "content": "Heading" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow label", "default": "What buyers say" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Buyer reviews" },
    { "type": "text", "id": "intro", "label": "Intro line" },
    {
      "type": "select",
      "id": "align",
      "label": "Heading alignment",
      "default": "left",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ]
    },
    { "type": "header", "content": "Rating summary" },
    {
      "type": "checkbox",
      "id": "show_summary",
      "label": "Show average rating bar",
      "default": true,
      "info": "Uses the Rating and Number of Reviews metafields."
    },
    { "type": "text", "id": "summary_prefix", "label": "Summary prefix", "default": "Average of" },
    { "type": "text", "id": "summary_suffix", "label": "Summary suffix", "default": "customer ratings" },
    { "type": "header", "content": "Cards" },
    {
      "type": "paragraph",
      "content": "Per-product reviews come from the product's Buyer Reviews metafield (custom.buyer_reviews, type JSON list) with keys name, rating, title, quote, date, verified. The blocks below are the store-wide fallback used when that metafield is empty."
    },
    {
      "type": "select",
      "id": "columns",
      "label": "Columns (desktop)",
      "default": "2",
      "options": [
        { "value": "2", "label": "2 columns" },
        { "value": "3", "label": "3 columns" },
        { "value": "4", "label": "4 columns" }
      ]
    },
    { "type": "text", "id": "verified_label", "label": "Verified badge text", "default": "Verified purchase" },
    { "type": "header", "content": "Attribution" },
    {
      "type": "text",
      "id": "attribution",
      "label": "Attribution note",
      "default": "Quotes are from verified Amazon customer reviews and have been shortened for length.",
      "info": "Required if the quotes are pulled from Amazon rather than collected on site."
    },
    {
      "type": "text",
      "id": "attribution_link_text",
      "label": "Attribution link text",
      "default": "Read all reviews on Amazon"
    },
    { "type": "header", "content": "Closing call to action" },
    { "type": "checkbox", "id": "show_cta", "label": "Show button", "default": true },
    { "type": "text", "id": "cta_label", "label": "Button label", "default": "View Deal on Amazon" },
    { "type": "color", "id": "cta_color", "label": "Button text colour", "default": "#ffffff" },
    { "type": "header", "content": "Section style" },
    { "type": "color", "id": "accent_color", "label": "Accent colour", "default": "#1c4ead" },
    {
      "type": "select",
      "id": "animation",
      "label": "Animation",
      "default": "fade-up",
      "options": [
        { "value": "", "label": "None" },
        { "value": "fade", "label": "Fade" },
        { "value": "fade-up", "label": "Fade up" }
      ]
    },
    { "type": "color", "id": "bgsection", "label": "Background", "default": "#f9f9f7" },
    { "type": "text", "id": "paddingsection", "label": "Padding desktop", "default": "56px 0px 64px 0px" },
    { "type": "text", "id": "paddingmobile", "label": "Padding mobile", "default": "36px 0px 40px 0px" },
    { "type": "text", "id": "marginsection", "label": "Margin desktop", "default": "0px 0px 0px 0px" },
    { "type": "text", "id": "marginmobile", "label": "Margin mobile", "default": "0px 0px 0px 0px" }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        { "type": "text", "id": "name", "label": "Reviewer name", "default": "Sarah M." },
        {
          "type": "select",
          "id": "rating",
          "label": "Star rating",
          "default": "5",
          "options": [
            { "value": "5", "label": "5 stars" },
            { "value": "4", "label": "4 stars" },
            { "value": "3", "label": "3 stars" },
            { "value": "2", "label": "2 stars" },
            { "value": "1", "label": "1 star" }
          ]
        },
        { "type": "text", "id": "title", "label": "Review headline" },
        {
          "type": "richtext",
          "id": "quote",
          "label": "Quote",
          "default": "<p>Paste a short, specific quote here - two or three sentences works best.</p>"
        },
        { "type": "text", "id": "date", "label": "Date", "info": "For example: Reviewed 12 March 2026" },
        { "type": "checkbox", "id": "verified", "label": "Show verified badge", "default": true },
        { "type": "image_picker", "id": "avatar", "label": "Avatar", "info": "Optional. Falls back to the initial of the name." }
      ]
    }
  ],
  "presets": [
    {
      "name": "IBT 6. Buyer reviews",
      "blocks": [
        { "type": "review" },
        { "type": "review" },
        { "type": "review" },
        { "type": "review" }
      ]
    }
  ]
}
{% endschema %}
